<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  <meta name="description" content="The community front door for the Krewire open-source ecosystem: a canonical path to your first project, contributor guidance, and transparent support information.">
  <link rel="canonical" href="https://open.krewire.com/">
  <link rel="icon" href="{basePath}favicon.svg" type="image/svg+xml">
  <link rel="icon" href="{basePath}favicon.ico" type="image/x-icon">
  <link rel="icon" href="{basePath}favicon-32x32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="{basePath}favicon-16x16.png" sizes="16x16" type="image/png">
  <link rel="apple-touch-icon" sizes="180x180" href="{basePath}apple-touch-icon.png">
  <link rel="manifest" href="{basePath}site.webmanifest">
  <link rel="stylesheet" href="/assets/krewire.css">
  <script src="/assets/krewire.js" defer></script>
  <meta name="theme-color" content="#0B1F3B">

  <!-- OpenGraph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{title}">
  <meta property="og:description" content="The community front door for the Krewire open-source ecosystem: a canonical path to your first project, contributor guidance, and transparent support information.">
  <meta property="og:image" content="https://open.krewire.com/assets/images/krewire-with-mark-h-dark.png">
  <meta property="og:url" content="https://open.krewire.com/">
  <meta property="og:site_name" content="Krewire Community">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{title}">
  <meta name="twitter:description" content="The community front door for the Krewire open-source ecosystem: a canonical path to your first project, contributor guidance, and transparent support information.">
</head>
<body class="w-full min-w-0 flex flex-col min-h-screen">

  <!-- NAVBAR (Krewire UI) -->
  <Navbar BrandName="Krewire" BrandBadge="Community" BrandHref="{basePath}" showLangToggle=true gitHubURL="https://github.com/krewire" showEcosystemMenu=true>
    <a href="#start" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150" data-i18n="nav.start">Start Here</a>
    <a href="#privileges" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150" data-i18n="nav.privileges">Why Contribute</a>
    <a href="#pathways" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150" data-i18n="nav.pathways">Pathways &amp; Repos</a>
    <a href="#guide" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150" data-i18n="nav.guide">Contributor Guide</a>
    <a href="#standards" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150" data-i18n="nav.standards">Quality Gates</a>
    <a href="#sponsorship" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150" data-i18n="nav.sponsorship">Support</a>
    <a href="https://github.com/krewire/krewire.com/discussions" target="_blank" rel="noopener" class="text-sm font-bold text-fg dark:text-fg-dark px-3 py-1.5 rounded-md hover:bg-bg-2 dark:hover:bg-bg-dark-2 hover:text-primary transition-all duration-150"><span>💬</span> <span data-i18n="nav.discussions">Discussions ↗</span></a>

    <div slot="drawer">
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#start"><span class="text-primary font-bold">→</span> <span data-i18n="nav.start">Start Here</span></a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#privileges"><span class="text-primary font-bold">★</span> <span data-i18n="nav.privileges">Why Contribute</span></a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#pathways"><span class="text-primary font-bold">⬢</span> <span data-i18n="nav.pathways">Contribution Pathways</span></a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#guide"><span class="text-primary font-bold">⚡</span> <span data-i18n="nav.guide">Contributor Guide</span></a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#standards"><span class="text-primary font-bold">✓</span> <span data-i18n="nav.standards">3S Quality Gates</span></a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#sponsorship"><span class="text-primary font-bold">💖</span> <span data-i18n="nav.sponsorship">Support</span></a>
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="#boost"><span class="text-primary font-bold">▲</span> <span data-i18n="nav.boost">AI Boost Synergy</span></a>
      <hr class="my-2" style="border-color:var(--pop-border); border-width:1.5px">
      <a class="mobile-link flex items-center gap-2 px-3 py-2.5 rounded-lg font-bold text-sm text-fg dark:text-fg-dark min-h-[44px] hover:bg-bg-2 dark:hover:bg-bg-dark-2 transition-all" href="https://github.com/krewire" target="_blank" rel="noopener">
        <span>🐙 <span data-i18n="nav.github_org">GitHub Organization ↗</span></span>
      </a>
    </div>
  </Navbar>

  <!-- PAGE CONTENT -->
  <main id="main" class="w-full min-w-0 flex-1 max-w-none">{content}</main>

  <!-- FOOTER (Krewire UI) -->
  <Footer variant="full" version={version} showEcosystemFooter=true />
</body>
</html>

<style>
/* Canonical Krewire Design System tokens */
:root {
  --primary: #39D353;
  --primary-content: #0B1F3B;
  --secondary: #00D1C1;
  --secondary-content: #0B1F3B;
  --accent: #FF3B2E;
  --accent-content: #ffffff;
  --bg: #FAF8F4;
  --bg-2: #f2ede4;
  --fg: #0B1F3B;
  --muted: #57677d;
  --border: #0B1F3B;
  --border-subtle: rgba(11,31,59,.18);
  --pop-border: 2.5px solid var(--border);
  --pop-border-thin: 2px solid var(--border);
  --pop-shadow: 4px 4px 0px var(--border);
  --pop-shadow-lg: 6px 6px 0px var(--border);
  --pop-shadow-sm: 2px 2px 0px var(--border);
  --dot-color: rgba(11,31,59,.08);
  --radius: 14px;
  --shadow: var(--pop-shadow);
  --success: #39D353;
  --warning: #ffb703;
  --error: #FF3B2E;
  --info: #00D1C1;
  --show-sun: inline;
  --show-moon: none;
}
:root[data-theme="dark"], html[data-theme="dark"], .dark {
  --primary: #39D353 !important;
  --primary-content: #0B1F3B !important;
  --secondary: #112646 !important;
  --secondary-content: #FAF8F4 !important;
  --bg: #0B1F3B;
  --bg-2: #112646;
  --fg: #FAF8F4;
  --muted: #9ab0ce;
  --border: #FAF8F4;
  --border-subtle: rgba(250,248,244,.2);
  --pop-border: 2.5px solid var(--border);
  --pop-border-thin: 2px solid var(--border);
  --pop-shadow: 4px 4px 0px var(--border);
  --pop-shadow-lg: 6px 6px 0px var(--border);
  --pop-shadow-sm: 2px 2px 0px var(--border);
  --dot-color: rgba(250,248,244,.09);
  --shadow: var(--pop-shadow);
  --show-sun: none;
  --show-moon: inline;
}

#main {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  overflow: clip;
}

#main h1,
#main h2,
#main h3 {
  text-wrap: balance;
}

#main p {
  text-wrap: pretty;
}

@media (prefers-reduced-motion: reduce) {
  #main *,
  #main *::before,
  #main *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Container & Spacing System */
.container-site {
  margin-left: auto !important;
  margin-right: auto !important;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 82rem !important;
  padding-left: 1.25rem !important;
  padding-right: 1.25rem !important;
  box-sizing: border-box !important;
}
@media (min-width: 640px) {
  .container-site {
    padding-left: 2rem !important;
    padding-right: 2rem !important;
  }
}
@media (min-width: 1024px) {
  .container-site {
    padding-left: 2.5rem !important;
    padding-right: 2.5rem !important;
  }
}
@media (min-width: 1280px) {
  .container-site {
    padding-left: 3rem !important;
    padding-right: 3rem !important;
  }
}
</style>
