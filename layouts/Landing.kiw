<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.Title}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/theme.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <script>
    (function(){
      try{
        var t = localStorage.getItem("krewire-theme") || "auto";
        var m = t==="auto"? (matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light") : t;
        document.documentElement.dataset.theme = m;
      }catch(e){}
      window.krewireTheme={toggle:function(){
        var cur=document.documentElement.dataset.theme;
        var nxt=cur==="dark"?"light":"dark";
        document.documentElement.dataset.theme=nxt;
        try{localStorage.setItem("krewire-theme",nxt)}catch(e){}
      }};
    })();
  </script>
</head>
<body>
  <header class="nav" id="main-nav">
    <div class="nav-inner">
      <a class="brand" href="/">
        <span class="brand-mark">◈</span>
        <span class="brand-text">Krewire</span>
        <span class="badge">Contributors</span>
      </a>
      <nav class="links">
        <a href="#benefits">Perks & Access</a>
        <a href="#get-started">Get Started</a>
        <a href="#repositories">Repositories</a>
        <a href="#pathways">Pathways</a>
        <a href="#standards">Standards</a>
        <a href="#guild">AI Guild</a>
        <a href="https://github.com/krewire" target="_blank" rel="noopener" class="gh-link"><span>★</span> GitHub</a>
      </nav>
      <div class="nav-actions">
        <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" onclick="window.krewireTheme.toggle()">
          <span class="sun">☀</span><span class="moon">☾</span>
        </button>
        <button class="nav-toggler" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-menu">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </button>
      </div>
    </div>
    <div class="nav-mobile-menu" id="mobile-nav-menu" aria-hidden="true">
      <div class="mobile-menu-inner">
        <a class="mobile-link" href="#benefits">
          <span class="link-icon">★</span>
          <span>Perks & Lifetime Access</span>
        </a>
        <a class="mobile-link" href="#get-started">
          <span class="link-icon">⚡</span>
          <span>Getting Started</span>
        </a>
        <a class="mobile-link" href="#repositories">
          <span class="link-icon">⬢</span>
          <span>Core Repositories</span>
        </a>
        <a class="mobile-link" href="#pathways">
          <span class="link-icon">◈</span>
          <span>Contribution Pathways</span>
        </a>
        <a class="mobile-link" href="#standards">
          <span class="link-icon">✓</span>
          <span>The 3 Quality Gates</span>
        </a>
        <a class="mobile-link" href="#guild">
          <span class="link-icon">▲</span>
          <span>AI Guild Collaboration</span>
        </a>
        <div class="mobile-menu-divider"></div>
        <a class="mobile-link gh-mobile" href="https://github.com/krewire" target="_blank" rel="noopener">
          <span>★ GitHub Organization</span>
          <span class="link-arrow">↗</span>
        </a>
      </div>
    </div>
  </header>
  <main class="landing-main">{{.Content}}</main>
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div>
          <div class="footer-brand"><span class="brand-mark">◈</span> Krewire Contributors</div>
          <p class="footer-desc">Home of the Open Source Collective.<br>Crafting an autonomous, sustainable, and scalable Go ecosystem at near-zero cost.</p>
        </div>
        <div class="footer-col">
          <strong>Repositories</strong>
          <a href="https://github.com/krewire/framework" target="_blank" rel="noopener">framework</a>
          <a href="https://github.com/krewire/libs" target="_blank" rel="noopener">libs (cord)</a>
          <a href="https://github.com/krewire/kiw" target="_blank" rel="noopener">kiw (cli)</a>
          <a href="https://github.com/krewire/guild" target="_blank" rel="noopener">guild (ai agent)</a>
          <a href="https://github.com/krewire/hub" target="_blank" rel="noopener">hub (plugins)</a>
          <a href="https://github.com/krewire/ship" target="_blank" rel="noopener">ship (deployer)</a>
          <a href="https://github.com/krewire/mdbind" target="_blank" rel="noopener">mdbind (compiler)</a>
        </div>
        <div class="footer-col">
          <strong>Contribution</strong>
          <a href="#benefits">Contributor Perks & Access</a>
          <a href="#get-started">Getting Started</a>
          <a href="#pathways">Contribution Pathways</a>
          <a href="#standards">The Krewire Way (Gates)</a>
          <a href="#guild">AI Guild Collaboration</a>
          <a href="https://github.com/krewire/framework/tree/main/docs/specs" target="_blank" rel="noopener">KWF Specs</a>
        </div>
        <div class="footer-col">
          <strong>Community</strong>
          <a href="https://github.com/krewire" target="_blank" rel="noopener">GitHub Organization</a>
          <a href="https://github.com/orgs/krewire/discussions" target="_blank" rel="noopener">Discussions</a>
          <a href="https://github.com/krewire/framework/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener">Good First Issues</a>
          <a href="https://github.com/krewire/.github/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener">Code of Conduct</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Krewire Contributors — Built 100% with Krewire <code>site</code> workload (Dogfooding).</span>
        <span><a href="https://github.com/krewire" target="_blank" rel="noopener">github.com/krewire</a></span>
      </div>
    </div>
  </footer>
  <script src="/assets/app.js" defer></script>
</body>
</html>

<style>
/* CSS VARIABLES & TOKENS */
:root{
  --primary:#00c853;
  --primary-content:#ffffff;
  --bg:#ffffff;
  --bg-2:#f6f8f7;
  --fg:#0a0a0a;
  --muted:#6b7280;
  --border:rgba(10,10,10,.08);
  --radius:14px;
  --shadow:0 10px 30px rgba(10,10,10,.06);
  --show-sun:inline;
  --show-moon:none;
}
:root[data-theme="dark"], [data-theme="dark"]{
  --bg:#0a0a0a;
  --bg-2:#111413;
  --fg:#f6f8f7;
  --muted:#9ca3af;
  --border:rgba(246,248,247,.12);
  --shadow:0 10px 30px rgba(0,0,0,.4);
  --show-sun:none;
  --show-moon:inline;
}

/* GLOBAL RESET & MOBILE-FIRST BASE */
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;
  font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background:var(--bg);
  color:var(--fg);
  font-size:14.5px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  min-width:0;
}
a{color:inherit;text-decoration:none}
a:hover{color:var(--primary)}

/* STICKY TOP NAVBAR (MOBILE-FIRST) */
.nav{
  position:sticky;
  top:0;
  z-index:50;
  background:color-mix(in srgb, var(--bg) 92%, transparent);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border);
  width:100%;
}
.nav-inner{
  max-width:80rem;
  margin:0 auto;
  padding:10px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
.brand{
  font-weight:800;
  letter-spacing:-.02em;
  display:flex;
  align-items:center;
  gap:8px;
  font-size:15px;
  flex-shrink:0;
}
.brand-mark{
  width:28px;
  height:28px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:var(--primary);
  color:var(--primary-content);
  font-size:14px;
  line-height:1;
  font-weight:800;
}
.brand-text{font-weight:800}
.brand .badge{
  font-size:10.5px;
  font-weight:700;
  padding:2px 7px;
  border-radius:999px;
  background:var(--primary);
  color:var(--primary-content);
}

/* DESKTOP LINKS (HIDDEN ON MOBILE) */
.links{
  display:none;
}
.gh-link{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:5px 13px;
  border-radius:999px;
  border:1px solid var(--border);
  background:var(--bg-2);
  font-size:13px;
}

/* NAV CONTROLS & TOGGLER */
.nav-actions{
  display:flex;
  align-items:center;
  gap:8px;
  margin-left:auto;
}
.theme-toggle{
  width:38px;
  height:38px;
  border:1px solid var(--border);
  background:var(--bg-2);
  border-radius:10px;
  cursor:pointer;
  color:var(--fg);
  display:inline-flex;
  align-items:center;
  justify-content:center;
  font-size:14px;
  transition:all .18s ease;
}
.theme-toggle:hover{
  border-color:var(--primary);
}
.theme-toggle .sun{display:var(--show-sun)}
.theme-toggle .moon{display:var(--show-moon)}

.nav-toggler{
  display:flex;
  width:38px;
  height:38px;
  padding:8px 7px;
  background:var(--bg-2);
  border:1px solid var(--border);
  border-radius:10px;
  cursor:pointer;
  flex-direction:column;
  justify-content:center;
  gap:5px;
  align-items:center;
  transition:all .2s ease;
}
.nav-toggler .bar{
  display:block;
  width:19px;
  height:2px;
  background:var(--fg);
  border-radius:2px;
  transition:all .24s ease-in-out;
  transform-origin:center;
}
.nav-toggler.is-active .bar-1{
  transform:translateY(7px) rotate(45deg);
}
.nav-toggler.is-active .bar-2{
  opacity:0;
  transform:scaleX(0);
}
.nav-toggler.is-active .bar-3{
  transform:translateY(-7px) rotate(-45deg);
}
.nav-toggler:hover{
  border-color:var(--primary);
}

/* MOBILE DROPDOWN MENU (MOBILE-FIRST) */
.nav-mobile-menu{
  position:absolute;
  top:100%;
  left:0;
  width:100%;
  background:color-mix(in srgb, var(--bg) 96%, transparent);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
  box-shadow:var(--shadow);
  padding:12px 14px 20px;
  transform:translateY(-8px);
  opacity:0;
  pointer-events:none;
  transition:opacity .24s cubic-bezier(0.16, 1, 0.3, 1), transform .24s cubic-bezier(0.16, 1, 0.3, 1);
}
.nav-mobile-menu.is-open{
  opacity:1;
  transform:translateY(0);
  pointer-events:auto;
}
.mobile-menu-inner{
  display:flex;
  flex-direction:column;
  gap:4px;
  max-width:80rem;
  margin:0 auto;
}
.mobile-link{
  display:flex;
  align-items:center;
  gap:12px;
  padding:11px 14px;
  border-radius:12px;
  font-size:14px;
  font-weight:600;
  color:var(--fg);
  transition:background .15s, color .15s, transform .15s;
  min-height:44px;
}
.mobile-link:hover, .mobile-link:active{
  background:var(--bg-2);
  color:var(--primary);
  transform:translateX(3px);
}
.mobile-link .link-icon{
  width:20px;
  display:grid;
  place-items:center;
  color:var(--primary);
  font-size:13px;
}
.mobile-menu-divider{
  height:1px;
  background:var(--border);
  margin:8px 0;
}
.gh-mobile{
  background:color-mix(in srgb, var(--primary) 10%, transparent);
  color:var(--fg);
  border:1px solid color-mix(in srgb, var(--primary) 25%, transparent);
  justify-content:space-between;
}
.gh-mobile:hover{
  background:var(--primary);
  color:var(--primary-content);
}

/* VIEWPORT FADE-IN ANIMATION */
.reveal{
  opacity:0;
  transform:translateY(20px);
  transition:opacity .65s cubic-bezier(0.16, 1, 0.3, 1), transform .65s cubic-bezier(0.16, 1, 0.3, 1);
  will-change:opacity, transform;
}
.reveal.is-visible{
  opacity:1;
  transform:translateY(0);
}
@media(prefers-reduced-motion:reduce){
  .reveal{
    opacity:1 !important;
    transform:none !important;
    transition:none !important;
  }
}

/* MAIN & FOOTER (MOBILE-FIRST) */
.landing-main{min-width:0;width:100%}
.footer{
  border-top:1px solid var(--border);
  background:var(--bg-2);
  width:100%;
}
.footer-inner{
  max-width:80rem;
  margin:0 auto;
  padding:32px 14px 22px;
}
.footer-grid{
  display:flex;
  flex-direction:column;
  gap:26px;
  padding-bottom:24px;
  border-bottom:1px solid var(--border);
}
.footer-brand{
  font-weight:800;
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:8px;
  font-size:15px;
}
.footer-brand .brand-mark{
  width:22px;
  height:22px;
  font-size:11px;
  border-radius:6px;
}
.footer-desc{
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
  margin:0;
}
.footer-desc code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  background:var(--bg);
  border:1px solid var(--border);
  padding:1px 5px;
  border-radius:6px;
}
.footer-col{
  display:flex;
  flex-direction:column;
  gap:8px;
}
.footer-col strong{
  font-size:13px;
  margin-bottom:3px;
  color:var(--fg);
  text-transform:uppercase;
  letter-spacing:.05em;
  font-weight:700;
}
.footer-col a{
  font-size:13px;
  color:var(--muted);
  padding:3px 0;
  transition:color .15s;
}
.footer-col a:hover{
  color:var(--primary);
}
.footer-bottom{
  padding-top:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:12px;
  color:var(--muted);
}
.footer-bottom a{
  color:var(--muted);
  text-decoration:underline;
  text-underline-offset:3px;
}

/* PROGRESSIVE ENHANCEMENT: TABLET (min-width: 640px) */
@media(min-width:640px){
  .nav-inner{
    padding:12px 20px;
  }
  .footer-inner{
    padding:40px 20px 26px;
  }
  .footer-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:28px;
    padding-bottom:28px;
  }
  .footer-bottom{
    flex-direction:row;
    justify-content:space-between;
    align-items:center;
  }
}

/* PROGRESSIVE ENHANCEMENT: DESKTOP (min-width: 880px) */
@media(min-width:880px){
  .links{
    display:flex;
    margin-left:auto;
    margin-right:12px;
    gap:18px;
    font-size:13.5px;
    color:var(--muted);
    align-items:center;
  }
  .links a{
    color:var(--muted);
    font-weight:500;
    transition:color .15s;
  }
  .links a:hover{
    color:var(--fg);
  }
  .nav-toggler{
    display:none;
  }
  .nav-mobile-menu{
    display:none !important;
  }
}

/* PROGRESSIVE ENHANCEMENT: LARGE DESKTOP (min-width: 1024px) */
@media(min-width:1024px){
  .links{
    gap:22px;
    font-size:14px;
  }
  .footer-grid{
    grid-template-columns:1.4fr 1fr 1fr 1fr;
    gap:32px;
    padding-bottom:32px;
  }
  .footer-inner{
    padding:48px 24px 28px;
  }
}
</style>
