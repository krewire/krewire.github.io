<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.Title}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <script>
    (function(){
      try{
        var t = localStorage.getItem("krewire-theme") || "auto";
        var m = t==="auto"? (matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light") : t;
        document.documentElement.dataset.theme = m;
        document.documentElement.classList.toggle("dark", m==="dark");
      }catch(e){}
      window.krewireTheme={toggle:function(){
        var cur=document.documentElement.dataset.theme;
        var nxt=cur==="dark"?"light":"dark";
        document.documentElement.dataset.theme=nxt;
        document.documentElement.classList.toggle("dark", nxt==="dark");
        try{localStorage.setItem("krewire-theme",nxt)}catch(e){}
      }};
    })();
  </script>
</head>
<body>
  <header class="nav" id="main-nav">
    <div class="nav-inner">
      <a class="brand" href="/">
        <span class="brand-mark">◈</span>
        <span class="brand-text">Krewire</span>
        <span class="badge" data-i18n="nav.badge">Contributors</span>
      </a>
      <nav class="links">
        <a href="#benefits" data-i18n="nav.perks">Perks & Access</a>
        <a href="#where-to-start" data-i18n="nav.start">Where to Start</a>
        <a href="#repositories" data-i18n="nav.repositories">Repositories</a>
        <a href="#pathways" data-i18n="nav.pathways">Pathways</a>
        <a href="#standards" data-i18n="nav.standards">Standards</a>
        <a href="#boost" data-i18n="nav.guild">AI Boost</a>
        <a href="https://github.com/krewire" target="_blank" rel="noopener" class="gh-link"><span>★</span> <span data-i18n="nav.github">GitHub</span></a>
      </nav>
      <div class="nav-actions">
        <button class="lang-toggle" data-lang-toggle aria-label="Toggle language" onclick="window.krewireI18n.toggle()">
          <span class="lang-icon">🌐</span>
          <span class="lang-code">EN</span>
        </button>
        <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" onclick="window.krewireTheme.toggle()">
          <span class="sun">☀</span><span class="moon">☾</span>
        </button>
        <button class="nav-toggler" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-menu">
          <span class="bar bar-1"></span>
          <span class="bar bar-2"></span>
          <span class="bar bar-3"></span>
        </button>
      </div>
    </div>
    <div class="nav-mobile-menu" id="mobile-nav-menu" aria-hidden="true">
      <div class="mobile-menu-inner">
        <a class="mobile-link" href="#benefits">
          <span class="link-icon">★</span>
          <span data-i18n="nav.perks">Perks & Lifetime Access</span>
        </a>
        <a class="mobile-link" href="#where-to-start">
          <span class="link-icon">🧭</span>
          <span data-i18n="nav.start">Where to Start (Nav Map)</span>
        </a>
        <a class="mobile-link" href="#get-started">
          <span class="link-icon">⚡</span>
          <span data-i18n="hero.cta_start">Getting Started</span>
        </a>
        <a class="mobile-link" href="#repositories">
          <span class="link-icon">⬢</span>
          <span data-i18n="nav.repositories">Core Repositories</span>
        </a>
        <a class="mobile-link" href="#pathways">
          <span class="link-icon">◈</span>
          <span data-i18n="nav.pathways">Contribution Pathways</span>
        </a>
        <a class="mobile-link" href="#standards">
          <span class="link-icon">✓</span>
          <span data-i18n="nav.standards">The 3 Quality Gates</span>
        </a>
        <a class="mobile-link" href="#boost">
          <span class="link-icon">▲</span>
          <span data-i18n="nav.guild">AI Boost Collaboration</span>
        </a>
        <div class="mobile-menu-divider"></div>
        <a class="mobile-link gh-mobile" href="https://github.com/krewire" target="_blank" rel="noopener">
          <span>★ <span data-i18n="footer.gh_org">GitHub Organization</span></span>
          <span class="link-arrow">↗</span>
        </a>
      </div>
    </div>
  </header>
  <main class="landing-main">{{.Content}}</main>
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-grid">
        <div>
          <div class="footer-brand"><span class="brand-mark">◈</span> <span data-i18n="footer.brand_title">Krewire Contributors</span></div>
          <p class="footer-desc" data-i18n-html="footer.desc_html">Home of the Open Source Collective.<br>Crafting an autonomous, sustainable, and scalable Go ecosystem at near-zero cost.</p>
        </div>
        <div class="footer-col">
          <strong data-i18n="footer.col_repos">Repositories</strong>
          <a href="https://github.com/krewire/framework" target="_blank" rel="noopener">framework</a>
          <a href="https://github.com/krewire/libs" target="_blank" rel="noopener">libs (Krewire Libs)</a>
          <a href="https://github.com/krewire/kiw" target="_blank" rel="noopener">kiw (cli)</a>
          <a href="https://github.com/krewire/boost" target="_blank" rel="noopener">boost (ai agent)</a>
          <a href="https://github.com/krewire/hub" target="_blank" rel="noopener">hub (plugins)</a>
          <a href="https://github.com/krewire/ship" target="_blank" rel="noopener">ship (deployer)</a>
          <a href="https://github.com/krewire/mdbind" target="_blank" rel="noopener">mdbind (compiler)</a>
        </div>
        <div class="footer-col">
          <strong data-i18n="footer.col_contrib">Contribution</strong>
          <a href="#benefits" data-i18n="footer.perks">Contributor Perks & Access</a>
          <a href="#where-to-start" data-i18n="footer.where_start">Where to Start (Nav Map)</a>
          <a href="#get-started" data-i18n="footer.getting_started">Getting Started</a>
          <a href="#pathways" data-i18n="footer.pathways">Contribution Pathways</a>
          <a href="#standards" data-i18n="footer.standards">The Krewire Way (Gates)</a>
          <a href="#boost" data-i18n="footer.guild">AI Boost Collaboration</a>
          <a href="https://github.com/krewire/framework/tree/main/docs/specs" target="_blank" rel="noopener" data-i18n="footer.kwf_specs">KWF Specs</a>
        </div>
        <div class="footer-col">
          <strong data-i18n="footer.col_community">Community</strong>
          <a href="https://github.com/krewire" target="_blank" rel="noopener" data-i18n="footer.gh_org">GitHub Organization</a>
          <a href="https://github.com/orgs/krewire/discussions" target="_blank" rel="noopener" data-i18n="footer.discussions">Discussions</a>
          <a href="https://github.com/krewire/framework/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener" data-i18n="footer.good_first">Good First Issues</a>
          <a href="https://github.com/krewire/.github/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener" data-i18n="footer.coc">Code of Conduct</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span data-i18n-html="footer.bottom_rights_html">© 2026 Krewire Contributors — Built 100% with Krewire <code>site</code> workload (Dogfooding).</span>
        <span><a href="https://github.com/krewire" target="_blank" rel="noopener">github.com/krewire</a></span>
      </div>
    </div>
  </footer>
  <script src="/assets/app.js" defer></script>
</body>
</html>

<style>
/* CSS VARIABLES & TOKENS */
:root{
  --primary:#39D353;
  --primary-content:#0B1F3B;
  --secondary:#00D1C1;
  --secondary-content:#0B1F3B;
  --accent:#FF3B2E;
  --accent-content:#ffffff;
  --success:#39D353;
  --warning:#ffb703;
  --error:#FF3B2E;
  --info:#00D1C1;
  --bg:#FAF8F4;
  --bg-2:#f2ede4;
  --fg:#0B1F3B;
  --muted:#57677d;
  --border:#0B1F3B;
  --border-subtle:rgba(11,31,59,.18);
  --pop-border:2.5px solid #0B1F3B;
  --pop-border-thin:2px solid #0B1F3B;
  --pop-shadow:4px 4px 0px #0B1F3B;
  --pop-shadow-lg:6px 6px 0px #0B1F3B;
  --pop-shadow-sm:2px 2px 0px #0B1F3B;
  --dot-color:rgba(11,31,59,.08);
  --radius:10px;
  --shadow:4px 4px 0px #0B1F3B;
  --show-sun:inline;
  --show-moon:none;
}
:root[data-theme="dark"], [data-theme="dark"], html[data-theme="dark"]{
  --primary:#39D353 !important;
  --primary-content:#0B1F3B !important;
  --secondary:#00D1C1 !important;
  --secondary-content:#0B1F3B !important;
  --bg:#0B1F3B;
  --bg-2:#112646;
  --fg:#FAF8F4;
  --muted:#9ab0ce;
  --border:#FAF8F4;
  --border-subtle:rgba(250,248,244,.2);
  --pop-border:2.5px solid #FAF8F4;
  --pop-border-thin:2px solid #FAF8F4;
  --pop-shadow:4px 4px 0px #39D353;
  --pop-shadow-lg:6px 6px 0px #39D353;
  --pop-shadow-sm:2px 2px 0px #39D353;
  --dot-color:rgba(250,248,244,.08);
  --shadow:4px 4px 0px #39D353;
  --show-sun:none;
  --show-moon:inline;
}

/* GLOBAL RESET & MOBILE-FIRST BASE */
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;
  font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background:var(--bg);
  color:var(--fg);
  font-size:14.5px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  min-width:0;
}
a{color:inherit;text-decoration:none}
a:hover{color:var(--primary)}

/* STICKY TOP NAVBAR (MOBILE-FIRST) */
.nav{
  position:sticky;
  top:0;
  z-index:50;
  background:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.nav-inner{
  max-width:80rem;
  margin:0 auto;
  padding:10px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
.brand{
  font-weight:900;
  letter-spacing:-.03em;
  display:flex;
  align-items:center;
  gap:8px;
  font-size:16px;
  flex-shrink:0;
}
.brand-mark{
  width:30px;
  height:30px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:var(--primary);
  color:var(--primary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  font-size:15px;
  line-height:1;
  font-weight:900;
}
.brand-text{font-weight:900;letter-spacing:-.03em}
.brand .badge{
  font-size:10.5px;
  font-weight:800;
  padding:2px 7px;
  border-radius:6px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
}

/* DESKTOP LINKS (HIDDEN ON MOBILE) */
.links{
  display:none;
}
.gh-link{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 13px;
  border-radius:8px;
  border:var(--pop-border-thin);
  background:var(--secondary);
  color:var(--secondary-content);
  box-shadow:var(--pop-shadow-sm);
  font-size:13px;
  font-weight:800;
  transition:all .15s ease;
}
.gh-link:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--primary);
  color:var(--primary-content);
}
.gh-link:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}

/* NAV CONTROLS & TOGGLER */
.nav-actions{
  display:flex;
  align-items:center;
  gap:8px;
  margin-left:auto;
  flex-shrink:0;
}
.lang-toggle{
  height:36px;
  padding:0 10px;
  border:var(--pop-border-thin);
  background:var(--bg);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  cursor:pointer;
  color:var(--fg);
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-size:12px;
  font-weight:800;
  letter-spacing:.02em;
  transition:all .15s ease;
  flex-shrink:0;
}
.lang-toggle:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--bg-2);
}
.lang-toggle:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.lang-toggle .lang-icon{font-size:13px}
.lang-toggle .lang-code{font-weight:900}

.theme-toggle{
  width:36px;
  height:36px;
  border:var(--pop-border-thin);
  background:var(--bg);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  cursor:pointer;
  color:var(--fg);
  display:inline-flex;
  align-items:center;
  justify-content:center;
  font-size:14px;
  transition:all .15s ease;
  flex-shrink:0;
}
.theme-toggle:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--bg-2);
}
.theme-toggle:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.theme-toggle .sun{display:var(--show-sun)}
.theme-toggle .moon{display:var(--show-moon)}

.nav-toggler{
  display:flex;
  width:36px;
  height:36px;
  padding:0;
  background:var(--bg);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  border-radius:8px;
  cursor:pointer;
  flex-direction:column;
  justify-content:center;
  gap:4.5px;
  align-items:center;
  transition:all .15s ease;
  flex-shrink:0;
}
.nav-toggler:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--bg-2);
}
.nav-toggler:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.nav-toggler .bar{
  display:block;
  width:16px;
  height:2.5px;
  background:var(--fg);
  border-radius:2px;
  transition:all .24s ease-in-out;
  transform-origin:center;
}
.nav-toggler.is-active .bar-1{
  transform:translateY(7px) rotate(45deg);
}
.nav-toggler.is-active .bar-2{
  opacity:0;
  transform:scaleX(0);
}
.nav-toggler.is-active .bar-3{
  transform:translateY(-7px) rotate(-45deg);
}

/* MOBILE DROPDOWN MENU (MOBILE-FIRST) */
.nav-mobile-menu{
  position:absolute;
  top:100%;
  left:0;
  width:100%;
  background:var(--bg);
  border-bottom:var(--pop-border);
  box-shadow:0 12px 0px rgba(0,0,0,0.12);
  padding:14px 14px 22px;
  transform:translateY(-8px);
  opacity:0;
  pointer-events:none;
  transition:opacity .2s ease, transform .2s ease;
}
.nav-mobile-menu.is-open{
  opacity:1;
  transform:translateY(0);
  pointer-events:auto;
}
.mobile-menu-inner{
  display:flex;
  flex-direction:column;
  gap:6px;
  max-width:80rem;
  margin:0 auto;
}
.mobile-link{
  display:flex;
  align-items:center;
  gap:12px;
  padding:11px 14px;
  border-radius:8px;
  border:1.5px solid transparent;
  font-size:14px;
  font-weight:700;
  color:var(--fg);
  transition:all .15s ease;
  min-height:44px;
}
.mobile-link:hover, .mobile-link:active{
  background:var(--bg-2);
  border-color:var(--border);
  box-shadow:var(--pop-shadow-sm);
  color:var(--fg);
  transform:translateX(2px);
}
.mobile-link .link-icon{
  width:20px;
  display:grid;
  place-items:center;
  color:var(--primary);
  font-size:14px;
}
.mobile-menu-divider{
  height:2px;
  background:var(--border);
  margin:8px 0;
}
.gh-mobile{
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  justify-content:space-between;
}
.gh-mobile:hover{
  background:var(--primary);
  color:var(--primary-content);
}

/* VIEWPORT FADE-IN ANIMATION */
.reveal{
  opacity:0;
  transform:translateY(16px);
  transition:opacity .5s cubic-bezier(0.16, 1, 0.3, 1), transform .5s cubic-bezier(0.16, 1, 0.3, 1);
  will-change:opacity, transform;
}
.reveal.is-visible{
  opacity:1;
  transform:translateY(0);
}
@media(prefers-reduced-motion:reduce){
  .reveal{
    opacity:1 !important;
    transform:none !important;
    transition:none !important;
  }
}

/* MAIN & FOOTER (MOBILE-FIRST) */
.landing-main{min-width:0;width:100%}
.footer{
  border-top:1px solid var(--border);
  background:var(--bg-2);
  width:100%;
}
.footer-inner{
  max-width:80rem;
  margin:0 auto;
  padding:32px 14px 22px;
}
.footer-grid{
  display:flex;
  flex-direction:column;
  gap:26px;
  padding-bottom:24px;
  border-bottom:1px solid var(--border);
}
.footer-brand{
  font-weight:800;
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:8px;
  font-size:15px;
}
.footer-brand .brand-mark{
  width:22px;
  height:22px;
  font-size:11px;
  border-radius:6px;
}
.footer-desc{
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
  margin:0;
}
.footer-desc code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  background:var(--bg);
  border:1px solid var(--border);
  padding:1px 5px;
  border-radius:6px;
}
.footer-col{
  display:flex;
  flex-direction:column;
  gap:8px;
}
.footer-col strong{
  font-size:13px;
  margin-bottom:3px;
  color:var(--fg);
  text-transform:uppercase;
  letter-spacing:.05em;
  font-weight:700;
}
.footer-col a{
  font-size:13px;
  color:var(--muted);
  padding:3px 0;
  transition:color .15s;
}
.footer-col a:hover{
  color:var(--primary);
}
.footer-bottom{
  padding-top:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:12px;
  color:var(--muted);
}
.footer-bottom a{
  color:var(--muted);
  text-decoration:underline;
  text-underline-offset:3px;
}

/* ==========================================================================
   VIEWPORT SM: SMALL SCREENS / LARGE PHONES & SMALL TABLETS (min-width: 640px)
   ========================================================================== */
@media (min-width: 640px){
  .nav-inner{
    padding:10px 18px;
  }
  .footer-inner{
    padding:36px 18px 24px;
  }
  .footer-grid{
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:26px;
    padding-bottom:26px;
  }
  .footer-bottom{
    flex-direction:row;
    justify-content:space-between;
    align-items:center;
  }
}

/* ==========================================================================
   VIEWPORT MD: MEDIUM SCREENS / TABLETS & LAPTOPS (min-width: 768px)
   ========================================================================== */
@media (min-width: 768px){
  .nav-inner{
    padding:12px 20px;
    gap:16px;
  }
  /* On medium screens (tablets), keep links hidden and use hamburger menu */
  .footer-inner{
    padding:42px 20px 26px;
  }
  .footer-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:30px;
  }
}

/* ==========================================================================
   VIEWPORT LG: LARGE SCREENS / DESKTOPS (min-width: 1024px)
   ========================================================================== */
@media (min-width: 1024px){
  .nav-inner{
    padding:14px 24px;
    gap:24px;
  }
  /* On desktop, show full horizontal links and hide hamburger menu */
  .links{
    display:flex;
    margin-left:auto;
    margin-right:12px;
    gap:22px;
    font-size:14px;
    align-items:center;
  }
  .links a{
    color:var(--muted);
    font-weight:500;
    transition:color .15s;
    white-space:nowrap;
  }
  .links a:hover{
    color:var(--fg);
  }
  .nav-toggler{
    display:none !important;
  }
  .nav-mobile-menu{
    display:none !important;
  }
  .footer-grid{
    grid-template-columns:1.4fr 1fr 1fr 1fr;
    gap:32px;
    padding-bottom:32px;
  }
  .footer-inner{
    padding:48px 24px 28px;
  }
}
</style>
