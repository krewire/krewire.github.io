<section class="w-full bg-bg dark:bg-bg-dark bg-dots py-14 sm:py-18 md:py-22 border-b-2 border-border" id="start">
  <div class="container-site">
    <div class="w-full text-center flex flex-col items-center justify-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="mb-4">
        <Badge Variant="primary"><span data-i18n="start.badge">Start Here</span></Badge>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-fg dark:text-fg-dark mb-4" data-i18n="start.title">From Discovery to Your First Krewire Project</h2>
      <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed" data-i18n="start.subtitle">This portal is the community front door. Technical documentation, installation, and guides live on krewire.com and are maintained alongside the core repository. Follow these four steps in order.</p>
    </div>

    <!-- 4 Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
      <Card variant="default" class="p-6 flex flex-col justify-between h-full bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div>
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-primary-content font-black text-sm mb-4">1</span>
          <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="start.s1_title">Understand Krewire</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-4" data-i18n="start.s1_desc">Read the overview to learn what Krewire is, its design principles, and which workload kinds it supports.</p>
        </div>
        <a href="https://krewire.com/docs" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline flex items-center gap-1" data-i18n="start.s1_link">Read the overview on krewire.com ↗</a>
      </Card>

      <Card variant="default" class="p-6 flex flex-col justify-between h-full bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div>
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-primary-content font-black text-sm mb-4">2</span>
          <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="start.s2_title">Install the kiw CLI</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-4" data-i18n="start.s2_desc">Follow the canonical installation guide. It covers the shell installer, go install, and how to verify the install.</p>
        </div>
        <a href="https://krewire.com/docs/getting-started/installation" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline flex items-center gap-1" data-i18n="start.s2_link">Installation guide ↗</a>
      </Card>

      <Card variant="default" class="p-6 flex flex-col justify-between h-full bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div>
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-primary-content font-black text-sm mb-4">3</span>
          <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="start.s3_title">Build Your First Project</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-4" data-i18n="start.s3_desc">Work through the hands-on quickstart: scaffold a project, run the dev server, make a change, and build it.</p>
        </div>
        <a href="https://krewire.com/docs/getting-started#4-hands-on-5-minute-quickstart" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline flex items-center gap-1" data-i18n="start.s3_link">5-minute quickstart ↗</a>
      </Card>

      <Card variant="default" class="p-6 flex flex-col justify-between h-full bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div>
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-primary-content font-black text-sm mb-4">4</span>
          <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="start.s4_title">Choose Your Next Step</h3>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-4" data-i18n="start.s4_desc">Once your first project builds, pick the workload guide that matches what you want to ship next. Ask questions or share what you built in GitHub Discussions.</p>
        </div>
        <a href="https://krewire.com/docs/workloads" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline flex items-center gap-1" data-i18n="start.s4_link">Workload guides ↗</a>
      </Card>
    </div>

    <!-- Where Things Live Sub-Grid -->
    <div class="mt-8 pt-8 border-t border-border-subtle">
      <h3 class="text-lg font-black tracking-tight text-fg dark:text-fg-dark mb-6 text-center" data-i18n="start.dest_title">Where Things Live</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="p-4 rounded-xl border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 flex flex-col justify-between">
          <strong class="text-xs font-black uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="start.d1_label">Discovery &amp; Community</strong>
          <p class="text-xs text-muted dark:text-muted-dark mb-3" data-i18n="start.d1_desc">This portal: how to get started, how to contribute, and how to support the project.</p>
          <a href="#start" class="text-xs font-bold text-primary hover:underline" data-i18n="start.d1_link">You are here</a>
        </div>
        <div class="p-4 rounded-xl border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 flex flex-col justify-between">
          <strong class="text-xs font-black uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="start.d2_label">Documentation</strong>
          <p class="text-xs text-muted dark:text-muted-dark mb-3" data-i18n="start.d2_desc">The canonical source for installation, quickstart, guides, and CLI reference, in English and Indonesian.</p>
          <a href="https://krewire.com/docs" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline">krewire.com/docs ↗</a>
        </div>
        <div class="p-4 rounded-xl border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 flex flex-col justify-between">
          <strong class="text-xs font-black uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="start.d3_label">Source &amp; Releases</strong>
          <p class="text-xs text-muted dark:text-muted-dark mb-3" data-i18n="start.d3_desc">The core repository holds the Go packages and the kiw CLI. Versions are published as Git tags.</p>
          <a href="https://github.com/krewire/krewire/tags" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline" data-i18n="start.d3_link">Release tags ↗</a>
        </div>
        <div class="p-4 rounded-xl border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 flex flex-col justify-between">
          <strong class="text-xs font-black uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="start.d4_label">Contribution</strong>
          <p class="text-xs text-muted dark:text-muted-dark mb-3" data-i18n="start.d4_desc">Workflow, commit conventions, and quality gates are defined in the core repository's CONTRIBUTING.md.</p>
          <a href="https://github.com/krewire/krewire/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline" data-i18n="start.d4_link">CONTRIBUTING.md ↗</a>
        </div>
        <div class="p-4 rounded-xl border border-border-subtle bg-bg-2 dark:bg-bg-dark-2 flex flex-col justify-between">
          <strong class="text-xs font-black uppercase tracking-wider text-fg dark:text-fg-dark mb-1" data-i18n="start.d5_label">Questions &amp; Bugs</strong>
          <p class="text-xs text-muted dark:text-muted-dark mb-3" data-i18n="start.d5_desc">Ask questions in GitHub Discussions. Report bugs in the issue tracker of the repository they affect.</p>
          <a href="https://github.com/krewire/krewire.com/discussions" target="_blank" rel="noopener" class="text-xs font-bold text-primary hover:underline" data-i18n="start.d5_link">GitHub Discussions ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- =====================================================================
     WHY CONTRIBUTE & PATHWAYS
     ===================================================================== -->
<section class="w-full bg-bg-2 dark:bg-bg-dark-2 bg-dots py-14 sm:py-18 md:py-22 border-b-2 border-border" id="privileges">
  <div class="container-site">
    <div class="w-full text-center flex flex-col items-center justify-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="mb-4">
        <Badge Variant="primary"><span data-i18n="privileges.badge">Why Contribute</span></Badge>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-fg dark:text-fg-dark mb-4" data-i18n="privileges.title">Why Contribute to Krewire</h2>
      <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed" data-i18n="privileges.subtitle">Contributions land in an MIT-licensed open-source core that anyone can use. There is no paid perk or license program attached to contributing today.</p>
    </div>

    <!-- Benefits Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <Card variant="default" class="p-6 bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <Badge Variant="secondary" Size="sm" Class="mb-3"><span data-i18n="privileges.p1_badge">Open Core</span></Badge>
        <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="privileges.p1_title">Your Work Ships in the Open</h3>
        <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="privileges.p1_desc">Merged changes become part of the MIT-licensed core that anyone can use, study, and build on.</p>
      </Card>

      <Card variant="default" class="p-6 bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow-lg)">
        <Badge Variant="primary" Size="sm" Class="mb-3"><span data-i18n="privileges.p2_badge">Review</span></Badge>
        <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="privileges.p2_title">Learn Through Code Review</h3>
        <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="privileges.p2_desc">Every pull request is reviewed before merge and checked against the quality gates in CONTRIBUTING.md.</p>
      </Card>

      <Card variant="default" class="p-6 bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <Badge Variant="secondary" Size="sm" Class="mb-3"><span data-i18n="privileges.p3_badge">Credit</span></Badge>
        <h3 class="text-base font-extrabold text-fg dark:text-fg-dark mb-2" data-i18n="privileges.p3_title">Public, Lasting Credit</h3>
        <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed" data-i18n="privileges.p3_desc">Your commits stay attributed to you in the project's public Git history.</p>
      </Card>
    </div>

    <!-- Policy callout -->
    <div class="p-4 sm:p-5 rounded-xl border-2 border-border bg-bg dark:bg-bg-dark mb-10 flex items-start gap-3" style="box-shadow:var(--pop-shadow-sm)">
      <span class="text-xl shrink-0">ℹ️</span>
      <div class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed">
        <strong class="text-fg dark:text-fg-dark" data-i18n="privileges.policy_title">About perks and privileges: </strong>
        <span data-i18n="privileges.policy_text">Earlier versions of this page described lifetime commercial licenses and a four-tier privilege ladder. Those programs are not approved or operational and have been withdrawn. If maintainers introduce a recognition program, it will be documented here with its actual terms.</span>
      </div>
    </div>

    <!-- Interactive Pathways Selector -->
    <Card variant="default" class="p-6 sm:p-8 bg-bg dark:bg-bg-dark" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
      <div class="mb-4">
        <h3 class="text-lg font-black text-fg dark:text-fg-dark mb-1">Choose Your Contributor Pathway</h3>
        <p class="text-xs sm:text-sm text-muted dark:text-muted-dark">Select your background to see curated tasks, recommended starter repositories, and architecture resources.</p>
      </div>

      <div class="flex flex-wrap gap-2 mb-6">
        <button class="pathway-tab active btn btn-sm btn-primary" onclick="selectPathway('newbie')">🌱 New to Go?</button>
        <button class="pathway-tab btn btn-sm btn-outline" onclick="selectPathway('backend')">⚙️ Backend Engineer</button>
        <button class="pathway-tab btn btn-sm btn-outline" onclick="selectPathway('frontend')">🎨 Frontend &amp; UI</button>
        <button class="pathway-tab btn btn-sm btn-outline" onclick="selectPathway('devops')">☁️ DevOps &amp; Infra</button>
      </div>

      <div class="p-5 rounded-xl bg-bg-2 dark:bg-bg-dark-2 border border-border-subtle" id="pathwayDetails">
        <h4 id="pathwayTitle" class="font-extrabold text-base text-fg dark:text-fg-dark mb-2">New to Go? (Beginner Friendly)</h4>
        <p id="pathwayDesc" class="text-xs sm:text-sm text-muted dark:text-muted-dark mb-4 leading-relaxed">Start by polishing documentation in <code>krewire.com</code>, writing unit tests for <code>krewire/pkg/model</code>, or fixing starter bugs labeled <code>good first issue</code>.</p>
        <a id="pathwayCta" href="https://github.com/krewire/krewire/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Find Good First Issues →</a>
      </div>
    </Card>
  </div>
</section>

<!-- =====================================================================
     REPOSITORIES & CONTRIBUTION MATRIX
     ===================================================================== -->
<section class="w-full bg-bg dark:bg-bg-dark bg-dots py-14 sm:py-18 md:py-22 border-b-2 border-border" id="pathways">
  <div class="container-site">
    <div class="w-full text-center flex flex-col items-center justify-center max-w-3xl mx-auto mb-12">
      <div class="mb-4">
        <Badge Variant="primary"><span data-i18n="pathways.badge">Codebase Matrix</span></Badge>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-fg dark:text-fg-dark mb-4" data-i18n="pathways.title">Public Repositories &amp; Contribution Matrix</h2>
      <p class="text-sm sm:text-base text-muted dark:text-muted-dark leading-relaxed" data-i18n="pathways.subtitle">Match your skills and passions to the right repository, bootstrap your local environment, and dive straight into active issues.</p>
    </div>

    <!-- Bootstrap terminal box -->
    <div class="mb-10 max-w-3xl mx-auto">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2">
          <span class="text-primary font-bold">⚡</span>
          <strong class="text-sm font-extrabold text-fg dark:text-fg-dark" data-i18n="pathways.one_line_title">One-Command Contributor Bootstrap</strong>
        </div>
        <Badge Variant="secondary" Size="sm"><span data-i18n="pathways.one_line_badge">Recommended</span></Badge>
      </div>
      <p class="text-xs sm:text-sm text-muted dark:text-muted-dark mb-3" data-i18n-html="pathways.one_line_desc_html">Clone the core repository and run its test suite. Before opening a pull request, run the full quality gates listed in <code>CONTRIBUTING.md</code>:</p>
      <Terminal Command="git clone https://github.com/krewire/krewire.git && cd krewire && go test ./..." Class="w-full" />
      <div class="flex items-center gap-2 text-2xs text-muted dark:text-muted-dark mt-2 font-semibold">
        <span data-i18n="pathways.meta_prereq">Prerequisites: Go 1.27.1+ and Git</span>
        <span>·</span>
        <span data-i18n="pathways.meta_zero">No extra configuration needed</span>
      </div>
    </div>

    <!-- Repositories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 1. krewire/krewire -->
      <Card variant="default" class="p-6 flex flex-col justify-between bg-bg-2 dark:bg-bg-dark-2" style="border:var(--pop-border); box-shadow:var(--pop-shadow)">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <Badge Variant="primary" Size="sm">Core Engine</Badge>
            <span class="text-2xs font-mono font-bold text-muted dark:text-muted-dark">Go 1.27.1</span>
          </div>
          <h3 class="text-lg font-black text-fg dark:text-fg-dark mb-1">
            <a href="https://github.com/krewire/krewire" target="_blank" rel="noopener" class="hover:text-primary transition-colors">krewire/krewire ↗</a>
          </h3>
          <div class="text-xs font-bold text-primary mb-3">Core Monorepo &amp; Libraries</div>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark leading-relaxed mb-4">Modular Go libraries (pkg/*), CLI devtool (tools/kiw), fullstack runtimes, background queues, and AI agent starters.</p>
          <div class="flex flex-wrap gap-1.5 mb-6">
            <span class="text-2xs font-mono font-semibold px-2 py-0.5 rounded bg-bg dark:bg-bg-dark border border-border-subtle">pkg/model</span>
            <span class="text-2xs font-mono font-semibold px-2 py-0.5 rounded bg-bg dark:bg-bg-dark border border-border-subtle">pkg/lifecycle</span>
            <span class="text-2xs font-mono font-semibold px-2 py-0.5 rounded bg-bg dark:bg-bg-dark border border-border-subtle">pkg/web</span>
            <span class="text-2xs font-mono font-semibold px-2 py-0.5 rounded bg-bg dark:bg-bg-dark border border-border-subtle">pkg/ui</span>
            <span class="text-2xs font-mono font-semibold px-2 py-0.5 rounded bg-bg dark:bg-bg-dark border border-border-subtle">tools/kiw</span>
          </div>
        </div>
        <div class="flex items-center gap-2 pt-4 border-t border-border-subtle">
