<section class="w-full bg-bg dark:bg-bg-dark bg-dots py-14 sm:py-18 md:py-24 lg:py-28 border-b-2 border-border" id="overview">
  <div class="container-site">
    <div class="flex flex-col md:grid md:grid-cols-2 md:items-center gap-8 sm:gap-10 md:gap-12 lg:gap-16">

      <!-- Copy -->
      <div class="min-w-0 w-full">
        <div class="flex flex-col items-start w-full">
          <!-- Eyebrow -->
          <div class="mb-4 sm:mb-6">
            <Badge Variant="primary" dot=true>
              <span data-i18n="hero.eyebrow">◈ OPEN-SOURCE COLLECTIVE · BORN IN INDONESIA · FOR THE WORLD</span>
            </Badge>
          </div>

          <!-- Headline -->
          <h1 class="font-black tracking-tighter leading-tight text-fg dark:text-fg-dark break-words mb-5 sm:mb-6"
              style="font-size:clamp(30px,6.5vw,56px); letter-spacing:-0.04em"
              data-i18n-html="hero.title_html">
            Build with Krewire. Contribute Code.<br class="hidden sm:inline">
            <span class="text-primary">Empower Indonesian Engineers.</span>
          </h1>

          <!-- Lead -->
          <p class="text-sm sm:text-base md:text-lg text-muted dark:text-muted-dark leading-relaxed max-w-xl lg:max-w-2xl xl:max-w-none mb-6 sm:mb-8"
             data-i18n="hero.lead">
            Krewire is an open-source movement engineered in Indonesia to turn builders from software consumers into world-class creators. Its modular Go libraries are MIT-licensed and free to use, and community support helps sustain long-term maintenance.
          </p>

          <!-- Quick terminal -->
          <div class="w-full max-w-xl lg:max-w-2xl xl:max-w-none flex flex-col gap-3.5 mb-8 sm:mb-10">
            <Terminal Command="curl -fsSL https://krewire.com/scripts/install.sh | sh" Class="w-full" />
            <Terminal Command="kiw new my-site --site && cd my-site && kiw dev" PromptColor="muted" Class="w-full" />
          </div>

          <!-- CTAs -->
          <div class="w-full sm:w-auto flex flex-wrap items-center gap-4 sm:gap-5 mb-5 sm:mb-6">
            <Button Variant="primary" Size="lg" Href="#start"><span data-i18n="hero.cta_start">Get Started →</span></Button>
            <Button Variant="secondary" Size="lg" Href="#pathways"><span data-i18n="hero.cta_contribute">Start Contributing</span></Button>
            <Button Variant="outline" Size="lg" Href="#sponsorship"><span data-i18n="hero.cta_sponsor">Support Krewire</span></Button>
          </div>

          <p class="text-xs font-semibold text-muted dark:text-muted-dark mt-1" data-i18n="hero.meta">
            100% Open Source Core (MIT) · Community-Owned · Independent Infrastructure · AI-Assisted Synergy
          </p>
        </div>
      </div>

      <!-- Art / Code Window -->
      <div class="min-w-0 w-full mt-6 md:mt-0">
        <CodeWindow title="kiw — your first project">
<span class="c"># install kiw devtool</span>
<span class="s">$ curl -fsSL https://krewire.com/scripts/install.sh | sh</span>

<span class="c"># scaffold a modern .kiw site workload</span>
<span class="s">$ kiw new my-site --site</span>
<span class="k">✓ scaffolded Krewire project (variant=static)</span>

<span class="c"># start the live development server</span>
<span class="s">$ cd my-site && kiw dev</span>
<span class="k">⚡ ready on http://localhost:8080</span>
<span class="c"># 100% Open Source Core (MIT) · Crafted in Indonesia</span>
        </CodeWindow>
      </div>

    </div>
  </div>
</section>

