            </div>
            <h3 class="repo-title">
              <a href="https://github.com/krewire/krewire.github.io" target="_blank" rel="noopener">krewire.github.io</a>
            </h3>
            <div class="repo-track-name">Community &amp; Support Portal</div>
          </div>
          <div class="repo-body">
            <p class="repo-match">Start-here onboarding path, contributor pathways, community channels, and support information.</p>
            <div class="repo-pkgs">
              <span class="pkgs-label">Key Paths:</span>
              <div class="pkgs-chips">
                <span class="pkg-chip">pages/index.kiw</span>
                <span class="pkg-chip">lang/en/</span>
                <span class="pkg-chip">lang/id/</span>
              </div>
            </div>
          </div>
          <div class="repo-footer">
            <a href="https://github.com/krewire/krewire.github.io/issues" target="_blank" rel="noopener" class="repo-action primary">Issues →</a>
            <a href="https://github.com/krewire/krewire.github.io/blob/main/README.md" target="_blank" rel="noopener" class="repo-action secondary">Contributing ↗</a>
          </div>
        </div>
      </div>
      <p class="private-repos-note" data-i18n-html="pathways.private_note_html">Other Krewire repositories (<code>cloud</code>, <code>auth</code>, <code>dash</code>, <code>panel</code>, and <code>internal</code>) are private. Their code and issue trackers are not publicly accessible, so the repositories above are where external contributions happen.</p>
    </div>
  </section>

  <!-- 5-STEP CONTRIBUTOR GUIDE -->
  <section class="onboarding" id="guide">
    <div class="section-inner">
      <div class="section-head w-full text-center flex flex-col items-center justify-center">
        <div class="sub-badge" data-i18n="guide.badge">Onboarding Fast-Track</div>
        <h2 data-i18n="guide.title">Start Contributing in 5 Steps</h2>
        <p data-i18n="guide.subtitle">From zero to your first merged pull request. Here is how to get your development environment running in minutes.</p>
      </div>

      <div class="quickstart-steps">
        <div class="qs-card">
          <div class="qs-num">1</div>
          <h3 data-i18n="guide.s1_title">1. Fork &amp; Clone Repositories</h3>
          <p data-i18n="guide.s1_desc">Fork any Krewire repository to your personal GitHub account, then clone it locally to begin:</p>
          <pre><code>git clone https://github.com/your-username/krewire
cd krewire</code></pre>
        </div>

        <div class="qs-card">
          <div class="qs-num">2</div>
          <h3 data-i18n="guide.s2_title">2. Build the kiw CLI from Source</h3>
          <p data-i18n="guide.s2_desc">Inside your clone of the core repository (Go 1.27.1+), build the CLI you are changing:</p>
          <pre><code>go build -o bin/kiw ./tools/kiw/cmd/kiw
./bin/kiw version</code></pre>
        </div>

        <div class="qs-card">
          <div class="qs-num">3</div>
          <h3 data-i18n="guide.s3_title">3. Pick an Open Issue</h3>
          <p data-i18n-html="guide.s3_desc_html">Browse our curated issues list tagged with <span class="tag-issue">good first issue</span> or <span class="tag-issue">help wanted</span>. Comment to let maintainers know you are working on it.</p>
          <div class="mt-4">
            <a href="https://github.com/krewire/krewire/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener" class="btn btn-outline btn-sm" data-i18n="guide.s3_btn">View Good First Issues →</a>
          </div>
        </div>

        <div class="qs-card">
          <div class="qs-num">4</div>
          <h3 data-i18n="guide.s4_title">4. Implement &amp; Verify Locally</h3>
          <p data-i18n="guide.s4_desc">Write clean, idiomatic Go code and tests. Run the quality gates from CONTRIBUTING.md before opening a pull request:</p>
          <pre><code>gofmt -l .
go vet ./...
go test ./...
kiw compat</code></pre>
        </div>

        <div class="qs-card">
          <div class="qs-num">5</div>
          <h3 data-i18n="guide.s5_title">5. Submit PR with Conventional Commits</h3>
          <p data-i18n="guide.s5_desc">Open a PR following Conventional Commits (feat, fix, docs, refactor, test). Maintainers and AI Boost will review and guide you to merge.</p>
          <pre><code>git checkout -b feat/my-feature
git commit -m "feat(web): add handler (ref #123)"
git push origin feat/my-feature</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 AUTOMATED QUALITY GATES -->
  <section class="standards" id="standards">
    <div class="section-inner">
      <div class="section-head w-full text-center flex flex-col items-center justify-center">
        <div class="sub-badge" data-i18n="standards.badge">Quality Assurance</div>
        <h2 data-i18n="standards.title">The Krewire Way: 3 Quality Gates</h2>
        <p data-i18n="standards.subtitle">To keep the codebase reliable, predictable, and production-ready, every pull request must pass three gates. The canonical list lives in the core repository's CONTRIBUTING.md.</p>
      </div>

      <div class="gates-grid">
        <div class="gate-card">
          <div class="gate-icon">✓</div>
          <h3 data-i18n="standards.gate1_title">Gate 1: Format &amp; Lint</h3>
          <p data-i18n="standards.gate1_desc">Zero lint errors and idiomatic Go formatting. Code must adhere strictly to Go standard conventions.</p>
          <div class="gate-req" data-i18n="standards.gate1_req">Required: gofmt -l . (clean), go vet ./... (clean)</div>
        </div>

        <div class="gate-card">
          <div class="gate-icon">🛡️</div>
          <h3 data-i18n="standards.gate2_title">Gate 2: Tests</h3>
          <p data-i18n="standards.gate2_desc">Every change must pass the module's unit and integration tests, and kiw compat must report ok after version.go changes.</p>
          <div class="gate-req" data-i18n="standards.gate2_req">Required: go test ./... passes, kiw compat prints ok</div>
        </div>

        <div class="gate-card">
          <div class="gate-icon">📝</div>
          <h3 data-i18n="standards.gate3_title">Gate 3: Spec &amp; Commits</h3>
          <p data-i18n="standards.gate3_desc">Changes must link to a valid Spec or Issue, following Conventional Commits format.</p>
          <div class="gate-req" data-i18n="standards.gate3_req">Required: Semantic commit format &amp; spec traceability</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLIC GOVERNANCE & RFC FRAMEWORK (Issue #5) -->
  <section class="governance-section" id="governance">
    <div class="section-inner">
      <div class="section-head w-full text-center flex flex-col items-center justify-center">
        <div class="sub-badge">Ecosystem Governance</div>
        <h2>Public RFC Workflow &amp; Architectural Decisions</h2>
        <p>Krewire operates under transparent open-source governance. All major architectural shifts follow the Request for Comments (RFC) process before becoming permanent Architectural Decision Records (ADRs).</p>
      </div>

      <!-- 4-PHASE RFC PROCESS -->
      <div class="rfc-steps-grid mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="rfc-card p-5 border rounded-xl bg-surface">
          <div class="rfc-step-num text-xs font-bold text-primary mb-2">Phase 1</div>
          <h3 class="font-bold text-base mb-2">Proposal &amp; Problem</h3>
          <p class="text-xs text-muted">Open a GitHub Discussion in <code>krewire/internal</code> outlining the motivation, trade-offs, and ecosystem impact.</p>
        </div>
        <div class="rfc-card p-5 border rounded-xl bg-surface">
          <div class="rfc-step-num text-xs font-bold text-primary mb-2">Phase 2</div>
          <h3 class="font-bold text-base mb-2">Formal RFC Draft</h3>
          <p class="text-xs text-muted">Submit an RFC PR using the standard template covering API design, failure modes, and migration plans.</p>
        </div>
        <div class="rfc-card p-5 border rounded-xl bg-surface">
          <div class="rfc-step-num text-xs font-bold text-primary mb-2">Phase 3</div>
          <h3 class="font-bold text-base mb-2">14-Day Review</h3>
          <p class="text-xs text-muted">Public comment period for Indonesian and global contributors to review, benchmark, and propose refinements.</p>
        </div>
        <div class="rfc-card p-5 border rounded-xl bg-surface highlight-card">
          <div class="rfc-step-num text-xs font-bold text-primary mb-2">Phase 4</div>
          <h3 class="font-bold text-base mb-2">Consensus &amp; ADR</h3>
          <p class="text-xs text-muted">Consensus among Maintainers promotes the RFC into an immutable ADR (e.g., ADR-6CAB8C) committed to <code>internal/</code>.</p>
        </div>
      </div>

      <!-- PUBLIC ADR DIGEST -->
      <div class="adr-digest-box mt-10">
        <h3 class="font-bold text-lg mb-4">Canonical Architectural Decision Records (ADR Digest)</h3>
        <div class="adr-list flex flex-col gap-3">
          <div class="adr-item p-4 border rounded-lg bg-surface">
            <span class="adr-id font-bold text-primary">ADR-6CAB8C</span>: <strong>Ecosystem Architecture Baseline &amp; Strict Downward-Only Dependencies</strong>
            <p class="text-sm text-muted mt-1">Defines strict unidirectional boundaries: <code>templates/boost → tools/kiw → pkg/* → pkg/model</code>. Zero upward edges allowed.</p>
          </div>
          <div class="adr-item p-4 border rounded-lg bg-surface">
            <span class="adr-id font-bold text-primary">ADR-C9L2P</span>: <strong>Multi-Workload Single Binary Dispatch</strong>
            <p class="text-sm text-muted mt-1">Standardizes 8 workload kinds behind <code>krewire.yaml</code> and unified CLI <code>kiw</code> with zero framework lock-in.</p>
          </div>
          <div class="adr-item p-4 border rounded-lg bg-surface">
            <span class="adr-id font-bold text-primary">ADR-D1F3N</span>: <strong>Zero-Trust Defense-in-Depth Edge Security</strong>
            <p class="text-sm text-muted mt-1">Requires CSRF token verification, ACME automated TLS, token bucket rate limiting, and secure HTTP response headers across all daemons.</p>
          </div>
        </div>
      </div>

      <!-- CODE OF CONDUCT & SECURITY REPORTING -->
      <div class="coc-security-grid mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 border rounded-xl bg-surface">
          <h4 class="font-bold text-base mb-2">📜 Contributor Covenant Code of Conduct (v2.1)</h4>
          <p class="text-sm text-muted mb-3">We pledge to make participation in Krewire a harassment-free experience for everyone, regardless of age, body size, visible or invisible disability, ethnicity, sex characteristics, gender identity, or experience level.</p>
          <a href="https://github.com/krewire/.github/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener" class="text-sm text-primary font-bold">Read Full Code of Conduct (EN/ID) →</a>
        </div>
        <div class="p-6 border rounded-xl bg-surface">
          <h4 class="font-bold text-base mb-2">🔒 Security Vulnerability Reporting</h4>
          <p class="text-sm text-muted mb-3">Never open a public issue for suspected security vulnerabilities. Please report any potential vulnerability responsibly via our encrypted reporting channel.</p>
          <p class="text-sm font-mono text-primary">security@krewire.com (PGP key in internal/docs/security/)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SUPPORT / SPONSORSHIP (verified channels only, Issue #9) -->
  <section class="sponsorship-section" id="sponsorship">
    <div class="section-inner">
      <div class="section-head w-full text-center flex flex-col items-center justify-center">
        <div class="sub-badge" data-i18n="sponsorship.badge">Support Krewire</div>
        <h2 data-i18n="sponsorship.title">Supporting Krewire's Long-Term Maintenance</h2>
        <p data-i18n="sponsorship.subtitle">Krewire measures success by what developers build with it, not by money raised. Support, financial or not, is how the project stays maintained: it pays for maintainer time and infrastructure so that the open-source core keeps working for everyone.</p>
      </div>

      <div class="sponsor-trust-banner support-status">
        <h3 class="support-h" data-i18n="sponsorship.status_title">Current Status: No Active Funding Channel</h3>
        <p data-i18n="sponsorship.status_desc">Krewire does not accept donations or sponsorships yet. The core repository's FUNDING.yml names a GitHub Sponsors account, but that profile is not active, so there is nothing to link to. A funding channel will appear here only after it is live and verified. There are no sponsorship tiers, perks, or published financial figures.</p>
      </div>

      <h3 class="start-dest-title" data-i18n="sponsorship.impact_title">What Support Makes Possible</h3>
      <div class="support-impact-grid">
        <div class="start-dest">
          <span class="start-dest-label" data-i18n="sponsorship.i1_title">Maintenance</span>
          <p data-i18n="sponsorship.i1_desc">Reviewing issues and pull requests, and keeping the Go packages and the kiw CLI working across releases.</p>
        </div>
        <div class="start-dest">
          <span class="start-dest-label" data-i18n="sponsorship.i2_title">Documentation</span>
          <p data-i18n="sponsorship.i2_desc">Keeping the guides on krewire.com accurate and in step with the code, in English and Indonesian.</p>
        </div>
        <div class="start-dest">
          <span class="start-dest-label" data-i18n="sponsorship.i3_title">Security</span>
          <p data-i18n="sponsorship.i3_desc">Triaging vulnerability reports and keeping dependencies and secure defaults up to date.</p>
        </div>
        <div class="start-dest">
          <span class="start-dest-label" data-i18n="sponsorship.i4_title">Community</span>
          <p data-i18n="sponsorship.i4_desc">Onboarding new contributors and answering questions from people building with Krewire.</p>
        </div>
      </div>

      <div class="support-ways-grid">
        <div class="sponsor-channel-card">
          <span class="channel-badge community" data-i18n="sponsorship.help_badge">Available Today</span>
          <h3 class="channel-title" data-i18n="sponsorship.help_title">How to Help Right Now</h3>
          <ul class="channel-perks">
            <li><a href="https://github.com/krewire/krewire/issues" target="_blank" rel="noopener" data-i18n="sponsorship.help1">Use Krewire and report what breaks ↗</a></li>
            <li><a href="https://github.com/krewire/krewire.com/issues" target="_blank" rel="noopener" data-i18n="sponsorship.help2">Point out unclear or outdated documentation ↗</a></li>
            <li><a href="#guide" data-i18n="sponsorship.help3">Contribute code, tests, or translations</a></li>
            <li><a href="https://github.com/krewire/krewire.com/discussions" target="_blank" rel="noopener" data-i18n="sponsorship.help4">Answer questions and share what you built ↗</a></li>
          </ul>
        </div>
        <div class="sponsor-channel-card">
          <span class="channel-badge corporate" data-i18n="sponsorship.org_badge">Organizations</span>
          <h3 class="channel-title" data-i18n="sponsorship.org_title">Supporting Krewire as an Organization</h3>
          <p class="channel-desc" data-i18n="sponsorship.org_desc">If your organization wants to support Krewire with funding, infrastructure, or engineering time, start a conversation in GitHub Discussions, or use the contact listed on the Krewire GitHub organization profile.</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://github.com/krewire/krewire.com/discussions" target="_blank" rel="noopener" class="btn btn-primary btn-sm" data-i18n="sponsorship.org_cta1">Start a Discussion ↗</a>
            <a href="https://github.com/krewire" target="_blank" rel="noopener" class="btn btn-outline btn-sm" data-i18n="sponsorship.org_cta2">Organization Profile ↗</a>
          </div>
        </div>
      </div>

      <p class="private-repos-note" data-i18n-html="sponsorship.review_html">Last reviewed: November 2026. Funding configuration source: <a href="https://github.com/krewire/krewire/blob/main/.github/FUNDING.yml" target="_blank" rel="noopener">.github/FUNDING.yml in krewire/krewire</a>.</p>
    </div>
  </section>

  <!-- COMMUNITY & SUPPORT CHANNELS (verified destinations only, Issue #8) -->
  <section class="events-section" id="events">
    <div class="section-inner">
      <div class="section-head w-full text-center flex flex-col items-center justify-center">
        <div class="sub-badge" data-i18n="community.badge">Community &amp; Support Channels</div>
        <h2 data-i18n="community.title">Where to Ask, Report, and Share</h2>
        <p data-i18n="community.subtitle">Use the public GitHub channels below. They are the places maintainers read today.</p>
      </div>

      <div class="chat-hubs-grid mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="https://github.com/krewire/krewire.com/discussions" target="_blank" rel="noopener" class="chat-card p-5 border rounded-xl bg-surface text-center hover:border-primary transition">
          <div class="text-3xl mb-2">💬</div>
          <h4 class="font-bold" data-i18n="community.c1_title">GitHub Discussions</h4>
          <p class="text-xs text-muted mt-1" data-i18n="community.c1_desc">Questions, ideas, and sharing what you built with Krewire.</p>
        </a>
        <a href="https://github.com/krewire/krewire/issues" target="_blank" rel="noopener" class="chat-card p-5 border rounded-xl bg-surface text-center hover:border-primary transition">
          <div class="text-3xl mb-2">🐞</div>
          <h4 class="font-bold" data-i18n="community.c2_title">Core Issue Tracker</h4>
          <p class="text-xs text-muted mt-1" data-i18n="community.c2_desc">Bug reports and feature requests for the Go packages and the kiw CLI.</p>
        </a>
        <a href="https://github.com/krewire/krewire.github.io/issues" target="_blank" rel="noopener" class="chat-card p-5 border rounded-xl bg-surface text-center hover:border-primary transition">
          <div class="text-3xl mb-2">🧭</div>
          <h4 class="font-bold" data-i18n="community.c3_title">Portal Issues</h4>
          <p class="text-xs text-muted mt-1" data-i18n="community.c3_desc">Broken links, outdated information, or translation problems on this site.</p>
        </a>
      </div>

      <p class="private-repos-note" data-i18n="community.note">Chat servers, meetups, and events are listed here only once they are confirmed to be active.</p>
    </div>
  </section>

  <!-- AI BOOST SYNERGY -->
  <section class="boost-section" id="boost">
    <div class="section-inner">
      <div class="boost-card">
        <div class="boost-grid">
          <div class="boost-info">
            <div class="sub-badge" data-i18n="boost.badge">Human + AI Synergy</div>
            <h2 data-i18n="boost.title">Collaborating with AI Boost</h2>
            <p class="boost-lead" data-i18n="boost.lead">Krewire pioneers the collaboration between human maintainers and autonomous AI agents. Our AI Boost framework operates with strict verification standards:</p>
            <ul class="boost-items">
              <li data-i18n-html="boost.item1_html"><b>Automated Architecture Audits:</b> AI agents check PRs against <code>KWF-*</code> specifications.</li>
              <li data-i18n-html="boost.item2_html"><b>Continuous Regression Hunting:</b> Agents synthesize edge cases and race condition checks.</li>
              <li data-i18n-html="boost.item3_html"><b>Transparent Pair Programming:</b> AI agents explain architectural decisions openly in discussions and PR comments.</li>
              <li data-i18n-html="boost.item4_html"><b>Human Governance:</b> Ultimate merging authority always remains in the hands of human collective maintainers.</li>
            </ul>
            <div class="boost-ctas flex flex-wrap gap-3">
              <a href="https://github.com/krewire/krewire/tree/main/templates/boost" target="_blank" rel="noopener" class="btn btn-primary" data-i18n="boost.cta_repo">Explore AI Boost in Krewire →</a>
              <a href="https://github.com/krewire/krewire.com/discussions" target="_blank" rel="noopener" class="btn btn-outline" data-i18n="boost.cta_disc">Join Discussions</a>
            </div>
          </div>
          <div class="boost-triad">
            <div class="boost-box">
              <div class="boost-box-head">
                <span class="triad-icon">◈</span>
                <strong data-i18n="boost.triad_title">AI Boost Agent Triad</strong>
              </div>
              <div class="triad-roles">
                <div class="triad-role">
                  <div class="role-badge planner">Planner</div>
                  <strong data-i18n="boost.planner_title">Requirements &amp; SDD</strong>
                  <p data-i18n="boost.planner_desc">Translates feature ideas into formal specs and architectural blueprints.</p>
                </div>
                <div class="triad-role">
                  <div class="role-badge builder">Builder</div>
                  <strong data-i18n="boost.builder_title">Implementation &amp; Refactoring</strong>
                  <p data-i18n="boost.builder_desc">Generates clean Go implementations adhering to idiomatic patterns.</p>
                </div>
                <div class="triad-role">
                  <div class="role-badge auditor">Auditor</div>
                  <strong data-i18n="boost.auditor_title">Verification &amp; Quality Gates</strong>
                  <p data-i18n="boost.auditor_desc">Validates concurrency, zero data races, and performance benchmarks.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CALL TO ACTION -->
  <section class="final-cta" id="cta">
    <div class="section-inner">
      <div class="cta-card">
        <div class="sub-badge" data-i18n="cta.badge">Join the Collective</div>
        <h2 data-i18n="cta.title">Ready to Shape the Future of Indonesian Tech?</h2>
        <p class="cta-lead" data-i18n="cta.lead">Whether you are building your first project, writing your first Go pull request, or helping others get started, you are laying the foundation for open-source self-reliance.</p>
        <div class="ctas flex flex-wrap gap-3 justify-center">
          <a href="https://github.com/krewire/krewire/issues" target="_blank" rel="noopener" class="btn btn-primary btn-lg" data-i18n="cta.github">Explore Open Issues on GitHub →</a>
          <a href="#sponsorship" class="btn btn-secondary btn-lg" data-i18n="cta.sponsor">Ways to Support</a>
        </div>
        <div class="cta-meta" data-i18n="cta.meta">Proudly open source · MIT Licensed · Engineered with passion in Indonesia</div>
      </div>
    </div>
  </section>

</div>

<style>
/* ==========================================================================
   KREWIRE COMMUNITY PORTAL STYLING
   Neo-brutalist, accessible, responsive
   ========================================================================== */

/* 1. HERO SECTION */
.hero {
  padding: 38px 0 28px;
  background: var(--bg);
  position: relative;
}
.hero-inner {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 16px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
}
.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--primary-content);
  background: var(--primary);
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  padding: 3px 9px;
  border-radius: 6px;
  width: fit-content;
}
.hero h1 {
  font-size: clamp(26px, 5vw, 44px);
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin: 0;
  color: var(--fg);
}
.hero .lead {
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--muted);
  margin: 0;
  max-width: 580px;
}
.hero .meta {
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* TERMINAL CARD */
.code-terminal-card {
  background: #0B1F3B;
  border: 2.5px solid var(--border);
  box-shadow: var(--pop-shadow);
  border-radius: 12px;
  overflow: hidden;
  color: #FAF8F4;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12.5px;
}
:root[data-theme="dark"] .code-terminal-card {
  border-color: #FAF8F4;
  box-shadow: 4px 4px 0px var(--primary);
}
.code-terminal-bar {
  background: #112646;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 2px solid rgba(250, 248, 244, 0.12);
}
.terminal-dots {
  display: flex;
  gap: 6px;
}
.term-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}
.term-dot.red { background: #FF3B2E; }
.term-dot.yellow { background: #ffb703; }
.term-dot.green { background: #39D353; }
.term-title {
  font-size: 11px;
  font-weight: 700;
  color: #9ab0ce;
}
.code-terminal-body {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  line-height: 1.5;
}
.term-line {
  word-break: break-all;
}
.term-prompt {
  color: #39D353;
  font-weight: 800;
  margin-right: 6px;
}
.term-cmd {
  color: #FAF8F4;
  font-weight: 700;
}
.term-info {
  color: #00D1C1;
  font-size: 11.5px;
}
.term-success {
  color: #39D353;
  font-size: 11.5px;
  font-weight: 700;
}
.term-muted {
  color: #8fa2bc;
  font-size: 11px;
}

/* 2. TRUST BAR */
.trust {
  border-top: var(--pop-border);
  border-bottom: var(--pop-border);
  background: var(--bg-2);
  padding: 12px 16px;
}
.trust-inner {
  max-width: 80rem;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-size: 12.5px;
  font-weight: 700;
}
.trust-label {
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: 11px;
  color: var(--muted);
}
.trust-items {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.trust-item b {
  color: var(--primary-content);
  background: var(--primary);
  padding: 1px 6px;
  border-radius: 4px;
}
:root[data-theme="dark"] .trust-item b {
  color: #0B1F3B;
  background: var(--primary);
}
.dot {
  color: var(--muted);
  opacity: 0.6;
}

/* SECTION COMMONS */
.section-inner {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 16px;
}
.section-head {
  text-align: center;
  margin-bottom: 28px;
}
.sub-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  background: var(--secondary);
  color: var(--secondary-content);
  padding: 3px 9px;
  border-radius: 6px;
  border: 1.5px solid var(--border);
  box-shadow: 1.5px 1.5px 0px var(--border);
  margin-bottom: 10px;
}
.section-head h2 {
  font-size: clamp(22px, 3.5vw, 32px);
  font-weight: 900;
  letter-spacing: -0.025em;
  margin: 0 0 8px;
}
.section-head p {
  font-size: 14.5px;
  color: var(--muted);
  max-width: 680px;
  margin: 0 auto;
}

/* 3. CONTRIBUTOR PRIVILEGES (BENEFITS) */
.benefits {
  padding: 42px 0 28px;
}
.benefit-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.benefit-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.benefit-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.benefit-card.highlight-card {
  background: var(--bg-2);
  border-color: var(--primary);
}
:root[data-theme="dark"] .benefit-card.highlight-card {
  border-color: var(--primary);
  box-shadow: 4px 4px 0px var(--primary);
}
.benefit-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  background: var(--primary);
  color: var(--primary-content);
  padding: 2px 7px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
  width: fit-content;
}
.benefit-card h3 {
  font-size: 17px;
  font-weight: 800;
  margin: 0;
}
.benefit-card p {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.benefit-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}
.benefit-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.benefit-list li::before {
  content: "✓";
  color: var(--primary);
  font-weight: 900;
}
.meritocracy-callout {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow-sm);
  border-radius: var(--radius);
  padding: 16px 20px;
}
.meritocracy-inner {
  display: flex;
  align-items: center;
  gap: 16px;
}
.meritocracy-icon {
  font-size: 26px;
  flex-shrink: 0;
}
.meritocracy-body strong {
  display: block;
  font-size: 14.5px;
  margin-bottom: 3px;
}
.meritocracy-body p {
  font-size: 13px;
  color: var(--muted);
  margin: 0;
  line-height: 1.5;
}

/* 4. CODEBASE MATRIX & REPOSITORIES */
.repos-nav {
  padding: 42px 0 28px;
}
.fast-setup-box {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 18px 20px;
}
.fast-setup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.fast-setup-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 900;
}
.fast-setup-badge {
  font-size: 10.5px;
  font-weight: 800;
  background: var(--primary);
  color: var(--primary-content);
  padding: 2px 7px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
}
.fast-setup-desc {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0 0 12px;
}
.terminal-cmd-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #0B1F3B;
  color: #FAF8F4;
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 8px 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12.5px;
}
.terminal-cmd-bar code {
  overflow-x: auto;
  white-space: nowrap;
}
.btn-copy {
  background: var(--primary);
  color: var(--primary-content);
  border: 1.5px solid #0B1F3B;
  box-shadow: 1.5px 1.5px 0px #0B1F3B;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 11.5px;
  font-weight: 800;
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.12s ease;
}
.btn-copy:hover {
  transform: translate(-1px, -1px);
  box-shadow: 2.5px 2.5px 0px #0B1F3B;
}
.btn-copy.copied {
  background: var(--secondary);
}
.fast-setup-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--muted);
  font-weight: 700;
  margin-top: 10px;
  flex-wrap: wrap;
}

/* FILTERS */
.nav-filters {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.filter-label {
  font-size: 12.5px;
  font-weight: 800;
  color: var(--muted);
}
.filter-pills {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.filter-pill {
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  background: var(--bg);
  color: var(--fg);
  font-size: 12px;
  font-weight: 800;
  padding: 5px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.12s ease;
}
.filter-pill:hover {
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0px var(--border);
  background: var(--bg-2);
}
.filter-pill.is-active {
  background: var(--primary);
  color: var(--primary-content);
}

/* REPOSITORIES GRID */
.repo-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.repo-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.repo-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.repo-meta-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.repo-tag {
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
}
.repo-tag.core { background: var(--primary); color: var(--primary-content); }
.repo-tag.tool { background: var(--secondary); color: var(--secondary-content); }
.repo-tag.site { background: var(--accent); color: #fff; }
.repo-tag.docs { background: #ffb703; color: #0B1F3B; }
.repo-lang {
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
}
.repo-title {
  font-size: 18px;
  font-weight: 900;
  margin: 0;
}
.repo-title a:hover {
  color: var(--primary);
}
.repo-track-name {
  font-size: 12.5px;
  font-weight: 800;
  color: var(--muted);
}
.repo-match {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.55;
  margin: 0;
}
.repo-pkgs {
  margin-top: 8px;
}
.pkgs-label {
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
  display: block;
  margin-bottom: 5px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.pkgs-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}
.pkg-chip {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 11px;
  font-weight: 700;
  background: var(--bg-2);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 5px;
}
.repo-footer {
  display: flex;
  gap: 10px;
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px dashed var(--border-subtle);
}
.repo-action {
  font-size: 12px;
  font-weight: 800;
  padding: 5px 11px;
  border-radius: 6px;
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  transition: all 0.12s ease;
  display: inline-flex;
  align-items: center;
}
.repo-action.primary {
  background: var(--primary);
  color: var(--primary-content);
}
.repo-action.secondary {
  background: var(--bg);
  color: var(--fg);
}
.repo-action:hover {
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0px var(--border);
}

/* 5. ONBOARDING QUICKSTART & QUALITY GATES */
.onboarding,
.standards {
  padding: 42px 0 28px;
}
.quickstart-steps,
.gates-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.qs-card,
.gate-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.qs-card:hover,
.gate-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.qs-num {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--primary);
  color: var(--primary-content);
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 900;
}
.qs-card h3,
.gate-card h3 {
  font-size: 16px;
  font-weight: 800;
  margin: 0;
}
.qs-card p,
.gate-card p {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.qs-card pre {
  background: #0B1F3B;
  color: #FAF8F4;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  overflow-x: auto;
  margin: 4px 0 0;
}
.tag-issue {
  background: var(--secondary);
  color: var(--secondary-content);
  padding: 1px 6px;
  border-radius: 4px;
  font-weight: 800;
  font-size: 11px;
}
.gate-icon {
  font-size: 24px;
}
.gate-req {
  font-size: 11.5px;
  font-weight: 800;
  background: var(--bg-2);
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid var(--border);
  margin-top: auto;
}

/* 6. SPONSORSHIP CHANNELS */
.sponsorship-section {
  padding: 42px 0 28px;
  background: var(--bg);
}
.sponsor-channels-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
.sponsor-channel-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.sponsor-channel-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.sponsor-channel-card.highlight-card {
  background: var(--bg-2);
  border-color: var(--secondary);
  box-shadow: 4px 4px 0px var(--secondary);
}
.sponsor-card-top {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.channel-badge {
  font-size: 11px;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
  width: fit-content;
  display: inline-block;
}
.channel-badge.community { background: var(--primary); color: var(--primary-content); }
.channel-badge.corporate { background: var(--secondary); color: var(--secondary-content); }
.channel-title {
  font-size: 22px;
  font-weight: 900;
  margin: 0;
  letter-spacing: -0.02em;
}
.channel-desc {
  font-size: 14px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.channel-perks {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 13.5px;
  font-weight: 600;
}
.channel-perks li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  line-height: 1.45;
}
.channel-perks li::before {
  content: "◈";
  color: var(--primary);
  font-weight: 900;
}
.channel-footer {
  margin-top: auto;
  padding-top: 16px;
}
.sponsor-trust-banner {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 24px;
}
.sponsor-trust-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.trust-content p {
  margin: 0;
  line-height: 1.5;
}
  line-height: 1.55;
}

/* 7. AI BOOST SYNERGY */
.boost-section {
  padding: 38px 0 28px;
}
.boost-card {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: 16px;
  padding: 24px 20px;
}
.boost-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
.boost-info h2 {
  font-size: clamp(22px, 3.5vw, 30px);
  font-weight: 900;
  margin: 6px 0 10px;
}
.boost-lead {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.6;
  margin: 0 0 16px;
}
.boost-items {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 13.5px;
  line-height: 1.5;
}
.boost-items li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.boost-items li::before {
  content: "◈";
  color: var(--primary);
  font-weight: 900;
}
.boost-box {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow-sm);
  border-radius: var(--radius);
  padding: 18px 16px;
}
.boost-box-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14.5px;
  font-weight: 900;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1.5px dashed var(--border-subtle);
}
.triad-roles {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.triad-role {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.role-badge {
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 4px;
  border: 1px solid var(--border);
  width: fit-content;
}
.role-badge.planner { background: var(--secondary); color: var(--secondary-content); }
.role-badge.builder { background: var(--primary); color: var(--primary-content); }
.role-badge.auditor { background: var(--accent); color: #fff; }
.triad-role strong {
  font-size: 13.5px;
}
.triad-role p {
  font-size: 12px;
  color: var(--muted);
  margin: 0;
  line-height: 1.45;
}

/* 8. FINAL CTA */
.final-cta {
  padding: 28px 0 52px;
}
.cta-card {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow-lg);
  border-radius: 18px;
  padding: 32px 20px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}
.cta-card h2 {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 900;
  margin: 0;
  max-width: 650px;
}
.cta-lead {
  font-size: 14.5px;
  color: var(--muted);
  max-width: 580px;
  margin: 0;
  line-height: 1.6;
}
.cta-meta {
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
  margin-top: 6px;
}

.private-repos-note {
  font-size: 13px;
  color: var(--muted);
  text-align: center;
  max-width: 720px;
  margin: 20px auto 0;
  line-height: 1.55;
}

.events-section {
  padding: 42px 0 36px;
}
.chat-hubs-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
@media (min-width: 768px) {
  .chat-hubs-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.support-status {
  margin-bottom: 8px;
}
.support-h {
  font-size: 16px;
  font-weight: 900;
  margin: 0 0 6px;
}
.support-status p {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.support-impact-grid,
.support-ways-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
.support-ways-grid {
  gap: 20px;
  margin-top: 24px;
}
.channel-perks a {
  color: inherit;
  text-decoration: none;
}
.channel-perks a:hover {
  color: var(--primary);
  text-decoration: underline;
}
@media (min-width: 640px) {
  .support-impact-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .support-ways-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (min-width: 1024px) {
  .support-impact-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

/* START HERE (canonical onboarding path) */
.start-section {
  padding: 42px 0 28px;
}
.start-steps {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.start-link {
  margin-top: auto;
  font-size: 13px;
  font-weight: 800;
  color: var(--primary);
  text-decoration: none;
}
.start-link:hover {
  text-decoration: underline;
}
.start-dest-title {
  font-size: 18px;
  font-weight: 900;
  text-align: center;
  margin: 32px 0 16px;
}
.start-dest-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}
.start-dest {
  background: var(--bg-2);
  border: var(--pop-border-thin);
  border-radius: var(--radius);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.start-dest-label {
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.start-dest p {
  font-size: 13px;
  color: var(--muted);
  margin: 0;
  line-height: 1.5;
}

/* ==========================================================================
   RESPONSIVE BREAKPOINTS (SM: 640px+, MD: 768px+, LG: 1024px+)
   ========================================================================== */
@media (min-width: 640px) {
  .start-steps,
  .start-dest-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .hero-inner {
    padding: 0 24px;
  }
  .section-inner {
    padding: 0 24px;
  }
  .benefit-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .benefit-card:nth-child(3) {
    grid-column: span 2;
  }
  .repo-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .repo-card.featured {
    grid-column: span 2;
  }
  .quickstart-steps {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gates-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .sponsor-channels-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 768px) {
  .hero {
    padding: 48px 0 32px;
  }
  .benefit-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .benefit-card:nth-child(3) {
    grid-column: auto;
  }
  .sponsor-trust-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

@media (min-width: 1024px) {
  .hero {
    padding: 56px 0 42px;
  }
  .hero-inner {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 48px;
    padding: 0 32px;
  }
  .section-inner {
    padding: 0 32px;
  }
  .repo-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .repo-card.featured {
    grid-column: span 2;
  }
  .quickstart-steps {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .start-steps {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .start-dest-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .boost-grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 36px;
  }
  .cta-card {
    padding: 48px 32px;
  }
}
</style>

<script>
const pathways = {
  newbie: {
    title: "🌱 New to Go? (Beginner Friendly)",
    desc: "Start by polishing documentation in krewire.com, writing unit tests for krewire/pkg/model, or fixing starter bugs labeled good first issue.",
    url: "https://github.com/krewire/krewire/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22"
  },
  backend: {
    title: "⚙️ Backend Engineer",
    desc: "Contribute to core packages (pkg/model, pkg/web, pkg/resilience, pkg/cloud), or build autonomous agent tools in krewire/krew.",
    url: "https://github.com/krewire/krewire/issues"
  },
  frontend: {
    title: "🎨 Frontend & UI Engineer",
    desc: "Help design components with the .kiw DSL in krewire/ui, or improve layouts and interactive docs on krewire.com.",
    url: "https://github.com/krewire/ui/issues"
  },
  devops: {
    title: "☁️ DevOps & Infrastructure Engineer",
    desc: "Improve deploy targets and runners in pkg/cloud, the HTTP gateway in pkg/web/gateway, or the kiw build and release tooling in the core repository.",
    url: "https://github.com/krewire/krewire/issues"
  }
};

function selectPathway(track) {
  const p = pathways[track];
  if (!p) return;
  document.getElementById('pathwayTitle').innerText = p.title;
  document.getElementById('pathwayDesc').innerText = p.desc;
  const cta = document.getElementById('pathwayCta');
  if (cta) cta.href = p.url;
  document.querySelectorAll('.pathway-tab').forEach(btn => {
    const isTarget = btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(track);
    btn.classList.toggle('active', isTarget);
    btn.classList.toggle('btn-primary', isTarget);
    btn.classList.toggle('btn-outline', !isTarget);
  });
}
</script>
