  <!-- CONTRIBUTION PATHWAYS -->
  <section class="pathways" id="pathways">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge" data-i18n="pathways.badge">Choose Your Track</div>
        <h2 data-i18n="pathways.title">Contribution Pathways</h2>
        <p data-i18n="pathways.subtitle">Whether you are a Go systems programmer, an architect, a documentation writer, or an AI prompt engineer — there is a high-impact seat for you.</p>
      </div>
      <div class="pathway-grid">
        <div class="pathway-card">
          <div class="pathway-num">01</div>
          <h3 data-i18n="pathways.p1_title">Core Go Engineering</h3>
          <p data-i18n="pathways.p1_desc">Work on the foundational engine: HTTP routing, concurrent runner coordination, worker queues, and memory allocations.</p>
          <div class="pathway-tags">
            <span>Concurrency</span>
            <span>net/http</span>
            <span>Profiling</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">02</div>
          <h3 data-i18n="pathways.p2_title">Architecture & SDD</h3>
          <p data-i18n="pathways.p2_desc">Draft Spec-Driven Development proposals (<code>KWF-*</code>), formalize module contracts, design clean interfaces, and review architectural integrity.</p>
          <div class="pathway-tags">
            <span>KWF Specs</span>
            <span>Interface Design</span>
            <span>RFCs</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">03</div>
          <h3 data-i18n="pathways.p3_title">AI Agent Engineering</h3>
          <p data-i18n="pathways.p3_desc">Develop autonomous skills for the Guild, build MCP tools, and optimize subagent triads that autonomously test and refactor code.</p>
          <div class="pathway-tags">
            <span>AI Guild</span>
            <span>MCP Tools</span>
            <span>Autonomous Swarm</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">04</div>
          <h3 data-i18n="pathways.p4_title">Developer Experience & CLI</h3>
          <p data-i18n="pathways.p4_desc">Make <code>kiw</code> lightning fast and delightfully intuitive. Improve terminal UX, scaffolding generators, and developer productivity.</p>
          <div class="pathway-tags">
            <span>CLI Ergonomics</span>
            <span>TUI</span>
            <span>Hot-Reload</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">05</div>
          <h3 data-i18n="pathways.p5_title">Testing & Quality Assurance</h3>
          <p data-i18n="pathways.p5_desc">Hunt race conditions, write fuzz tests, build chaos experiments for concurrent workers, and ensure 100% test reliability.</p>
          <div class="pathway-tags">
            <span>Fuzz Testing</span>
            <span>Race Detection</span>
            <span>Stress Tests</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">06</div>
          <h3 data-i18n="pathways.p6_title">Technical Writing & Docs</h3>
          <p data-i18n="pathways.p6_desc">Create architectural deep dives, tutorials, quickstart guides, and help translate Krewire documentation for global and Indonesian engineers.</p>
          <div class="pathway-tags">
            <span>Technical Docs</span>
            <span>Guides</span>
            <span>Community</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STANDARDS & QUALITY GATES -->
  <section class="standards" id="standards">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge" data-i18n="standards.badge">Quality Assurance</div>
        <h2 data-i18n="standards.title">The Krewire Way: 3 Quality Gates</h2>
        <p data-i18n="standards.subtitle">To keep the codebase reliable, predictable, and production-ready, every pull request passes through three automated gates.</p>
      </div>
      <div class="gates-grid">
        <div class="gate-card">
          <div class="gate-icon">1</div>
          <h3 data-i18n="standards.gate1_title">Gate 1: Format & Lint</h3>
          <p data-i18n="standards.gate1_desc">Zero lint errors and idiomatic Go formatting. Code must adhere strictly to Go standard conventions.</p>
          <pre class="gate-cmd"><code>go fmt -s ./...
go vet ./...</code></pre>
          <div class="gate-status" data-i18n="standards.gate1_req">Required: Clean exit, 0 warnings</div>
        </div>
        <div class="gate-card">
          <div class="gate-icon">2</div>
          <h3 data-i18n="standards.gate2_title">Gate 2: Race & Tests</h3>
          <p data-i18n="standards.gate2_desc">Every commit is verified with race condition detection and comprehensive unit & integration tests.</p>
          <pre class="gate-cmd"><code>go test -race -cover ./...
kiw build</code></pre>
          <div class="gate-status" data-i18n="standards.gate2_req">Required: 100% test pass, 0 data races</div>
        </div>
        <div class="gate-card">
          <div class="gate-icon">3</div>
          <h3 data-i18n="standards.gate3_title">Gate 3: Spec & Commits</h3>
          <p data-i18n="standards.gate3_desc">Changes must link to a valid Spec or Issue, following Conventional Commits format.</p>
          <pre class="gate-cmd"><code>feat(runner): implement parallel workloads
fix(web): recover panic in http handler</code></pre>
          <div class="gate-status" data-i18n="standards.gate3_req">Required: Semantic versioning compliance</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5-STEP ONBOARDING -->
  <section class="onboarding" id="get-started">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge" data-i18n="onboarding.badge">Getting Started</div>
        <h2 data-i18n="onboarding.title">Start Contributing in 5 Steps</h2>
        <p data-i18n="onboarding.subtitle">From zero to your first merged pull request. Here is how to get your development environment running in minutes.</p>
      </div>
      <div class="steps-flow">
        <div class="flow-step">
          <div class="flow-badge">1</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s1_title">Fork & Clone the Repositories</h4>
            <p data-i18n="onboarding.s1_desc">Fork any Krewire repository to your personal GitHub account, then clone it locally:</p>
            <pre><code>git clone https://github.com/&lt;your-username&gt;/framework.git
cd framework</code></pre>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">2</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s2_title">Initialize Multi-Module Workspace</h4>
            <p data-i18n="onboarding.s2_desc">If you're working across multiple Krewire repos, sync your local Go workspace seamlessly:</p>
            <pre><code>go work init ./
go work use ./
go work sync</code></pre>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">3</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s3_title">Pick an Open Issue</h4>
            <p data-i18n-html="onboarding.s3_desc_html">Browse our curated issues list tagged with <span class="tag-issue">good-first-issue</span> or <span class="tag-issue">help-wanted</span>. Comment on the issue to let the community know you're working on it.</p>
            <a class="btn-subtle" href="https://github.com/krewire/framework/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" target="_blank" rel="noopener" data-i18n="onboarding.s3_btn">View Good First Issues →</a>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">4</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s4_title">Implement & Verify Locally</h4>
            <p data-i18n="onboarding.s4_desc">Write clean code and corresponding tests. Verify that all 3 Quality Gates pass with zero failures:</p>
            <pre><code>go test -race ./...
# For website changes:
kiw build</code></pre>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">5</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s5_title">Submit Pull Request & Collaborate</h4>
            <p data-i18n="onboarding.s5_desc">Open a Pull Request with Conventional Commits. The maintainers and the AI Guild will review, provide fast feedback, and guide you to merge.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI BOOST COLLABORATION -->
  <section class="guild-section" id="boost">
    <span id="guild" class="section-anchor"></span>
    <div class="section-inner">
      <div class="guild-card">
        <div class="guild-grid">
          <div class="guild-info">
            <div class="sub-badge" data-i18n="guild.badge">Human + AI Synergy</div>
            <h2 data-i18n="guild.title">Collaborating with AI Boost</h2>
            <p data-i18n="guild.lead">Krewire pioneers the collaboration between human maintainers and autonomous AI agents. Our AI Boost framework operates with strict verification standards:</p>
            <ul class="guild-list">
              <li data-i18n-html="guild.item1_html"><b>Automated Architecture Audits:</b> AI agents check PRs against <code>KWF-*</code> specifications.</li>
              <li data-i18n-html="guild.item2_html"><b>Continuous Regression Hunting:</b> Agents synthesize edge cases and race condition checks.</li>
              <li data-i18n-html="guild.item3_html"><b>Transparent Pair Programming:</b> AI agents explain architectural decisions openly in discussions and PR comments.</li>
              <li data-i18n-html="guild.item4_html"><b>Human Governance:</b> Ultimate merging authority always remains in the hands of human collective maintainers.</li>
            </ul>
            <div class="ctas">
              <a class="btn primary" href="https://github.com/krewire/boost" target="_blank" rel="noopener" data-i18n="guild.cta_repo">Explore AI Boost Repo →</a>
              <a class="btn" href="https://github.com/orgs/krewire/discussions" target="_blank" rel="noopener" data-i18n="guild.cta_disc">Join Discussions</a>
            </div>
          </div>
          <div class="guild-box">
            <div class="guild-box-head" data-i18n="guild.triad_title">AI Boost Agent Triad</div>
            <div class="agent-item">
              <span class="agent-role planner">Planner</span>
              <div>
                <strong data-i18n="guild.planner_title">Requirements & SDD</strong>
                <p data-i18n="guild.planner_desc">Translates feature ideas into formal specs and architectural blueprints.</p>
              </div>
            </div>
            <div class="agent-item">
              <span class="agent-role builder">Builder</span>
              <div>
                <strong data-i18n="guild.builder_title">Implementation & Refactoring</strong>
                <p data-i18n="guild.builder_desc">Generates clean Go implementations adhering to idiomatic patterns.</p>
              </div>
            </div>
            <div class="agent-item">
              <span class="agent-role auditor">Auditor</span>
              <div>
                <strong data-i18n="guild.auditor_title">Verification & Quality Gates</strong>
                <p data-i18n="guild.auditor_desc">Validates concurrency, zero data races, and performance benchmarks.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CALLOUT -->
  <section class="final-cta">
    <div class="cta-card">
      <div class="sub-badge" data-i18n="cta.badge">Join the Collective</div>
      <h2 data-i18n="cta.title">Ready to shape the future of Go?</h2>
      <p data-i18n="cta.lead">Become part of an open source community building fast, sustainable, and autonomous Go software. Every contribution, idea, and PR makes a difference.</p>
      <div class="ctas">
        <a class="btn primary large" href="https://github.com/krewire" target="_blank" rel="noopener" data-i18n="cta.github">Join on GitHub →</a>
        <a class="btn large" href="#get-started" data-i18n="cta.quickstart">Read Quickstart</a>
      </div>
      <div class="cta-meta" data-i18n="cta.meta">Proudly open source · MIT Licensed · Engineered with passion in Indonesia</div>
    </div>
  </section>

</div>

<style>
/* ==========================================================================
   MOBILE-FIRST BASE (Phones: 320px - 639px)
   ========================================================================== */

.contributors-portal{
  width:100%;
  min-width:0;
  overflow-x:hidden;
}
.contributors-portal *{
  box-sizing:border-box;
}
.contributors-portal pre{
  max-width:100%;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}

/* SECTION COMMON */
.section-inner{
  width:100%;
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  min-width:0;
}
.section-head{
  margin:0 0 22px;
}
.sub-badge{
  display:inline-block;
  font-size:10.5px;
  font-weight:700;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--primary);
  background:color-mix(in srgb, var(--primary) 12%, transparent);
  padding:3px 9px;
  border-radius:999px;
  margin-bottom:10px;
}
.section-head h2{
  font-size:clamp(22px, 6vw, 32px);
  letter-spacing:-.03em;
  margin:0 0 8px;
  line-height:1.2;
  word-break:break-word;
}
.section-head p{
  color:var(--muted);
  margin:0;
  font-size:13.5px;
  line-height:1.6;
  word-break:break-word;
}

/* CARDS COMMON DEFAULTS (1-COLUMN ON MOBILE) */
.pillar-card,
.benefit-card,
.repo-card,
.pathway-card,
.gate-card{
  min-width:0;
  width:100%;
  word-break:break-word;
  border:1px solid var(--border);
  border-radius:14px;
  padding:18px 14px;
  background:var(--bg);
}
.pillar-grid,
.benefit-grid,
.repo-grid,
.pathway-grid,
.gates-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:12px;
}

/* HERO (MOBILE-FIRST) */
.hero{
  padding:26px 0 20px;
  background:linear-gradient(180deg, color-mix(in srgb, var(--bg-2) 75%, var(--bg)), var(--bg));
  width:100%;
}
.hero-inner{
  width:100%;
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  display:flex;
  flex-direction:column;
  gap:22px;
}
.hero-copy{
  min-width:0;
  width:100%;
}
.eyebrow{
  font-size:11px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--primary);
  font-weight:700;
  margin-bottom:10px;
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
  line-height:1.4;
}
.hero h1{
  font-family:ui-serif, Georgia, serif;
  font-size:clamp(27px, 7.8vw, 50px);
  line-height:1.1;
  letter-spacing:-.04em;
  margin:0 0 12px;
  word-break:break-word;
}
.hero .lead{
  font-size:14px;
  color:color-mix(in srgb, var(--fg) 75%, var(--muted));
  line-height:1.65;
  margin:0;
  word-break:break-word;
}
.hero .lead code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  background:var(--bg-2);
  border:1px solid var(--border);
  padding:2px 5px;
  border-radius:5px;
  word-break:break-word;
}
.hero .ctas{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-top:18px;
  width:100%;
}
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:12px 20px;
  border-radius:999px;
  border:1px solid var(--border);
  background:var(--bg);
  font-weight:600;
  font-size:14px;
  transition:all .18s ease;
  cursor:pointer;
  min-height:46px;
  width:100%;
  text-align:center;
}
.btn:hover{
  border-color:var(--fg);
  color:var(--fg);
}
.btn.primary{
  background:var(--primary);
  color:var(--primary-content);
  border-color:var(--primary);
}
.btn.primary:hover{
  filter:brightness(1.08);
  color:var(--primary-content);
}
.btn.large{
  padding:13px 24px;
  font-size:14.5px;
}
.btn-subtle{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-size:13px;
  font-weight:600;
  color:var(--primary);
  margin-top:8px;
}
.btn-subtle:hover{
  text-decoration:underline;
}
.meta{
  margin-top:14px;
  font-size:11.5px;
  color:var(--muted);
  letter-spacing:.02em;
  line-height:1.5;
  word-break:break-word;
}
.hero-art{
  min-width:0;
  width:100%;
}

/* TRUST BAR (MOBILE-FIRST) */
.trust{
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  background:var(--bg-2);
  width:100%;
}
.trust-inner{
  max-width:80rem;
  margin:0 auto;
  padding:12px 14px;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.trust-label{
  font-size:10.5px;
  font-weight:700;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted);
}
.trust-items{
  display:flex;
  flex-wrap:wrap;
  gap:7px 12px;
  font-size:12.5px;
  color:var(--muted);
  line-height:1.4;
}
.trust-items b{
  color:var(--fg);
}
.trust-items .dot{
  display:none;
}

/* PILLARS */
.pillars{
  padding:34px 0 22px;
  width:100%;
}
.pillar-icon{
  font-size:22px;
  margin-bottom:8px;
  line-height:1;
}
.pillar-card h3{
  margin:0 0 6px;
  font-size:15.5px;
  letter-spacing:-.01em;
}
.pillar-card p{
  margin:0;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}
.pillar-card code{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  background:var(--bg-2);
  border:1px solid var(--border);
  padding:1px 4px;
  border-radius:5px;
}

/* CONTRIBUTOR BENEFITS */
.benefits{
  padding:34px 0 22px;
  background:linear-gradient(180deg, var(--bg), color-mix(in srgb, var(--bg-2) 65%, var(--bg)));
  border-bottom:1px solid var(--border);
  width:100%;
}
.benefit-card{
  position:relative;
  display:flex;
  flex-direction:column;
}
.benefit-card.highlight{
  border-color:color-mix(in srgb, var(--primary) 50%, var(--border));
  background:linear-gradient(180deg, color-mix(in srgb, var(--primary) 4%, var(--bg)), var(--bg));
}
.benefit-badge{
  display:inline-block;
  align-self:flex-start;
  font-size:10px;
  font-weight:700;
  padding:2px 7px;
  border-radius:999px;
  background:color-mix(in srgb, var(--primary) 12%, transparent);
  color:var(--primary);
  margin-bottom:10px;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.benefit-badge.req{
  background:color-mix(in srgb, var(--primary) 15%, transparent);
  color:var(--primary);
}
.benefit-badge.warn{
  background:color-mix(in srgb, var(--accent) 15%, transparent);
  color:var(--accent);
}
.benefit-icon{
  font-size:24px;
  margin-bottom:8px;
  line-height:1;
}
.benefit-card.highlight .benefit-icon{color:var(--primary)}
.benefit-card.condition .benefit-icon{color:var(--primary)}
.benefit-card.notice .benefit-icon{color:var(--accent)}
.benefit-card h3{
  margin:0 0 6px;
  font-size:16px;
  letter-spacing:-.01em;
  line-height:1.3;
}
.benefit-card p{
  margin:0 0 12px;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}
.benefit-list{
  margin:auto 0 0;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:6px;
  font-size:12px;
  color:var(--muted);
  line-height:1.5;
}
.benefit-list li::marker{color:var(--primary)}
.benefit-card.condition .benefit-list li::marker{color:var(--primary)}
.benefit-card.notice .benefit-list li::marker{color:var(--accent)}
.benefit-policy-banner{
  display:flex;
  flex-direction:column;
  gap:8px;
  padding:16px 14px;
  border-radius:12px;
  background:var(--bg-2);
  border:1px solid color-mix(in srgb, var(--primary) 25%, var(--border));
  margin-top:14px;
}
.policy-marker{
  font-size:16px;
  color:var(--primary);
  line-height:1;
}
.policy-text{
  font-size:12.5px;
  line-height:1.6;
  color:var(--muted);
  word-break:break-word;
}
.policy-text strong{
  color:var(--fg);
  display:inline;
  margin-right:4px;
}

/* CONTRIBUTOR NAVIGATION MAP */
.nav-map{
  padding:36px 0 24px;
  background:var(--bg);
  border-bottom:1px solid var(--border);
  width:100%;
}
.fast-setup-box{
  background:linear-gradient(180deg, color-mix(in srgb, var(--primary) 7%, var(--bg-2)), var(--bg-2));
  border:1px solid color-mix(in srgb, var(--primary) 35%, var(--border));
  border-radius:14px;
  padding:20px 16px;
  margin-bottom:28px;
}
.fast-setup-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:8px;
}
.fast-setup-title{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:15px;
}
.fast-icon{
  color:var(--primary);
  font-size:16px;
}
.fast-setup-badge{
  font-size:10px;
  font-weight:700;
  padding:2px 8px;
  border-radius:999px;
  background:var(--primary);
  color:var(--primary-content);
  text-transform:uppercase;
  letter-spacing:.05em;
}
.fast-setup-desc{
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
  margin:0 0 14px;
}
.terminal-cmd-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:10px;
  padding:10px 14px;
  gap:12px;
  overflow-x:auto;
}
.terminal-cmd-bar code{
  font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size:12.5px;
  color:var(--fg);
  white-space:nowrap;
}
.btn-copy{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:5px 12px;
  background:var(--bg-2);
  border:1px solid var(--border);
  border-radius:7px;
  color:var(--fg);
  font-size:12px;
  font-weight:600;
  cursor:pointer;
  transition:all .15s ease;
  flex-shrink:0;
}
.btn-copy:hover{
  border-color:var(--primary);
  color:var(--primary);
}
.btn-copy.copied{
  background:var(--primary);
  color:var(--primary-content);
  border-color:var(--primary);
}
.fast-setup-meta{
  display:flex;
  gap:10px;
  font-size:11.5px;
  color:var(--muted);
  margin-top:10px;
  flex-wrap:wrap;
}

/* FILTER BAR */
.nav-filter-bar{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-bottom:20px;
}
.filter-label{
  font-size:12px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.05em;
  color:var(--muted);
}
.filter-pills{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:4px;
  -webkit-overflow-scrolling:touch;
}
.filter-pill{
  background:var(--bg-2);
  border:1px solid var(--border);
  color:var(--muted);
  border-radius:999px;
  padding:6px 14px;
  font-size:12.5px;
  font-weight:500;
  cursor:pointer;
  white-space:nowrap;
  transition:all .15s ease;
}
.filter-pill:hover{
  color:var(--fg);
  border-color:color-mix(in srgb, var(--primary) 40%, var(--border));
}
.filter-pill.is-active{
  background:color-mix(in srgb, var(--primary) 12%, transparent);
  color:var(--primary);
  border-color:var(--primary);
  font-weight:600;
}

/* NAV MAP CARDS */
.nav-map-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
.nav-map-card{
  background:var(--bg-2);
  border:1px solid var(--border);
  border-radius:14px;
  padding:20px 16px;
  display:flex;
  flex-direction:column;
  transition:transform .15s ease, border-color .15s ease, box-shadow .15s ease;
}
.nav-map-card:hover{
  border-color:color-mix(in srgb, var(--primary) 45%, var(--border));
  transform:translateY(-2px);
}
.nav-card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:10px;
  gap:8px;
  flex-wrap:wrap;
}
.nav-track-tag{
  font-size:11px;
  font-weight:600;
  color:var(--primary);
  text-transform:uppercase;
  letter-spacing:.04em;
}
.nav-curve-badge{
  font-size:10px;
  font-weight:600;
  padding:2px 7px;
  border-radius:999px;
  border:1px solid var(--border);
}
.nav-curve-badge.gentle{
  background:color-mix(in srgb, var(--secondary) 15%, transparent);
  color:var(--secondary);
  border-color:color-mix(in srgb, var(--secondary) 35%, transparent);
}
.nav-curve-badge.intermediate{
  background:color-mix(in srgb, var(--primary) 15%, transparent);
  color:var(--primary);
  border-color:color-mix(in srgb, var(--primary) 35%, transparent);
}
.nav-curve-badge.advanced{
  background:color-mix(in srgb, var(--accent) 15%, transparent);
  color:var(--accent);
  border-color:color-mix(in srgb, var(--accent) 35%, transparent);
}
.nav-curve-badge.innovative{
  background:color-mix(in srgb, var(--primary) 20%, transparent);
  color:var(--primary);
  border-color:color-mix(in srgb, var(--primary) 40%, transparent);
}
.nav-card-title{
  font-size:18px;
  margin:0 0 8px;
  font-family:ui-monospace, monospace;
}
.nav-card-match{
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
  margin:0 0 14px;
  flex-grow:1;
}
.nav-card-match strong{
  color:var(--fg);
}
.nav-card-packages{
  margin-bottom:16px;
  font-size:12px;
}
.pkg-label{
  display:block;
  color:var(--muted);
  font-size:11px;
  margin-bottom:6px;
  font-weight:600;
}
.pkg-tags{
  display:flex;
  flex-wrap:wrap;
  gap:5px;
}
.pkg-tags code{
  font-size:11px;
  background:var(--bg);
  border:1px solid var(--border);
  padding:2px 6px;
  border-radius:4px;
}
.section-anchor{
  display:block;
  position:relative;
  top:-70px;
  visibility:hidden;
}
.repos-nav,
.nav-map{
  padding:36px 0 24px;
  background:var(--bg);
  border-bottom:1px solid var(--border);
  width:100%;
}
.repo-icon{
  color:var(--primary);
  margin-right:6px;
  display:inline-block;
}
.nav-map-card.featured{
  border-color:color-mix(in srgb, var(--primary) 40%, var(--border));
  background:linear-gradient(180deg, color-mix(in srgb, var(--primary) 4%, var(--bg-2)), var(--bg-2));
}
.nav-card-footer{
  margin-top:auto;
  padding-top:14px;
  border-top:1px solid var(--border);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
}
.nav-action-link{
  display:inline-flex;
  align-items:center;
  gap:4px;
  font-size:12.5px;
  font-weight:700;
  color:var(--primary);
  text-decoration:none;
  transition:gap .15s ease;
}
.nav-action-link:hover{
  gap:8px;
  text-decoration:underline;
}
.nav-repo-link{
  font-size:12px;
  font-weight:500;
  color:var(--muted);
  text-decoration:none;
  transition:color .15s ease;
}
.nav-repo-link:hover{
  color:var(--fg);
  text-decoration:underline;
}
.repo-card{
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.repo-card.featured{
  border-color:color-mix(in srgb, var(--primary) 40%, var(--border));
  background:linear-gradient(180deg, color-mix(in srgb, var(--primary) 3%, var(--bg)), var(--bg));
}
.repo-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:8px;
  margin-bottom:10px;
  flex-wrap:wrap;
}
.repo-name{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:0;
  flex-wrap:wrap;
}
.repo-icon{
  font-size:16px;
  color:var(--primary);
  flex-shrink:0;
}
.repo-name h3{
  margin:0;
  font-size:14.5px;
  font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing:-.01em;
  word-break:break-word;
}
.repo-name .alias{
  font-size:11.5px;
  color:var(--muted);
  font-weight:normal;
}
.repo-badge{
  font-size:10px;
  font-weight:600;
  padding:2px 7px;
  border-radius:999px;
  background:var(--bg-2);
  border:1px solid var(--border);
  color:var(--muted);
  white-space:nowrap;
}
.repo-badge.primary{
  background:var(--primary);
  color:var(--primary-content);
  border-color:var(--primary);
}
.repo-desc{
  font-size:13px;
  color:var(--muted);
  margin:0 0 12px;
  line-height:1.55;
}
.repo-desc code{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  background:var(--bg-2);
  padding:1px 4px;
  border-radius:4px;
}
.repo-details{
  display:flex;
  flex-direction:column;
  gap:7px;
  margin-bottom:14px;
  font-size:12px;
  padding-top:10px;
  border-top:1px solid var(--border);
}
.detail-item strong{
  color:var(--fg);
  display:block;
  margin-bottom:1px;
}
.detail-item span{
  color:var(--muted);
  line-height:1.5;
}
.repo-footer{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:6px;
  padding-top:10px;
  border-top:1px solid var(--border);
}
.tag{
  font-size:10.5px;
  padding:2px 6px;
  border-radius:5px;
  background:var(--bg-2);
  border:1px solid var(--border);
  color:var(--muted);
  font-family:ui-monospace, monospace;
}
.repo-link{
  margin-left:auto;
  font-size:12.5px;
  font-weight:600;
  color:var(--primary);
  padding:4px 0;
}
.repo-link:hover{
  text-decoration:underline;
}

/* PATHWAYS */
.pathways{
  padding:34px 0 22px;
  width:100%;
}
.pathway-num{
  font-size:17px;
  font-weight:800;
  color:color-mix(in srgb, var(--primary) 70%, var(--muted));
  font-family:ui-monospace, monospace;
  margin-bottom:6px;
}
.pathway-card h3{
  margin:0 0 6px;
  font-size:15.5px;
  letter-spacing:-.01em;
}
.pathway-card p{
  margin:0 0 12px;
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}
.pathway-tags{
  display:flex;
  gap:5px;
  flex-wrap:wrap;
}
.pathway-tags span{
  font-size:10.5px;
  background:var(--bg-2);
  border:1px solid var(--border);
  border-radius:5px;
  padding:2px 6px;
  color:var(--muted);
}

/* STANDARDS & GATES */
.standards{
  padding:34px 0 22px;
  background:var(--bg-2);
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  width:100%;
}
.gate-icon{
  width:28px;
  height:28px;
  border-radius:50%;
  background:var(--primary);
  color:var(--primary-content);
  display:grid;
  place-items:center;
  font-weight:800;
  font-size:13px;
  margin-bottom:10px;
}
.gate-card h3{
  margin:0 0 6px;
  font-size:15.5px;
}
.gate-card p{
  margin:0 0 10px;
  font-size:13px;
  color:var(--muted);
  line-height:1.55;
}
.gate-cmd{
  margin:0 0 10px;
  background:#0B1F3B;
  color:#FAF8F4;
  border-radius:8px;
  padding:10px 12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  max-width:100%;
}
.gate-cmd code{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  line-height:1.55;
  display:block;
  white-space:pre;
}
.gate-status{
  margin-top:auto;
  font-size:11.5px;
  font-weight:600;
  color:var(--primary);
  display:flex;
  align-items:center;
  gap:5px;
}

/* ONBOARDING FLOW (MOBILE-FIRST VERTICAL CARDS) */
.onboarding{
  padding:34px 0 22px;
  width:100%;
}
.steps-flow{
  display:flex;
  flex-direction:column;
  gap:12px;
  max-width:880px;
  margin:0 auto;
}
.flow-step{
  display:flex;
  flex-direction:column;
  gap:10px;
  border:1px solid var(--border);
  border-radius:14px;
  padding:16px 14px;
  background:var(--bg);
  min-width:0;
}
.flow-badge{
  width:28px;
  height:28px;
  flex-shrink:0;
  border-radius:8px;
  background:var(--bg-2);
  border:1px solid var(--border);
  display:grid;
  place-items:center;
  font-weight:800;
  font-size:13px;
  color:var(--fg);
}
.flow-content{
  flex:1;
  min-width:0;
  width:100%;
}
.flow-content h4{
  margin:0 0 4px;
  font-size:15px;
}
.flow-content p{
  margin:0 0 8px;
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}
.flow-content pre{
  margin:0;
  background:#0B1F3B;
  color:#FAF8F4;
  border-radius:8px;
  padding:10px 12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  max-width:100%;
}
.flow-content code{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  display:block;
  white-space:pre;
}
.tag-issue{
  font-family:ui-monospace, monospace;
  font-size:11px;
  background:color-mix(in srgb, var(--primary) 15%, transparent);
  border:1px solid color-mix(in srgb, var(--primary) 30%, transparent);
  color:var(--fg);
  padding:2px 6px;
  border-radius:5px;
}

/* AI GUILD (MOBILE-FIRST) */
.guild-section{
  padding:22px 0 34px;
  width:100%;
}
.guild-card{
  border:1px solid var(--border);
  border-radius:16px;
  background:linear-gradient(145deg, color-mix(in srgb, var(--bg-2) 90%, var(--bg)), var(--bg));
  padding:20px 14px;
}
.guild-grid{
  display:flex;
  flex-direction:column;
  gap:22px;
}
.guild-info h2{
  font-size:clamp(22px, 5.5vw, 30px);
  letter-spacing:-.03em;
  margin:0 0 10px;
}
.guild-info p{
  color:var(--muted);
  font-size:13.5px;
  line-height:1.65;
  margin:0 0 14px;
}
.guild-list{
  margin:0 0 18px;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}
.guild-list b{color:var(--fg)}
.guild-info .ctas{
  display:flex;
  flex-direction:column;
  gap:10px;
  width:100%;
}
.guild-box{
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:14px;
  padding:16px 14px;
  display:flex;
  flex-direction:column;
  gap:12px;
}
.guild-box-head{
  font-size:11px;
  font-weight:700;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted);
  padding-bottom:8px;
  border-bottom:1px solid var(--border);
}
.agent-item{
  display:flex;
  gap:10px;
  align-items:flex-start;
}
.agent-role{
  font-size:10px;
  font-weight:700;
  padding:2px 6px;
  border-radius:5px;
  font-family:ui-monospace, monospace;
  text-transform:uppercase;
  white-space:nowrap;
}
.agent-role.planner{background:#00D1C1;color:#0B1F3B}
.agent-role.builder{background:#39D353;color:#0B1F3B}
.agent-role.auditor{background:#FF3B2E;color:#ffffff}
.agent-item strong{
  font-size:13px;
  display:block;
  margin-bottom:1px;
}
.agent-item p{
  margin:0;
  font-size:11.5px;
  color:var(--muted);
  line-height:1.5;
}

/* FINAL CTA (MOBILE-FIRST) */
.final-cta{
  padding:20px 0 40px;
  width:100%;
}
.cta-card{
  max-width:80rem;
  margin:0 auto;
  padding:28px 14px;
  border:1px solid var(--border);
  border-radius:18px;
  background:linear-gradient(135deg, var(--bg-2), var(--bg));
  text-align:center;
}
.cta-card h2{
  font-size:clamp(22px, 5.5vw, 32px);
  margin:0 0 8px;
  letter-spacing:-.02em;
}
.cta-card p{
  color:var(--muted);
  margin:0 auto 18px;
  max-width:600px;
  font-size:13.5px;
  line-height:1.6;
}
.cta-card .ctas{
  display:flex;
  flex-direction:column;
  gap:10px;
  width:100%;
}
.cta-meta{
  margin-top:14px;
  font-size:11.5px;
  color:var(--muted);
}

/* ==========================================================================
   VIEWPORT SM: SMALL SCREENS / LARGE PHONES & SMALL TABLETS (min-width: 640px)
   ========================================================================== */
@media (min-width: 640px){
  .section-inner{
    padding:0 18px;
  }
  .section-head{
    margin:0 0 24px;
  }
  .section-head h2{
    font-size:clamp(23px, 4vw, 30px);
  }
  .section-head p{
    font-size:14px;
  }

  /* HERO */
  .hero{
    padding:36px 0 24px;
  }
  .hero-inner{
    padding:0 18px;
    gap:24px;
  }
  .hero .lead{
    font-size:14.5px;
  }
  .hero .ctas{
    flex-direction:row;
    width:auto;
    align-items:center;
  }
  .btn{
    width:auto;
  }
  .meta{
    font-size:12px;
  }

  /* TRUST */
  .trust-inner{
    padding:12px 18px;
    flex-direction:row;
    justify-content:space-between;
    align-items:center;
  }
  .trust-items{
    font-size:12.5px;
    gap:12px;
  }
  .trust-items .dot{
    display:inline;
    opacity:.4;
  }

  /* 2-COLUMN GRIDS ON SM */
  .pillar-grid,
  .benefit-grid,
  .nav-map-grid,
  .repo-grid,
  .pathway-grid,
  .gates-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:14px;
  }
  .pillar-card,
  .benefit-card,
  .nav-map-card,
  .repo-card,
  .pathway-card,
  .gate-card{
    padding:18px 16px;
    border-radius:14px;
  }

  /* Span odd card in 2-column layout to prevent awkward empty slots */
  .benefit-card:nth-child(3){
    grid-column:span 2;
  }
  .nav-map-card.featured{
    grid-column:span 2;
  }
  .gate-card:nth-child(3){
    grid-column:span 2;
  }

  .nav-filter-bar{
    flex-direction:row;
    align-items:center;
    gap:14px;
  }
  .fast-setup-box{
    padding:20px 18px;
  }

  .benefit-policy-banner{
    flex-direction:row;
    align-items:flex-start;
    gap:14px;
    padding:16px 18px;
  }

  /* FLOW STEPS (ROW ON SM) */
  .flow-step{
    flex-direction:row;
    gap:14px;
    padding:16px;
    border-radius:14px;
  }
  .flow-badge{
    width:30px;
    height:30px;
    font-size:13px;
    border-radius:8px;
  }

  /* GUILD & CTA */
  .guild-card{
    padding:24px 18px;
    border-radius:18px;
  }
  .guild-info .ctas{
    flex-direction:row;
    width:auto;
  }
  .cta-card{
    padding:32px 20px;
    border-radius:20px;
  }
  .cta-card .ctas{
    flex-direction:row;
    width:auto;
    justify-content:center;
  }
}

/* ==========================================================================
   VIEWPORT MD: MEDIUM SCREENS / TABLETS & SMALL LAPTOPS (min-width: 768px)
   ========================================================================== */
@media (min-width: 768px){
  .section-inner{
    padding:0 22px;
  }
  .section-head{
    margin:0 0 28px;
  }
  .section-head h2{
    font-size:clamp(25px, 3.8vw, 34px);
  }
  .section-head p{
    font-size:14.5px;
  }

  /* HERO (2-COLUMN GRID ON MD) */
  .hero{
    padding:44px 0 28px;
  }
  .hero-inner{
    padding:0 22px;
    display:grid;
    grid-template-columns:minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap:32px;
    align-items:center;
  }
  .hero .lead{
    font-size:15px;
  }

  /* BALANCED GRIDS ON MD */
  .pillar-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:18px;
  }
  /* 3 benefits in 1 row of 3 */
  .benefit-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:18px;
  }
  .benefit-card:nth-child(3){
    grid-column:auto;
  }

  /* Codebase matrix on MD: featured spans 2 columns, other 6 form 3 rows of 2 */
  .nav-map-grid,
  .repo-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:18px;
  }
  .nav-map-card.featured{
    grid-column:span 2;
  }

  /* 6 pathways in 2 rows of 3 */
  .pathway-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:16px;
  }

  /* 3 quality gates in 1 row of 3 */
  .gates-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:16px;
  }
  .gate-card:nth-child(3){
    grid-column:auto;
  }

  .pillar-card,
  .benefit-card,
  .nav-map-card,
  .repo-card,
  .pathway-card,
  .gate-card{
    padding:20px 18px;
    border-radius:16px;
  }

  .fast-setup-box{
    padding:22px 22px;
  }
  .fast-setup-header{
    margin-bottom:10px;
  }
  .terminal-cmd-bar code{
    font-size:13px;
  }

  /* FILTER PILLS WRAPPING ON TABLET */
  .filter-pills{
    flex-wrap:wrap;
    overflow-x:visible;
  }

  .flow-step{
    padding:18px 20px;
    border-radius:16px;
    gap:16px;
  }
  .flow-badge{
    width:34px;
    height:34px;
    font-size:14px;
    border-radius:10px;
  }

  /* AI GUILD 2-COLUMN GRID ON MD */
  .guild-card{
    padding:28px 24px;
    border-radius:20px;
  }
  .guild-grid{
    display:grid;
    grid-template-columns:minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap:28px;
    align-items:center;
  }

  .cta-card{
    padding:38px 24px;
    border-radius:22px;
  }
}

/* ==========================================================================
   VIEWPORT LG: LARGE SCREENS / DESKTOPS (min-width: 1024px)
   ========================================================================== */
@media (min-width: 1024px){
  .section-inner{
    padding:0 24px;
  }
  .section-head{
    margin:0 0 34px;
    max-width:760px;
  }

  /* HERO 2-COLUMN SPLIT ON LG */
  .hero{
    padding:56px 0 36px;
  }
  .hero-inner{
    padding:0 24px;
    grid-template-columns:minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap:44px;
  }
  .hero h1{
    font-size:clamp(32px, 4.2vw, 54px);
    margin:0 0 16px;
  }
  .hero .lead{
    font-size:16px;
    max-width:620px;
  }

  /* PILLARS 4-COLUMN ON LG */
  .pillars{
    padding:48px 0 32px;
  }
  .pillar-grid{
    grid-template-columns:repeat(4, minmax(0, 1fr));
    gap:20px;
  }
  .pillar-card:hover{
    border-color:color-mix(in srgb, var(--primary) 50%, var(--border));
  }

  /* BENEFITS 3-COLUMN ON LG */
  .benefits{
    padding:48px 0 32px;
  }
  .benefit-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:22px;
  }
  .benefit-card{
    padding:24px 20px;
    border-radius:18px;
    transition:transform .15s, border-color .15s;
  }
  .benefit-card:hover{
    transform:translateY(-2px);
    border-color:color-mix(in srgb, var(--fg) 25%, var(--border));
  }

  /* NAV MAP 3-COLUMN WITH FEATURED BANNER CARD */
  .nav-map,
  .repos-nav{
    padding:48px 0 32px;
  }
  .nav-map-grid,
  .repo-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:22px;
  }
  /* Flagship repo card spans full 3-column width */
  .nav-map-card.featured{
    grid-column:1 / -1;
  }
  .fast-setup-box{
    padding:24px 24px;
  }

  .nav-map-card,
  .repo-card{
    padding:22px;
    transition:transform .15s, border-color .15s;
  }
  .nav-map-card:hover,
  .repo-card:hover{
    transform:translateY(-2px);
    border-color:color-mix(in srgb, var(--fg) 25%, var(--border));
  }

  /* PATHWAYS 3-COLUMN ON LG */
  .pathways{
    padding:48px 0 32px;
  }
  .pathway-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:22px;
  }
  .pathway-card{
    padding:22px;
  }

  /* GATES 3-COLUMN ON LG */
  .standards{
    padding:48px 0 32px;
  }
  .gates-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:22px;
  }
