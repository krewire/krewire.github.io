  <!-- v0.1.0 RELEASE HIGHLIGHTS -->
  <section class="releases-section" id="releases">
    <div class="section-inner">
      <div class="section-head text-center">
        <div class="sub-badge" data-i18n="releases.badge">Ecosystem Release</div>
        <h2 data-i18n="releases.title">Krewire Ecosystem v0.1.0 Launch</h2>
        <p data-i18n="releases.subtitle">The foundational milestone release delivering single monorepo architecture, the kiw devtool, strictly typed manifests, and 8 unified workload shapes.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card highlight-card">
          <div class="feature-icon">📦</div>
          <h3 data-i18n="releases.f1_title">Single Monorepo Architecture</h3>
          <p data-i18n="releases.f1_desc">Consolidated under github.com/krewire/krewire. Eliminates cross-module dependency fragmentation, guarantees atomic Git commits, and powers seamless Go workspaces (go.work).</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3 data-i18n="releases.f2_title">Unified 'kiw' Devtool CLI</h3>
          <p data-i18n="releases.f2_desc">A single binary driving the software lifecycle: kiw new, kiw dev, kiw build, kiw serve, kiw worker, kiw deploy, and kiw boost.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">⚙️</div>
          <h3 data-i18n="releases.f3_title">One Config: krewire.yaml</h3>
          <p data-i18n="releases.f3_desc">Strictly typed, declarative project manifests eliminating arbitrary configuration drift across all 8 supported workloads.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🧩</div>
          <h3 data-i18n="releases.f4_title">Modular Domain Libraries</h3>
          <p data-i18n="releases.f4_desc">Single-purpose packages under packages/* (kern, web, ui, cli, db, config, validation, fs, worker). Compose only what you need without inheriting a monolithic framework.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🤖</div>
          <h3 data-i18n="releases.f5_title">AI Boost &amp; Agent Triad Native</h3>
          <p data-i18n="releases.f5_desc">First-class integration for autonomous AI developer agents (templates/boost) with formal KWF-* specifications, automated audits, and regression tests.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📖</div>
          <h3 data-i18n="releases.f6_title">Independent Docs Engine (mdbind)</h3>
          <p data-i18n="releases.f6_desc">Standalone Markdown book &amp; docs compiler powering the book kind with AST transformations, live reloads, and offline assets embedding.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8 UNIFIED WORKLOADS SECTION -->
  <section class="workloads-section" id="workloads">
    <div class="section-inner">
      <div class="section-head text-center">
        <div class="sub-badge" data-i18n="workloads.badge">Unified Architecture</div>
        <h2 data-i18n="workloads.title">8 Workload Kinds Behind One Engine</h2>
        <p data-i18n="workloads.subtitle">Krewire adapts to your project shape. An explicit project.kind in krewire.yaml determines the build, runtime, and deployment lifecycle.</p>
      </div>

      <div class="workloads-grid">
        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Fullstack</span>
            <span class="workload-icon">💻</span>
          </div>
          <h3 data-i18n="workloads.w_app_title">app</h3>
          <p data-i18n="workloads.w_app_desc">Fullstack web applications with reactive server rendering, context pipelines, and DI containers.</p>
          <div class="workload-marker">kiw run · kiw dev</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Developer CLI</span>
            <span class="workload-icon">⌨</span>
          </div>
          <h3 data-i18n="workloads.w_cli_title">cli</h3>
          <p data-i18n="workloads.w_cli_desc">Ergonomic terminal tools, subcommands, and flags powered by the lightweight TUI library.</p>
          <div class="workload-marker">kiw run &lt;args&gt;</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Static Web</span>
            <span class="workload-icon">🌐</span>
          </div>
          <h3 data-i18n="workloads.w_site_title">site</h3>
          <p data-i18n="workloads.w_site_desc">High-speed static websites, marketing portals, and blogs with scoped CSS and the .kiw DSL.</p>
          <div class="workload-marker">kiw build · kiw serve</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Documentation</span>
            <span class="workload-icon">📖</span>
          </div>
          <h3 data-i18n="workloads.w_book_title">book</h3>
          <p data-i18n="workloads.w_book_desc">Technical documentation and digital books compiled with the standalone mdbind engine.</p>
          <div class="workload-marker">kiw build · kiw serve</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Background Queue</span>
            <span class="workload-icon">⚙</span>
          </div>
          <h3 data-i18n="workloads.w_worker_title">worker</h3>
          <p data-i18n="workloads.w_worker_desc">Background task processors, concurrent runners, async queues, and scheduled cron jobs.</p>
          <div class="workload-marker">kiw worker · kiw dev</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Microservice API</span>
            <span class="workload-icon">⚡</span>
          </div>
          <h3 data-i18n="workloads.w_service_title">service</h3>
          <p data-i18n="workloads.w_service_desc">High-throughput microservices, headless daemons, and low-latency JSON/gRPC APIs.</p>
          <div class="workload-marker">kiw run · kiw dev</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Cloud &amp; Baremetal</span>
            <span class="workload-icon">🚀</span>
          </div>
          <h3 data-i18n="workloads.w_infra_title">infra</h3>
          <p data-i18n="workloads.w_infra_desc">Zero-downtime raw VM runners, SSH automation, automated TLS provisioning, and systemd manifests.</p>
          <div class="workload-marker">kiw deploy</div>
        </div>

        <div class="workload-card">
          <div class="workload-top">
            <span class="workload-tag">Core Domain</span>
            <span class="workload-icon">◈</span>
          </div>
          <h3 data-i18n="workloads.w_kernel_title">kernel</h3>
          <p data-i18n="workloads.w_kernel_desc">Pre-init bootstrap core containing strict domain models and runtime lifecycle abstractions.</p>
          <div class="workload-marker">kiw init</div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUICKSTART LAUNCHPAD -->
  <section class="quickstart-section" id="quickstart">
    <div class="section-inner">
      <div class="section-head text-center">
        <div class="sub-badge" data-i18n="quickstart.badge">Quick Installation</div>
        <h2 data-i18n="quickstart.title">Get Started in Seconds</h2>
        <p data-i18n="quickstart.subtitle">Install the kiw developer tool, scaffold an application, or bootstrap the entire 5-repository workspace.</p>
      </div>

      <div class="quickstart-steps">
        <div class="qs-card">
          <div class="qs-num">1</div>
          <h3 data-i18n="quickstart.step1_title">1. Install kiw CLI</h3>
          <p data-i18n="quickstart.step1_desc">Install the unified developer toolchain globally via Go:</p>
          <pre><code>go install github.com/krewire/krewire/tools/kiw/cmd/kiw@latest</code></pre>
        </div>

        <div class="qs-card">
          <div class="qs-num">2</div>
          <h3 data-i18n="quickstart.step2_title">2. Scaffold a Project</h3>
          <p data-i18n="quickstart.step2_desc">Generate a fullstack application or any of the 8 workloads:</p>
          <pre><code>kiw new my-app --kind=app
cd my-app</code></pre>
        </div>

        <div class="qs-card">
          <div class="qs-num">3</div>
          <h3 data-i18n="quickstart.step3_title">3. Run Locally</h3>
          <p data-i18n="quickstart.step3_desc">Start hot-reloading dev server with instant feedback:</p>
          <pre><code>kiw dev</code></pre>
        </div>
      </div>

      <!-- ONE COMMAND BOOTSTRAP -->
      <div class="fast-setup-box">
        <div class="fast-setup-header">
          <div class="fast-setup-title">
            <span class="fast-icon">⚡</span>
            <strong data-i18n="navigator.one_line_title">One-Command Contributor Bootstrap</strong>
          </div>
          <span class="fast-setup-badge" data-i18n="navigator.one_line_badge">Recommended</span>
        </div>
        <p class="fast-setup-desc" data-i18n-html="navigator.one_line_desc_html">Automatically clones all ecosystem repositories, creates your <code>go.work</code> workspace, builds the <code>kiw</code> devtool, and validates compatibility contracts:</p>
        <div class="terminal-cmd-bar">
          <code id="setup-cmd">curl -fsSL https://raw.githubusercontent.com/krewire/internal/main/scripts/setup.sh | bash</code>
          <button class="btn-copy" data-copy-cmd aria-label="Copy setup command">
            <span class="copy-text" data-i18n="navigator.copy_btn">Copy</span>
          </button>
        </div>
        <div class="fast-setup-meta">
          <span data-i18n="navigator.meta_prereq">Prerequisites: Go 1.27.1+ and Git</span>
          <span>•</span>
          <span data-i18n="navigator.meta_zero">Zero manual configuration required</span>
        </div>
      </div>
    </div>
  </section>

