  <!-- CONTRIBUTION PATHWAYS -->
  <section class="pathways" id="pathways">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge" data-i18n="pathways.badge">Choose Your Track</div>
        <h2 data-i18n="pathways.title">Contribution Pathways</h2>
        <p data-i18n="pathways.subtitle">Whether you are a Go systems programmer, an architect, a documentation writer, or an AI prompt engineer — there is a high-impact seat for you.</p>
      </div>
      <div class="pathway-grid">
        <div class="pathway-card">
          <div class="pathway-num">01</div>
          <h3 data-i18n="pathways.p1_title">Core Go Engineering</h3>
          <p data-i18n="pathways.p1_desc">Work on the foundational engine: HTTP routing, concurrent runner coordination, worker queues, and memory allocations.</p>
          <div class="pathway-tags">
            <span>Concurrency</span>
            <span>net/http</span>
            <span>Profiling</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">02</div>
          <h3 data-i18n="pathways.p2_title">Architecture & SDD</h3>
          <p data-i18n="pathways.p2_desc">Draft Spec-Driven Development proposals (<code>KWF-*</code>), formalize module contracts, design clean interfaces, and review architectural integrity.</p>
          <div class="pathway-tags">
            <span>KWF Specs</span>
            <span>Interface Design</span>
            <span>RFCs</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">03</div>
          <h3 data-i18n="pathways.p3_title">AI Agent Engineering</h3>
          <p data-i18n="pathways.p3_desc">Develop autonomous skills for Boost, build MCP tools, and optimize subagent triads that autonomously test and refactor code.</p>
          <div class="pathway-tags">
            <span>AI Boost</span>
            <span>MCP Tools</span>
            <span>Autonomous Triads</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">04</div>
          <h3 data-i18n="pathways.p4_title">Developer Experience & CLI</h3>
          <p data-i18n="pathways.p4_desc">Make <code>kiw</code> lightning fast and delightfully intuitive. Improve terminal UX, scaffolding generators, and developer productivity.</p>
          <div class="pathway-tags">
            <span>CLI Ergonomics</span>
            <span>TUI</span>
            <span>Hot-Reload</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">05</div>
          <h3 data-i18n="pathways.p5_title">Testing & Quality Assurance</h3>
          <p data-i18n="pathways.p5_desc">Hunt race conditions, write fuzz tests, build chaos experiments for concurrent workers, and ensure 100% test reliability.</p>
          <div class="pathway-tags">
            <span>Fuzz Testing</span>
            <span>Race Detection</span>
            <span>Stress Tests</span>
          </div>
        </div>
        <div class="pathway-card">
          <div class="pathway-num">06</div>
          <h3 data-i18n="pathways.p6_title">Technical Writing & Docs</h3>
          <p data-i18n="pathways.p6_desc">Create architectural deep dives, tutorials, quickstart guides, and help translate Krewire documentation for global and Indonesian engineers.</p>
          <div class="pathway-tags">
            <span>Technical Docs</span>
            <span>Guides</span>
            <span>Community</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STANDARDS & QUALITY GATES -->
  <section class="standards" id="standards">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge" data-i18n="standards.badge">Quality Assurance</div>
        <h2 data-i18n="standards.title">The Krewire Way: 3 Quality Gates</h2>
        <p data-i18n="standards.subtitle">To keep the codebase reliable, predictable, and production-ready, every pull request passes through three automated gates.</p>
      </div>
      <div class="gates-grid">
        <div class="gate-card">
          <div class="gate-icon">1</div>
          <h3 data-i18n="standards.gate1_title">Gate 1: Format & Lint</h3>
          <p data-i18n="standards.gate1_desc">Zero lint errors and idiomatic Go formatting. Code must adhere strictly to Go standard conventions.</p>
          <pre class="gate-cmd"><code>go fmt -s ./...
go vet ./...</code></pre>
          <div class="gate-status" data-i18n="standards.gate1_req">Required: Clean exit, 0 warnings</div>
        </div>
        <div class="gate-card">
          <div class="gate-icon">2</div>
          <h3 data-i18n="standards.gate2_title">Gate 2: Race & Tests</h3>
          <p data-i18n="standards.gate2_desc">Every commit is verified with race condition detection and comprehensive unit & integration tests.</p>
          <pre class="gate-cmd"><code>go test -race -cover ./...
kiw build</code></pre>
          <div class="gate-status" data-i18n="standards.gate2_req">Required: 100% test pass, 0 data races</div>
        </div>
        <div class="gate-card">
          <div class="gate-icon">3</div>
          <h3 data-i18n="standards.gate3_title">Gate 3: Spec & Commits</h3>
          <p data-i18n="standards.gate3_desc">Changes must link to a valid Spec or Issue, following Conventional Commits format.</p>
          <pre class="gate-cmd"><code>feat(runner): implement parallel workloads
fix(web): recover panic in http handler</code></pre>
          <div class="gate-status" data-i18n="standards.gate3_req">Required: Semantic versioning compliance</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5-STEP ONBOARDING -->
  <section class="onboarding" id="get-started">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge" data-i18n="onboarding.badge">Getting Started</div>
        <h2 data-i18n="onboarding.title">Start Contributing in 5 Steps</h2>
        <p data-i18n="onboarding.subtitle">From zero to your first merged pull request. Here is how to get your development environment running in minutes.</p>
      </div>
      <div class="steps-flow">
        <div class="flow-step">
          <div class="flow-badge">1</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s1_title">Fork & Clone the Repositories</h4>
            <p data-i18n="onboarding.s1_desc">Fork any Krewire repository to your personal GitHub account, then clone it locally:</p>
            <pre><code>git clone https://github.com/&lt;your-username&gt;/krewire.git
cd krewire</code></pre>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">2</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s2_title">Initialize Multi-Module Workspace</h4>
            <p data-i18n="onboarding.s2_desc">If you're working across multiple Krewire repos, sync your local Go workspace seamlessly:</p>
            <pre><code>go work init ./
go work use ./
go work sync</code></pre>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">3</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s3_title">Pick an Open Issue</h4>
            <p data-i18n-html="onboarding.s3_desc_html">Browse our curated issues list tagged with <span class="tag-issue">good-first-issue</span> or <span class="tag-issue">help-wanted</span>. Comment on the issue to let the community know you're working on it.</p>
            <div class="mt-2">
              <Button Variant="secondary" Size="sm" Href="https://github.com/krewire/krewire/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22" Target="_blank" DataI18n="onboarding.s3_btn">View Good First Issues →</Button>
            </div>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">4</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s4_title">Implement & Verify Locally</h4>
            <p data-i18n="onboarding.s4_desc">Write clean code and corresponding tests. Verify that all 3 Quality Gates pass with zero failures:</p>
            <pre><code>go test -race ./...
# For website changes:
kiw build</code></pre>
          </div>
        </div>

        <div class="flow-step">
          <div class="flow-badge">5</div>
          <div class="flow-content">
            <h4 data-i18n="onboarding.s5_title">Submit Pull Request & Collaborate</h4>
            <p data-i18n="onboarding.s5_desc">Open a Pull Request with Conventional Commits. The maintainers and AI Boost will review, provide fast feedback, and guide you to merge.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AI BOOST COLLABORATION -->
  <section class="guild-section" id="boost">
    <span id="guild" class="section-anchor"></span>
    <div class="section-inner">
      <div class="guild-card">
        <div class="guild-grid">
          <div class="guild-info">
            <div class="sub-badge" data-i18n="guild.badge">Human + AI Synergy</div>
            <h2 data-i18n="guild.title">Collaborating with AI Boost</h2>
            <p data-i18n="guild.lead">Krewire pioneers the collaboration between human maintainers and autonomous AI agents. Our AI Boost framework operates with strict verification standards:</p>
            <ul class="guild-list">
              <li data-i18n-html="guild.item1_html"><b>Automated Architecture Audits:</b> AI agents check PRs against <code>KWF-*</code> specifications.</li>
              <li data-i18n-html="guild.item2_html"><b>Continuous Regression Hunting:</b> Agents synthesize edge cases and race condition checks.</li>
              <li data-i18n-html="guild.item3_html"><b>Transparent Pair Programming:</b> AI agents explain architectural decisions openly in discussions and PR comments.</li>
              <li data-i18n-html="guild.item4_html"><b>Human Governance:</b> Ultimate merging authority always remains in the hands of human collective maintainers.</li>
            </ul>
            <div class="ctas flex flex-wrap gap-3">
              <Button Variant="primary" Href="https://github.com/krewire/krewire/tree/main/templates/boost" Target="_blank" DataI18n="guild.cta_repo">Explore AI Boost in Krewire →</Button>
              <Button Variant="outline" Href="https://github.com/orgs/krewire/discussions" Target="_blank" DataI18n="guild.cta_disc">Join Discussions</Button>
            </div>
          </div>
          <div class="guild-box">
            <div class="guild-box-head" data-i18n="guild.triad_title">AI Boost Agent Triad</div>
            <div class="agent-item">
              <span class="agent-role planner">Planner</span>
              <div>
                <strong data-i18n="guild.planner_title">Requirements & SDD</strong>
                <p data-i18n="guild.planner_desc">Translates feature ideas into formal specs and architectural blueprints.</p>
              </div>
            </div>
            <div class="agent-item">
              <span class="agent-role builder">Builder</span>
              <div>
                <strong data-i18n="guild.builder_title">Implementation & Refactoring</strong>
                <p data-i18n="guild.builder_desc">Generates clean Go implementations adhering to idiomatic patterns.</p>
              </div>
            </div>
            <div class="agent-item">
              <span class="agent-role auditor">Auditor</span>
              <div>
                <strong data-i18n="guild.auditor_title">Verification & Quality Gates</strong>
                <p data-i18n="guild.auditor_desc">Validates concurrency, zero data races, and performance benchmarks.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CALLOUT -->
  <section class="final-cta">
    <div class="cta-card">
      <div class="sub-badge" data-i18n="cta.badge">Join the Collective</div>
      <h2 data-i18n="cta.title">Ready to shape the future of Go?</h2>
      <p data-i18n="cta.lead">Become part of an open source community building fast, sustainable, and autonomous Go software. Every contribution, idea, and PR makes a difference.</p>
      <div class="ctas flex flex-wrap gap-3 justify-center">
        <Button Variant="primary" Size="lg" Href="https://github.com/krewire" Target="_blank" DataI18n="cta.github">Join on GitHub →</Button>
        <Button Variant="outline" Size="lg" Href="#get-started" DataI18n="cta.quickstart">Read Quickstart</Button>
      </div>
      <div class="cta-meta" data-i18n="cta.meta">Proudly open source · MIT Licensed · Engineered with passion in Indonesia</div>
    </div>
  </section>

</div>

<style>
/* ==========================================================================
   MOBILE-FIRST BASE (Phones: 320px - 639px)
   ========================================================================== */

.contributors-portal{
  width:100%;
  min-width:0;
  overflow-x:hidden;
}
.contributors-portal *{
  box-sizing:border-box;
}
.contributors-portal pre{
  max-width:100%;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}

/* SECTION COMMON */
.section-inner{
  width:100%;
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  min-width:0;
}
.section-head{
  margin:0 0 24px;
}
.sub-badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-size:11px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--primary-content);
  background:var(--primary);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  padding:3px 10px;
  border-radius:6px;
  margin-bottom:12px;
}
.section-head h2{
  font-size:clamp(24px, 6vw, 36px);
  font-weight:900;
  letter-spacing:-.035em;
  margin:0 0 10px;
  line-height:1.15;
  word-break:break-word;
}
.section-head p{
  color:var(--muted);
  margin:0;
  font-size:14px;
  line-height:1.6;
  word-break:break-word;
}

/* CARDS COMMON DEFAULTS */
.pillar-card,
.benefit-card,
.repo-card,
.pathway-card,
.gate-card,
.nav-map-card,
.flow-step,
.guild-box{
  min-width:0;
  width:100%;
  word-break:break-word;
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  background:var(--bg);
  box-shadow:var(--pop-shadow);
  transition:transform .15s ease, box-shadow .15s ease;
}
.pillar-card:hover,
.benefit-card:hover,
.repo-card:hover,
.pathway-card:hover,
.gate-card:hover,
.nav-map-card:hover,
.flow-step:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.pillar-grid,
.benefit-grid,
.repo-grid,
.pathway-grid,
.gates-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}

/* HERO (MOBILE-FIRST) */
.hero{
  padding:34px 0 26px;
  background-color:var(--bg);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.hero-inner{
  width:100%;
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  display:flex;
  flex-direction:column;
  gap:24px;
}
.hero-copy{
  min-width:0;
  width:100%;
}
.eyebrow{
  font-size:11px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--primary-content);
  background:var(--primary);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  padding:4px 10px;
  border-radius:6px;
  font-weight:900;
  margin-bottom:14px;
  display:inline-flex;
  align-items:center;
  gap:6px;
  width:fit-content;
  line-height:1.4;
}
.hero h1{
  font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, sans-serif;
  font-size:clamp(30px, 7.8vw, 56px);
  font-weight:900;
  line-height:1.06;
  letter-spacing:-.04em;
  margin:0 0 14px;
  word-break:break-word;
  text-wrap:balance;
}
.hero .lead{
  font-size:14.5px;
  color:color-mix(in srgb, var(--fg) 80%, var(--muted));
  line-height:1.65;
  margin:0;
  word-break:break-word;
}
.hero .lead code{
  font-family:ui-monospace, monospace;
  font-size:12.5px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  padding:2px 6px;
  border-radius:6px;
  font-weight:700;
  word-break:break-word;
}
.hero .ctas{
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:20px;
  width:100%;
}
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:12px 22px;
  border-radius:10px;
  border:var(--pop-border);
  background:var(--bg);
  color:var(--fg);
  font-weight:900;
  font-size:14px;
  box-shadow:var(--pop-shadow);
  transition:all .15s cubic-bezier(0.4, 0, 0.2, 1);
  cursor:pointer;
  min-height:48px;
  width:100%;
  text-align:center;
  text-decoration:none;
}
.btn:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
  background:var(--bg-2);
  color:var(--fg);
}
.btn:active{
  transform:translate(2px, 2px);
  box-shadow:var(--pop-shadow-sm);
}
.btn.primary{
  background:var(--primary);
  color:var(--primary-content);
  border-color:var(--border);
}
.btn.primary:hover{
  background:var(--primary);
  color:var(--primary-content);
  filter:brightness(1.05);
}
.btn.large{
  padding:14px 26px;
  font-size:15px;
}
.btn-subtle{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-size:13px;
  font-weight:800;
  color:var(--fg);
  margin-top:8px;
}
.btn-subtle:hover{
  color:var(--primary);
  text-decoration:underline;
}
.meta{
  margin-top:16px;
  font-size:12px;
  color:var(--muted);
  letter-spacing:.02em;
  line-height:1.5;
  font-weight:600;
  word-break:break-word;
}
.hero-art{
  min-width:0;
  width:100%;
}

/* TRUST BAR (MOBILE-FIRST) */
.trust{
  border-bottom:var(--pop-border);
  background:var(--bg-2);
  width:100%;
  padding:14px 0;
}
.trust-inner{
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.trust-label{
  font-size:11px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--secondary-content);
  background:var(--secondary);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  padding:3px 9px;
  border-radius:6px;
  width:fit-content;
}
.trust-items{
  display:flex;
  flex-wrap:wrap;
  gap:8px 14px;
  font-size:13px;
  color:var(--muted);
  line-height:1.4;
  font-weight:600;
}
.trust-items b{
  color:var(--fg);
}
.trust-items .dot{
  display:none;
}

/* PILLARS */
.pillars{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.pillar-icon{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  font-size:20px;
  margin-bottom:14px;
}
.pillar-card h3{
  margin:0 0 6px;
  font-size:16px;
  font-weight:800;
  letter-spacing:-.01em;
}
.pillar-card p{
  margin:0;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}
.pillar-card code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  padding:1px 5px;
  border-radius:5px;
  font-weight:700;
}

/* CONTRIBUTOR BENEFITS */
.benefits{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.benefit-card{
  position:relative;
  display:flex;
  flex-direction:column;
}
.benefit-card.highlight{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 12%, var(--bg)), var(--bg));
}
.benefit-badge{
  display:inline-block;
  align-self:flex-start;
  font-size:11px;
  font-weight:900;
  padding:3px 9px;
  border-radius:6px;
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  margin-bottom:12px;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.benefit-card.highlight .benefit-badge{
  background:var(--primary);
  color:var(--primary-content);
}
.benefit-badge.req{
  background:var(--secondary);
  color:var(--secondary-content);
}
.benefit-badge.warn{
  background:var(--accent);
  color:#ffffff;
}
.benefit-icon{
  font-size:26px;
  margin-bottom:10px;
  line-height:1;
}
.benefit-card.highlight .benefit-icon{color:var(--primary)}
.benefit-card.condition .benefit-icon{color:var(--secondary)}
.benefit-card.notice .benefit-icon{color:var(--accent)}
.benefit-card h3{
  margin:0 0 8px;
  font-size:16.5px;
  font-weight:800;
  letter-spacing:-.01em;
  line-height:1.3;
}
.benefit-card p{
  margin:0 0 14px;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}
.benefit-list{
  margin:auto 0 0;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:12.5px;
  color:var(--muted);
  line-height:1.5;
  font-weight:600;
}
.benefit-list li::marker{color:var(--primary)}
.benefit-card.condition .benefit-list li::marker{color:var(--secondary)}
.benefit-card.notice .benefit-list li::marker{color:var(--accent)}
.benefit-policy-banner{
  display:flex;
  flex-direction:column;
  gap:8px;
  padding:16px 14px;
  border-radius:10px;
  background:var(--bg);
  border:var(--pop-border);
  box-shadow:var(--pop-shadow-sm);
  margin-top:16px;
}
.policy-marker{
  font-size:18px;
  color:var(--primary);
  line-height:1;
}
.policy-text{
  font-size:12.5px;
  line-height:1.6;
  color:var(--muted);
  word-break:break-word;
}
.policy-text strong{
  color:var(--fg);
  display:inline;
  margin-right:4px;
}

/* CONTRIBUTOR NAVIGATION MAP */
.nav-map{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.fast-setup-box{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  box-shadow:var(--pop-shadow);
  padding:20px 16px;
  margin-bottom:28px;
}
.fast-setup-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:8px;
}
.fast-setup-title{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:16px;
  font-weight:900;
}
.fast-icon{
  color:var(--primary);
  font-size:18px;
}
.fast-setup-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2.5px 8px;
  border-radius:6px;
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  background:var(--primary);
  color:var(--primary-content);
  text-transform:uppercase;
  letter-spacing:.05em;
}
.fast-setup-desc{
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
  margin:0 0 14px;
}
.terminal-cmd-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--bg-2);
  border:var(--pop-border-thin);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  padding:10px 14px;
  gap:12px;
  overflow-x:auto;
}
.terminal-cmd-bar code{
  font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size:13px;
  font-weight:700;
  color:var(--fg);
  white-space:nowrap;
}
.btn-copy{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:6px 14px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  border-radius:6px;
  box-shadow:var(--pop-shadow-sm);
  font-size:12px;
  font-weight:900;
  cursor:pointer;
  transition:all .15s ease;
  flex-shrink:0;
}
.btn-copy:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--primary);
  color:var(--primary-content);
}
.btn-copy:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.btn-copy.copied{
  background:var(--primary);
  color:var(--primary-content);
}
.fast-setup-meta{
  display:flex;
  gap:10px;
  font-size:12px;
  font-weight:600;
  color:var(--muted);
  margin-top:10px;
  flex-wrap:wrap;
}

/* FILTER BAR */
.nav-filter-bar{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-bottom:22px;
}
.filter-label{
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.06em;
  color:var(--fg);
}
.filter-pills{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:6px;
  -webkit-overflow-scrolling:touch;
}
.filter-pill{
  background:var(--bg);
  border:var(--pop-border-thin);
  color:var(--fg);
  box-shadow:var(--pop-shadow-sm);
  border-radius:8px;
  padding:6px 14px;
  font-size:12.5px;
  font-weight:800;
  cursor:pointer;
  white-space:nowrap;
  transition:all .15s ease;
}
.filter-pill:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--bg-2);
}
.filter-pill:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.filter-pill.is-active{
  background:var(--primary);
  color:var(--primary-content);
}

/* NAV MAP CARDS */
.nav-map-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
.nav-map-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  display:flex;
  flex-direction:column;
  box-shadow:var(--pop-shadow);
  transition:transform .15s ease, box-shadow .15s ease;
}
.nav-map-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.nav-card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:10px;
  gap:8px;
  flex-wrap:wrap;
}
.nav-track-tag{
  font-size:11.5px;
  font-weight:900;
  color:var(--primary);
  text-transform:uppercase;
  letter-spacing:.05em;
}
.nav-curve-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2.5px 8px;
  border-radius:6px;
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  text-transform:uppercase;
  letter-spacing:.04em;
}
.nav-curve-badge.gentle{
  background:var(--primary);
  color:var(--primary-content);
}
.nav-curve-badge.intermediate{
  background:var(--secondary);
  color:var(--secondary-content);
}
.nav-curve-badge.advanced{
  background:var(--accent);
  color:#ffffff;
}
.nav-curve-badge.innovative{
  background:#ffd166;
  color:#0B1F3B;
}
.nav-card-title{
  font-size:19px;
  font-weight:900;
  margin:0 0 8px;
  font-family:ui-monospace, monospace;
}
.nav-card-match{
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
  margin:0 0 14px;
  flex-grow:1;
}
.nav-card-match strong{
  color:var(--fg);
}
.nav-card-packages{
  margin-bottom:16px;
  font-size:12px;
}
.pkg-label{
  display:block;
  color:var(--muted);
  font-size:11px;
  margin-bottom:6px;
  font-weight:800;
  text-transform:uppercase;
}
.pkg-tags{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}
.pkg-tags code{
  font-size:11.5px;
  font-weight:700;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  padding:2px 6px;
  border-radius:5px;
}
.section-anchor{
  display:block;
  position:relative;
  top:-70px;
  visibility:hidden;
}
.repos-nav{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  border-bottom:var(--pop-border);
  width:100%;
}
.repo-icon{
  color:var(--primary);
  margin-right:6px;
  display:inline-block;
}
.nav-map-card.featured{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, var(--bg)), var(--bg));
}
.nav-card-footer{
  margin-top:auto;
  padding-top:14px;
  border-top:1.5px solid var(--border-subtle);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
}
.nav-action-link{
  display:inline-flex;
  align-items:center;
  gap:4px;
  font-size:13px;
  font-weight:900;
  color:var(--primary);
  text-decoration:none;
  transition:gap .15s ease;
}
.nav-action-link:hover{
  gap:8px;
  text-decoration:underline;
}
.nav-repo-link{
  font-size:12px;
  font-weight:700;
  color:var(--muted);
  text-decoration:none;
  transition:color .15s ease;
}
.nav-repo-link:hover{
  color:var(--fg);
  text-decoration:underline;
}
.repo-card{
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.repo-card.featured{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, var(--bg)), var(--bg));
}
.repo-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:8px;
  margin-bottom:10px;
  flex-wrap:wrap;
}
.repo-name{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:0;
  flex-wrap:wrap;
}
.repo-icon{
  font-size:17px;
  color:var(--primary);
  flex-shrink:0;
}
.repo-name h3{
  margin:0;
  font-size:15px;
  font-weight:900;
  font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing:-.01em;
  word-break:break-word;
}
.repo-name .alias{
  font-size:11.5px;
  color:var(--muted);
  font-weight:700;
}
.repo-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2.5px 8px;
  border-radius:6px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  color:var(--fg);
  white-space:nowrap;
}
.repo-badge.primary{
  background:var(--primary);
  color:var(--primary-content);
}
.repo-desc{
  font-size:13px;
  color:var(--muted);
  margin:0 0 12px;
  line-height:1.55;
}
.repo-desc code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  font-weight:700;
  background:var(--bg-2);
  border:1px solid var(--border-subtle);
  padding:1px 5px;
  border-radius:4px;
}
.repo-details{
  display:flex;
  flex-direction:column;
  gap:7px;
  margin-bottom:14px;
  font-size:12px;
  padding-top:10px;
  border-top:1.5px solid var(--border-subtle);
}
.detail-item strong{
  color:var(--fg);
  display:block;
  margin-bottom:1px;
  font-weight:800;
}
.detail-item span{
  color:var(--muted);
  line-height:1.5;
}
.repo-footer{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:6px;
  padding-top:10px;
  border-top:1.5px solid var(--border-subtle);
}
.tag{
  font-size:11px;
  font-weight:800;
  padding:2px 7px;
  border-radius:5px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  color:var(--fg);
  font-family:ui-monospace, monospace;
}
.repo-link{
  margin-left:auto;
  font-size:13px;
  font-weight:900;
  color:var(--primary);
  padding:4px 0;
}
.repo-link:hover{
  text-decoration:underline;
}

/* PATHWAYS */
.pathways{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.pathway-num{
  font-size:18px;
  font-weight:900;
  color:var(--primary);
  font-family:ui-monospace, monospace;
  margin-bottom:6px;
}
.pathway-card h3{
  margin:0 0 6px;
  font-size:16px;
  font-weight:900;
  letter-spacing:-.01em;
}
.pathway-card p{
  margin:0 0 12px;
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}
.pathway-tags{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}
.pathway-tags span{
  font-size:11px;
  font-weight:800;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  border-radius:5px;
  padding:2px 7px;
  color:var(--fg);
}

/* STANDARDS & GATES */
.standards{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.gate-icon{
  width:32px;
  height:32px;
  border-radius:8px;
  background:var(--primary);
  color:var(--primary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  display:grid;
  place-items:center;
  font-weight:900;
  font-size:14px;
  margin-bottom:12px;
}
.gate-card h3{
  margin:0 0 6px;
  font-size:16px;
  font-weight:900;
}
.gate-card p{
  margin:0 0 12px;
  font-size:13px;
  color:var(--muted);
  line-height:1.55;
}
.gate-cmd{
  margin:0 0 12px;
  background:#0B1F3B;
  color:#FAF8F4;
  border:2px solid var(--border);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  padding:10px 12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  max-width:100%;
}
.gate-cmd code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  line-height:1.55;
  display:block;
  white-space:pre;
}
.gate-status{
  margin-top:auto;
  font-size:12px;
  font-weight:800;
  color:var(--primary);
  display:flex;
  align-items:center;
  gap:6px;
}

/* ONBOARDING FLOW */
.onboarding{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.steps-flow{
  display:flex;
  flex-direction:column;
  gap:14px;
  max-width:880px;
  margin:0 auto;
}
.flow-step{
  display:flex;
  flex-direction:column;
  gap:12px;
  padding:18px 16px;
  min-width:0;
}
.flow-badge{
  width:32px;
  height:32px;
  flex-shrink:0;
  border-radius:8px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  display:grid;
  place-items:center;
  font-weight:900;
  font-size:14px;
}
.flow-content{
  flex:1;
  min-width:0;
  width:100%;
}
.flow-content h4{
  margin:0 0 6px;
  font-size:16px;
  font-weight:900;
}
.flow-content p{
  margin:0 0 10px;
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}
.flow-content pre{
  margin:0;
  background:#0B1F3B;
  color:#FAF8F4;
  border:2px solid var(--border);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  padding:10px 12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  max-width:100%;
}
.flow-content code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  display:block;
  white-space:pre;
}
.tag-issue{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  font-weight:800;
  background:var(--primary);
  color:var(--primary-content);
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  padding:2px 7px;
  border-radius:5px;
}

/* AI GUILD */
.guild-section{
  padding:44px 0 32px;
  background-color:var(--bg-2);
  border-bottom:var(--pop-border);
  width:100%;
}
.guild-card{
  border:var(--pop-border);
  border-radius:16px;
  background:var(--bg);
  box-shadow:var(--pop-shadow-lg);
  padding:22px 16px;
}
.guild-grid{
  display:flex;
  flex-direction:column;
  gap:24px;
}
.guild-info h2{
  font-size:clamp(24px, 5.5vw, 34px);
  font-weight:900;
  letter-spacing:-.03em;
  margin:0 0 10px;
}
.guild-info p{
  color:var(--muted);
  font-size:14px;
  line-height:1.65;
  margin:0 0 16px;
}
.guild-list{
  margin:0 0 20px;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:10px;
  font-size:13.5px;
  color:var(--muted);
  line-height:1.6;
}
.guild-list b{color:var(--fg)}
.guild-info .ctas{
  display:flex;
  flex-direction:column;
  gap:12px;
  width:100%;
}
.guild-box{
  background:var(--bg-2);
  border:var(--pop-border);
  border-radius:12px;
  box-shadow:var(--pop-shadow);
  padding:18px 16px;
  display:flex;
  flex-direction:column;
  gap:14px;
}
.guild-box-head{
  font-size:11.5px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--fg);
  padding-bottom:10px;
  border-bottom:1.5px solid var(--border-subtle);
}
.agent-item{
  display:flex;
  gap:10px;
  align-items:flex-start;
}
.agent-role{
  font-size:10.5px;
  font-weight:900;
  padding:3px 8px;
  border-radius:6px;
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  font-family:ui-monospace, monospace;
  text-transform:uppercase;
  white-space:nowrap;
}
.agent-role.planner{background:var(--secondary);color:var(--secondary-content)}
.agent-role.builder{background:var(--primary);color:var(--primary-content)}
.agent-role.auditor{background:var(--accent);color:#ffffff}
.agent-item strong{
  font-size:13.5px;
  font-weight:800;
  display:block;
  margin-bottom:2px;
}
.agent-item p{
  margin:0;
  font-size:12px;
  color:var(--muted);
  line-height:1.5;
}

/* FINAL CTA (MOBILE-FIRST) */
.final-cta{
  padding:36px 0 54px;
  background-color:var(--bg);
  width:100%;
}
.cta-card{
  max-width:80rem;
  margin:0 auto;
  padding:36px 16px;
  border:var(--pop-border);
  border-radius:18px;
  background:var(--bg-2);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:16px 16px;
  box-shadow:var(--pop-shadow-lg);
  text-align:center;
}
.cta-card h2{
  font-size:clamp(24px, 5.5vw, 36px);
  font-weight:900;
  margin:0 0 10px;
  letter-spacing:-.03em;
}
.cta-card p{
  color:var(--muted);
  margin:0 auto 20px;
  max-width:620px;
  font-size:14px;
  line-height:1.6;
}
.cta-card .ctas{
  display:flex;
  flex-direction:column;
  gap:12px;
  width:100%;
}
.cta-meta{
  margin-top:16px;
  font-size:12px;
  font-weight:600;
  color:var(--muted);
}

/* ==========================================================================
   VIEWPORT SM: SMALL SCREENS / LARGE PHONES & SMALL TABLETS (min-width: 640px)
   ========================================================================== */
@media (min-width: 640px){
  .section-inner{
    padding:0 18px;
  }
  .section-head{
    margin:0 0 24px;
  }
  .section-head h2{
    font-size:clamp(23px, 4vw, 30px);
  }
  .section-head p{
    font-size:14px;
  }

  /* HERO */
  .hero{
    padding:36px 0 24px;
  }
  .hero-inner{
    padding:0 18px;
    gap:24px;
  }
  .hero .lead{
    font-size:14.5px;
  }
  .hero .ctas{
    flex-direction:row;
    width:auto;
    align-items:center;
  }
  .btn{
    width:auto;
  }
  .meta{
    font-size:12px;
  }

  /* TRUST */
  .trust-inner{
    padding:12px 18px;
    flex-direction:row;
    justify-content:space-between;
    align-items:center;
  }
  .trust-items{
    font-size:12.5px;
    gap:12px;
  }
  .trust-items .dot{
    display:inline;
    opacity:.4;
  }

  /* 2-COLUMN GRIDS ON SM */
  .pillar-grid,
  .benefit-grid,
  .nav-map-grid,
  .repo-grid,
  .pathway-grid,
  .gates-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:14px;
  }
  .pillar-card,
  .benefit-card,
  .nav-map-card,
  .repo-card,
  .pathway-card,
  .gate-card{
    padding:18px 16px;
    border-radius:14px;
  }

  /* Span odd card in 2-column layout to prevent awkward empty slots */
  .benefit-card:nth-child(3){
    grid-column:span 2;
  }
  .nav-map-card.featured{
    grid-column:span 2;
  }
  .gate-card:nth-child(3){
    grid-column:span 2;
  }

  .nav-filter-bar{
    flex-direction:row;
    align-items:center;
    gap:14px;
  }
  .fast-setup-box{
    padding:20px 18px;
  }

  .benefit-policy-banner{
    flex-direction:row;
    align-items:flex-start;
    gap:14px;
    padding:16px 18px;
  }

  /* FLOW STEPS (ROW ON SM) */
  .flow-step{
    flex-direction:row;
    gap:14px;
    padding:16px;
    border-radius:14px;
  }
  .flow-badge{
    width:30px;
    height:30px;
    font-size:13px;
    border-radius:8px;
  }

  /* GUILD & CTA */
  .guild-card{
    padding:24px 18px;
    border-radius:18px;
  }
  .guild-info .ctas{
    flex-direction:row;
    width:auto;
  }
  .cta-card{
    padding:32px 20px;
    border-radius:20px;
  }
  .cta-card .ctas{
    flex-direction:row;
    width:auto;
    justify-content:center;
  }
}

/* ==========================================================================
   VIEWPORT MD: MEDIUM SCREENS / TABLETS & SMALL LAPTOPS (min-width: 768px)
   ========================================================================== */
@media (min-width: 768px){
  .section-inner{
    padding:0 22px;
  }
  .section-head{
    margin:0 0 28px;
  }
  .section-head h2{
    font-size:clamp(25px, 3.8vw, 34px);
  }
  .section-head p{
    font-size:14.5px;
  }

  /* HERO (2-COLUMN GRID ON MD) */
  .hero{
    padding:44px 0 28px;
  }
  .hero-inner{
    padding:0 22px;
    display:grid;
    grid-template-columns:minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap:32px;
    align-items:center;
  }
  .hero .lead{
    font-size:15px;
  }

  /* BALANCED GRIDS ON MD */
  .pillar-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:18px;
  }
  /* 3 benefits in 1 row of 3 */
  .benefit-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:18px;
  }
  .benefit-card:nth-child(3){
    grid-column:auto;
  }

  /* Codebase matrix on MD: featured spans 2 columns, other 6 form 3 rows of 2 */
  .nav-map-grid,
  .repo-grid{
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:18px;
  }
  .nav-map-card.featured{
    grid-column:span 2;
  }

  /* 6 pathways in 2 rows of 3 */
  .pathway-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:16px;
  }

  /* 3 quality gates in 1 row of 3 */
  .gates-grid{
    grid-template-columns:repeat(3, minmax(0, 1fr));
    gap:16px;
  }
