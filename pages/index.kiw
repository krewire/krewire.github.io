  <!-- REPOSITORY MATRIX -->
  <section class="repos" id="repositories">
    <div class="section-inner">
      <div class="section-head">
        <div class="sub-badge">Codebase Matrix</div>
        <h2>Core Repositories</h2>
        <p>Explore the six foundational pillars of Krewire. Each repository has clear boundaries, modular architecture, and welcomes contributions.</p>
      </div>
      <div class="repo-grid">
        
        <!-- framework -->
        <div class="repo-card featured">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">⬢</span>
              <h3>krewire/framework</h3>
            </div>
            <span class="repo-badge primary">Core Engine</span>
          </div>
          <p class="repo-desc">The unified Go framework runtime powering 8 workloads: <code>app</code>, <code>web</code>, <code>runner</code>, <code>service</code>, <code>worker</code>, <code>runtime</code>, <code>infra</code>, <code>tui</code>, and <code>testing</code>.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span>Zero-alloc routing, concurrent runners, graceful shutdown, panic recovery, middleware.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>New runner adapters, distributed queue drivers, WASM bridges, observability plugins.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">Go 1.22+</span>
            <span class="tag">net/http</span>
            <span class="tag">High Concurrency</span>
            <a class="repo-link" href="https://github.com/krewire/framework" target="_blank" rel="noopener">Explore Repo →</a>
          </div>
        </div>

        <!-- libs / cord -->
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">◈</span>
              <h3>krewire/libs <span class="alias">(cord)</span></h3>
            </div>
            <span class="repo-badge">Standard Library</span>
          </div>
          <p class="repo-desc">Essential low-level kernel primitives, structural utilities, high-performance validation, configuration, and terminal formatters.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span><code>core</code>, <code>kern</code>, <code>validate</code>, <code>config</code>, <code>term</code>, <code>sync</code> with zero external bloat.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>Micro-optimizations, zero-copy string helpers, config parsers, thread-safe collections.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">Zero Deps</span>
            <span class="tag">Kernel</span>
            <a class="repo-link" href="https://github.com/krewire/libs" target="_blank" rel="noopener">Explore Repo →</a>
          </div>
        </div>

        <!-- kiw -->
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">⚙</span>
              <h3>krewire/kiw</h3>
            </div>
            <span class="repo-badge">Toolchain CLI</span>
          </div>
          <p class="repo-desc">The unified command-line toolchain for building, serving, live-reloading, generating templates, and deploying Krewire applications.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span><code>kiw new</code>, <code>kiw build</code>, <code>kiw serve</code>, SSG compiler, plugin engine.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>Scaffolding templates, hot-reload file watchers, dev-server UX, LSP integration.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">CLI</span>
            <span class="tag">Compiler</span>
            <a class="repo-link" href="https://github.com/krewire/kiw" target="_blank" rel="noopener">Explore Repo →</a>
          </div>
        </div>

        <!-- guild -->
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">▲</span>
              <h3>krewire/guild</h3>
            </div>
            <span class="repo-badge">AI Agent Swarm</span>
          </div>
          <p class="repo-desc">Autonomous AI Agent Guild template, multi-agent triads, skill registry, and continuous self-improving developer automation.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span>Agent triads (builder/auditor/planner), skill definitions, MCP servers, autonomous PR triage.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>Specialized developer skills, automated benchmark suites, reasoning prompts.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">AI Agents</span>
            <span class="tag">Autonomous</span>
            <a class="repo-link" href="https://github.com/krewire/guild" target="_blank" rel="noopener">Explore Repo →</a>
          </div>
        </div>

        <!-- ship -->
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">☁</span>
              <h3>krewire/ship</h3>
            </div>
            <span class="repo-badge">Deployment Engine</span>
          </div>
          <p class="repo-desc">Zero-cost infrastructure orchestrator and deployment automation. Containerless running on raw VMs, systemd units, and cloud providers.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span>Zero-downtime deploys, automated TLS, SSH runners, multi-target release pipelines.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>Cloud provider adapters, health-check monitors, atomic rollback engines.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">Infra</span>
            <span class="tag">Deployment</span>
            <a class="repo-link" href="https://github.com/krewire/ship" target="_blank" rel="noopener">Explore Repo →</a>
          </div>
        </div>

        <!-- hub -->
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">🔌</span>
              <h3>krewire/hub</h3>
            </div>
            <span class="repo-badge">Plugin & Integration Registry</span>
          </div>
          <p class="repo-desc">Plugin system and third-party integration registry for the Krewire ecosystem. Provides the plugin interface, installer contracts, and resolver chain used by <code>kiw build</code>, <code>kiw add</code>, and <code>kiw remove</code>.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span>Self-registering plugins (Tailwind CSS, etc.), npm/gomod resolver chain, zero-change extensibility for <code>kiw</code>.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>New build plugins, package resolvers, third-party integrations, and installer adapters.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">Plugins</span>
            <span class="tag">Integrations</span>
            <span class="tag">Registry</span>
            <a class="repo-link" href="https://github.com/krewire/hub" target="_blank" rel="noopener">Explore Repo →</a>
          </div>
        </div>

        <!-- mdbind -->
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <span class="repo-icon">≡</span>
              <h3>krewire/mdbind</h3>
            </div>
            <span class="repo-badge">Standalone Book Builder</span>
          </div>
          <p class="repo-desc">Fast, zero-dependency Markdown-based book and documentation site builder. Runs completely standalone via CLI or as the <code>book</code> workload in Krewire.</p>
          <div class="repo-details">
            <div class="detail-item">
              <strong>Key Focus:</strong>
              <span>Ordered chapters, collapsible sidebar, <code>book.yaml</code> config, instant live reload, sub-15ms builds.</span>
            </div>
            <div class="detail-item">
              <strong>Contribute:</strong>
              <span>CLI ergonomics, search indexing, custom callouts, syntax highlighting speedups.</span>
            </div>
          </div>
          <div class="repo-footer">
            <span class="tag">Standalone CLI</span>
            <span class="tag">Markdown</span>
            <span class="tag">Zero-Deps</span>
