      <div class="cta-card">
        <div class="sub-badge" data-i18n="cta.badge">Join the Collective</div>
        <h2 data-i18n="cta.title">Ready to Shape the Future of Indonesian Tech?</h2>
        <p class="cta-lead" data-i18n="cta.lead">Whether you are writing your first Go pull request or sponsoring our developer community, you are laying the foundation for open-source self-reliance.</p>
        <div class="ctas flex flex-wrap gap-3 justify-center">
          <a href="https://github.com/krewire/krewire/issues" target="_blank" rel="noopener" class="btn btn-primary btn-lg" data-i18n="cta.github">Explore Open Issues on GitHub →</a>
          <a href="#sponsorship" class="btn btn-secondary btn-lg" data-i18n="cta.sponsor">Sponsor on GitHub 💖</a>
        </div>
        <div class="cta-meta" data-i18n="cta.meta">Proudly open source · MIT Licensed · Engineered with passion in Indonesia</div>
      </div>
    </div>
  </section>

</div>

<style>
/* ==========================================================================
   KREWIRE COMMUNITY PORTAL STYLING
   Neo-brutalist, accessible, responsive
   ========================================================================== */

/* 1. HERO SECTION */
.hero {
  padding: 38px 0 28px;
  background: var(--bg);
  position: relative;
}
.hero-inner {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 16px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
}
.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--primary-content);
  background: var(--primary);
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  padding: 3px 9px;
  border-radius: 6px;
  width: fit-content;
}
.hero h1 {
  font-size: clamp(26px, 5vw, 44px);
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin: 0;
  color: var(--fg);
}
.hero .lead {
  font-size: 14.5px;
  line-height: 1.65;
  color: var(--muted);
  margin: 0;
  max-width: 580px;
}
.hero .meta {
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* TERMINAL CARD */
.code-terminal-card {
  background: #0B1F3B;
  border: 2.5px solid var(--border);
  box-shadow: var(--pop-shadow);
  border-radius: 12px;
  overflow: hidden;
  color: #FAF8F4;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12.5px;
}
:root[data-theme="dark"] .code-terminal-card {
  border-color: #FAF8F4;
  box-shadow: 4px 4px 0px var(--primary);
}
.code-terminal-bar {
  background: #112646;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 2px solid rgba(250, 248, 244, 0.12);
}
.terminal-dots {
  display: flex;
  gap: 6px;
}
.term-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}
.term-dot.red { background: #FF3B2E; }
.term-dot.yellow { background: #ffb703; }
.term-dot.green { background: #39D353; }
.term-title {
  font-size: 11px;
  font-weight: 700;
  color: #9ab0ce;
}
.code-terminal-body {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  line-height: 1.5;
}
.term-line {
  word-break: break-all;
}
.term-prompt {
  color: #39D353;
  font-weight: 800;
  margin-right: 6px;
}
.term-cmd {
  color: #FAF8F4;
  font-weight: 700;
}
.term-info {
  color: #00D1C1;
  font-size: 11.5px;
}
.term-success {
  color: #39D353;
  font-size: 11.5px;
  font-weight: 700;
}
.term-muted {
  color: #8fa2bc;
  font-size: 11px;
}

/* 2. TRUST BAR */
.trust {
  border-top: var(--pop-border);
  border-bottom: var(--pop-border);
  background: var(--bg-2);
  padding: 12px 16px;
}
.trust-inner {
  max-width: 80rem;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-size: 12.5px;
  font-weight: 700;
}
.trust-label {
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: 11px;
  color: var(--muted);
}
.trust-items {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.trust-item b {
  color: var(--primary-content);
  background: var(--primary);
  padding: 1px 6px;
  border-radius: 4px;
}
:root[data-theme="dark"] .trust-item b {
  color: #0B1F3B;
  background: var(--primary);
}
.dot {
  color: var(--muted);
  opacity: 0.6;
}

/* SECTION COMMONS */
.section-inner {
  max-width: 80rem;
  margin: 0 auto;
  padding: 0 16px;
}
.section-head {
  text-align: center;
  margin-bottom: 28px;
}
.sub-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  background: var(--secondary);
  color: var(--secondary-content);
  padding: 3px 9px;
  border-radius: 6px;
  border: 1.5px solid var(--border);
  box-shadow: 1.5px 1.5px 0px var(--border);
  margin-bottom: 10px;
}
.section-head h2 {
  font-size: clamp(22px, 3.5vw, 32px);
  font-weight: 900;
  letter-spacing: -0.025em;
  margin: 0 0 8px;
}
.section-head p {
  font-size: 14.5px;
  color: var(--muted);
  max-width: 680px;
  margin: 0 auto;
}

/* 3. CONTRIBUTOR PRIVILEGES (BENEFITS) */
.benefits {
  padding: 42px 0 28px;
}
.benefit-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.benefit-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.benefit-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.benefit-card.highlight-card {
  background: var(--bg-2);
  border-color: var(--primary);
}
:root[data-theme="dark"] .benefit-card.highlight-card {
  border-color: var(--primary);
  box-shadow: 4px 4px 0px var(--primary);
}
.benefit-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  background: var(--primary);
  color: var(--primary-content);
  padding: 2px 7px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
  width: fit-content;
}
.benefit-card h3 {
  font-size: 17px;
  font-weight: 800;
  margin: 0;
}
.benefit-card p {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.benefit-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}
.benefit-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.benefit-list li::before {
  content: "✓";
  color: var(--primary);
  font-weight: 900;
}
.meritocracy-callout {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow-sm);
  border-radius: var(--radius);
  padding: 16px 20px;
}
.meritocracy-inner {
  display: flex;
  align-items: center;
  gap: 16px;
}
.meritocracy-icon {
  font-size: 26px;
  flex-shrink: 0;
}
.meritocracy-body strong {
  display: block;
  font-size: 14.5px;
  margin-bottom: 3px;
}
.meritocracy-body p {
  font-size: 13px;
  color: var(--muted);
  margin: 0;
  line-height: 1.5;
}

/* 4. CODEBASE MATRIX & REPOSITORIES */
.repos-nav {
  padding: 42px 0 28px;
}
.fast-setup-box {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 18px 20px;
}
.fast-setup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.fast-setup-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15px;
  font-weight: 900;
}
.fast-setup-badge {
  font-size: 10.5px;
  font-weight: 800;
  background: var(--primary);
  color: var(--primary-content);
  padding: 2px 7px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
}
.fast-setup-desc {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0 0 12px;
}
.terminal-cmd-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #0B1F3B;
  color: #FAF8F4;
  border: 2px solid var(--border);
  border-radius: 8px;
  padding: 8px 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12.5px;
}
.terminal-cmd-bar code {
  overflow-x: auto;
  white-space: nowrap;
}
.btn-copy {
  background: var(--primary);
  color: var(--primary-content);
  border: 1.5px solid #0B1F3B;
  box-shadow: 1.5px 1.5px 0px #0B1F3B;
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 11.5px;
  font-weight: 800;
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.12s ease;
}
.btn-copy:hover {
  transform: translate(-1px, -1px);
  box-shadow: 2.5px 2.5px 0px #0B1F3B;
}
.btn-copy.copied {
  background: var(--secondary);
}
.fast-setup-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: var(--muted);
  font-weight: 700;
  margin-top: 10px;
  flex-wrap: wrap;
}

/* FILTERS */
.nav-filters {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.filter-label {
  font-size: 12.5px;
  font-weight: 800;
  color: var(--muted);
}
.filter-pills {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.filter-pill {
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  background: var(--bg);
  color: var(--fg);
  font-size: 12px;
  font-weight: 800;
  padding: 5px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.12s ease;
}
.filter-pill:hover {
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0px var(--border);
  background: var(--bg-2);
}
.filter-pill.is-active {
  background: var(--primary);
  color: var(--primary-content);
}

/* REPOSITORIES GRID */
.repo-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.repo-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.repo-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.repo-meta-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}
.repo-tag {
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
}
.repo-tag.core { background: var(--primary); color: var(--primary-content); }
.repo-tag.tool { background: var(--secondary); color: var(--secondary-content); }
.repo-tag.site { background: var(--accent); color: #fff; }
.repo-tag.docs { background: #ffb703; color: #0B1F3B; }
.repo-lang {
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
}
.repo-title {
  font-size: 18px;
  font-weight: 900;
  margin: 0;
}
.repo-title a:hover {
  color: var(--primary);
}
.repo-track-name {
  font-size: 12.5px;
  font-weight: 800;
  color: var(--muted);
}
.repo-match {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.55;
  margin: 0;
}
.repo-pkgs {
  margin-top: 8px;
}
.pkgs-label {
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
  display: block;
  margin-bottom: 5px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.pkgs-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}
.pkg-chip {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 11px;
  font-weight: 700;
  background: var(--bg-2);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 5px;
}
.repo-footer {
  display: flex;
  gap: 10px;
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px dashed var(--border-subtle);
}
.repo-action {
  font-size: 12px;
  font-weight: 800;
  padding: 5px 11px;
  border-radius: 6px;
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  transition: all 0.12s ease;
  display: inline-flex;
  align-items: center;
}
.repo-action.primary {
  background: var(--primary);
  color: var(--primary-content);
}
.repo-action.secondary {
  background: var(--bg);
  color: var(--fg);
}
.repo-action:hover {
  transform: translate(-1px, -1px);
  box-shadow: 3px 3px 0px var(--border);
}

/* 5. ONBOARDING QUICKSTART & QUALITY GATES */
.onboarding,
.standards {
  padding: 42px 0 28px;
}
.quickstart-steps,
.gates-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
.qs-card,
.gate-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.qs-card:hover,
.gate-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.qs-num {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--primary);
  color: var(--primary-content);
  border: var(--pop-border-thin);
  box-shadow: var(--pop-shadow-sm);
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 900;
}
.qs-card h3,
.gate-card h3 {
  font-size: 16px;
  font-weight: 800;
  margin: 0;
}
.qs-card p,
.gate-card p {
  font-size: 13.5px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.qs-card pre {
  background: #0B1F3B;
  color: #FAF8F4;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  overflow-x: auto;
  margin: 4px 0 0;
}
.tag-issue {
  background: var(--secondary);
  color: var(--secondary-content);
  padding: 1px 6px;
  border-radius: 4px;
  font-weight: 800;
  font-size: 11px;
}
.gate-icon {
  font-size: 24px;
}
.gate-req {
  font-size: 11.5px;
  font-weight: 800;
  background: var(--bg-2);
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid var(--border);
  margin-top: auto;
}

/* 6. SPONSORSHIP CHANNELS */
.sponsorship-section {
  padding: 42px 0 28px;
  background: var(--bg);
}
.sponsor-channels-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
.sponsor-channel-card {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.sponsor-channel-card:hover {
  transform: translate(-2px, -2px);
  box-shadow: var(--pop-shadow-lg);
}
.sponsor-channel-card.highlight-card {
  background: var(--bg-2);
  border-color: var(--secondary);
  box-shadow: 4px 4px 0px var(--secondary);
}
.sponsor-card-top {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.channel-badge {
  font-size: 11px;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 5px;
  border: 1.5px solid var(--border);
  width: fit-content;
  display: inline-block;
}
.channel-badge.community { background: var(--primary); color: var(--primary-content); }
.channel-badge.corporate { background: var(--secondary); color: var(--secondary-content); }
.channel-title {
  font-size: 22px;
  font-weight: 900;
  margin: 0;
  letter-spacing: -0.02em;
}
.channel-desc {
  font-size: 14px;
  color: var(--muted);
  margin: 0;
  line-height: 1.55;
}
.channel-perks {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 13.5px;
  font-weight: 600;
}
.channel-perks li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  line-height: 1.45;
}
.channel-perks li::before {
  content: "◈";
  color: var(--primary);
  font-weight: 900;
}
.channel-footer {
  margin-top: auto;
  padding-top: 16px;
}
.sponsor-trust-banner {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: var(--radius);
  padding: 20px 24px;
}
.sponsor-trust-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.trust-content p {
  margin: 0;
  line-height: 1.5;
}
  line-height: 1.55;
}

/* 7. AI BOOST SYNERGY */
.boost-section {
  padding: 38px 0 28px;
}
.boost-card {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow);
  border-radius: 16px;
  padding: 24px 20px;
}
.boost-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
.boost-info h2 {
  font-size: clamp(22px, 3.5vw, 30px);
  font-weight: 900;
  margin: 6px 0 10px;
}
.boost-lead {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.6;
  margin: 0 0 16px;
}
.boost-items {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 13.5px;
  line-height: 1.5;
}
.boost-items li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.boost-items li::before {
  content: "◈";
  color: var(--primary);
  font-weight: 900;
}
.boost-box {
  background: var(--bg);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow-sm);
  border-radius: var(--radius);
  padding: 18px 16px;
}
.boost-box-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14.5px;
  font-weight: 900;
  margin-bottom: 14px;
  padding-bottom: 8px;
  border-bottom: 1.5px dashed var(--border-subtle);
}
.triad-roles {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.triad-role {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.role-badge {
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 4px;
  border: 1px solid var(--border);
  width: fit-content;
}
.role-badge.planner { background: var(--secondary); color: var(--secondary-content); }
.role-badge.builder { background: var(--primary); color: var(--primary-content); }
.role-badge.auditor { background: var(--accent); color: #fff; }
.triad-role strong {
  font-size: 13.5px;
}
.triad-role p {
  font-size: 12px;
  color: var(--muted);
  margin: 0;
  line-height: 1.45;
}

/* 8. FINAL CTA */
.final-cta {
  padding: 28px 0 52px;
}
.cta-card {
  background: var(--bg-2);
  border: var(--pop-border);
  box-shadow: var(--pop-shadow-lg);
  border-radius: 18px;
  padding: 32px 20px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}
.cta-card h2 {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 900;
  margin: 0;
  max-width: 650px;
}
.cta-lead {
  font-size: 14.5px;
  color: var(--muted);
  max-width: 580px;
  margin: 0;
  line-height: 1.6;
}
.cta-meta {
  font-size: 12px;
  font-weight: 700;
  color: var(--muted);
  margin-top: 6px;
}

/* ==========================================================================
   RESPONSIVE BREAKPOINTS (SM: 640px+, MD: 768px+, LG: 1024px+)
   ========================================================================== */
@media (min-width: 640px) {
  .hero-inner {
    padding: 0 24px;
  }
  .section-inner {
    padding: 0 24px;
  }
  .benefit-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .benefit-card:nth-child(3) {
    grid-column: span 2;
  }
  .repo-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .repo-card.featured {
    grid-column: span 2;
  }
  .quickstart-steps {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gates-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .sponsor-channels-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 768px) {
  .hero {
    padding: 48px 0 32px;
  }
  .benefit-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .benefit-card:nth-child(3) {
    grid-column: auto;
  }
  .sponsor-trust-inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

@media (min-width: 1024px) {
  .hero {
    padding: 56px 0 42px;
  }
  .hero-inner {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 48px;
    padding: 0 32px;
  }
  .section-inner {
    padding: 0 32px;
  }
  .repo-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .repo-card.featured {
    grid-column: span 2;
  }
  .quickstart-steps {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .boost-grid {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 36px;
  }
  .cta-card {
    padding: 48px 32px;
  }
}
</style>

<script>
const pathways = {
  newbie: {
    title: "🌱 New to Go? (Beginner Friendly)",
    desc: "Start by polishing documentation in krewire.com, writing unit tests for krewire/pkg/model, or fixing starter bugs marked with good-first-issue.",
    url: "https://github.com/krewire/krewire/issues?q=is%3Aissue+is%3Aopen+label%3Agood-first-issue"
  },
  backend: {
    title: "⚙️ Backend Engineer",
    desc: "Contribute to core packages (pkg/model, pkg/web, pkg/resilience), implement microservices in krewire/cloud, or build autonomous agent tools in krewire/krew.",
    url: "https://github.com/krewire/krewire/issues"
  },
  frontend: {
    title: "🎨 Frontend & UI Engineer",
    desc: "Help design high-fidelity components using the .kiw DSL, expand Monaco Web IDE features in krewire/dash, or create interactive playground widgets.",
    url: "https://github.com/krewire/krewire.com/issues"
  },
  devops: {
    title: "☁️ DevOps & Infrastructure Engineer",
    desc: "Improve container sandbox runners in krewire/dash, enhance ACME TLS and rate limiters in krewire/cloud gateway, or automate CI/CD release pipelines.",
    url: "https://github.com/krewire/cloud/issues"
  }
};

function selectPathway(track) {
  const p = pathways[track];
  if (!p) return;
  document.getElementById('pathwayTitle').innerText = p.title;
  document.getElementById('pathwayDesc').innerText = p.desc;
  const cta = document.getElementById('pathwayCta');
  if (cta) cta.href = p.url;
  document.querySelectorAll('.pathway-tab').forEach(btn => {
    const isTarget = btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(track);
    btn.classList.toggle('active', isTarget);
    btn.classList.toggle('btn-primary', isTarget);
    btn.classList.toggle('btn-outline', !isTarget);
  });
}
</script>
