  <!-- VERSION ROADMAP & RELEASE LADDER -->
  <section class="roadmap-section" id="roadmap">
    <div class="section-inner">
      <div class="section-head text-center">
        <div class="sub-badge" data-i18n="roadmap.badge">Version Roadmap</div>
        <h2 data-i18n="roadmap.title">Ecosystem Evolution &amp; Release Ladder</h2>
        <p data-i18n="roadmap.subtitle">Our progressive open core release roadmap across the four-rung ladder: free → pro → team → enterprise.</p>
      </div>

      <div class="roadmap-grid">
        <div class="roadmap-card active-card">
          <div class="roadmap-top">
            <span class="roadmap-badge active" data-i18n="roadmap.v1_badge">Current GA Baseline</span>
            <span class="roadmap-tag">v0.1.0</span>
          </div>
          <h3 data-i18n="roadmap.v1_title">v0.1.0 — Stable Baseline</h3>
          <p data-i18n="roadmap.v1_desc">Single monorepo, 8 workload kinds, unified kiw CLI, mdbind compiler, and Spec-Driven Testing contracts.</p>
          <ul class="roadmap-list">
            <li>✓ Monorepo consolidation (github.com/krewire/krewire)</li>
            <li>✓ 8 unified workload detections</li>
            <li>✓ Strict krewire.yaml schema enforcement</li>
            <li>✓ Developer CLI tools (kiw init/new/dev/build)</li>
          </ul>
        </div>

        <div class="roadmap-card">
          <div class="roadmap-top">
            <span class="roadmap-badge upcoming" data-i18n="roadmap.v2_badge">Next Milestone</span>
            <span class="roadmap-tag">v0.2.0</span>
          </div>
          <h3 data-i18n="roadmap.v2_title">v0.2.0 — Enterprise Modules</h3>
          <p data-i18n="roadmap.v2_desc">Advanced worker distributed schedulers, enterprise RBAC/Auth wrappers, multi-cloud infra targets, and telemetry hooks.</p>
          <ul class="roadmap-list">
            <li>◈ Distributed queue backends (Redis/NATS adapters)</li>
            <li>◈ Enterprise RBAC and audit logging modules</li>
            <li>◈ Zero-overhead OpenTelemetry tracing export</li>
            <li>◈ Baremetal cluster deployment coordinator</li>
          </ul>
        </div>

        <div class="roadmap-card">
          <div class="roadmap-top">
            <span class="roadmap-badge future" data-i18n="roadmap.v3_badge">Future Horizon</span>
            <span class="roadmap-tag">v0.3.0</span>
          </div>
          <h3 data-i18n="roadmap.v3_title">v0.3.0 — Autonomous Swarm Mesh</h3>
          <p data-i18n="roadmap.v3_desc">WASM client-side hydration, automatic canary deployments, and autonomous agent self-healing workflows.</p>
          <ul class="roadmap-list">
            <li>◈ Zero-JS WebAssembly client hydration engine</li>
            <li>◈ Autonomous agent swarm mesh for testing &amp; chaos</li>
            <li>◈ Self-healing runtime telemetry and auto-rollback</li>
            <li>◈ Full multi-region multi-cloud target abstraction</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- STANDARDS & 3 QUALITY GATES -->
  <section class="standards" id="standards">
    <div class="section-inner">
      <div class="section-head text-center">
        <div class="sub-badge" data-i18n="standards.badge">Quality Assurance</div>
        <h2 data-i18n="standards.title">The Krewire Way: 3 Quality Gates</h2>
        <p data-i18n="standards.subtitle">To keep the codebase reliable, predictable, and production-ready, every pull request passes through three automated gates.</p>
      </div>
      <div class="gates-grid">
        <div class="gate-card">
          <div class="gate-icon">1</div>
          <h3 data-i18n="standards.gate1_title">Gate 1: Format &amp; Lint</h3>
          <p data-i18n="standards.gate1_desc">Zero lint errors and idiomatic Go formatting. Code must adhere strictly to Go standard conventions.</p>
          <pre class="gate-cmd"><code>gofmt -s -l .
go vet ./...</code></pre>
          <div class="gate-status" data-i18n="standards.gate1_req">Required: Clean exit, 0 warnings</div>
        </div>
        <div class="gate-card">
          <div class="gate-icon">2</div>
          <h3 data-i18n="standards.gate2_title">Gate 2: Race &amp; Tests</h3>
          <p data-i18n="standards.gate2_desc">Every commit is verified with race condition detection and comprehensive unit &amp; integration tests.</p>
          <pre class="gate-cmd"><code>go test -race ./...
go build ./...</code></pre>
          <div class="gate-status" data-i18n="standards.gate2_req">Required: 100% test pass, 0 data races</div>
        </div>
        <div class="gate-card">
          <div class="gate-icon">3</div>
          <h3 data-i18n="standards.gate3_title">Gate 3: Spec &amp; Commits</h3>
          <p data-i18n="standards.gate3_desc">Changes must link to a valid Spec or Issue, following Conventional Commits format.</p>
          <pre class="gate-cmd"><code>feat(scope): implement workload runner
fix(web): recover panic in http handler</code></pre>
          <div class="gate-status" data-i18n="standards.gate3_req">Required: Semantic versioning compliance</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTRIBUTOR BENEFITS & LIFETIME ACCESS -->
  <section class="benefits" id="benefits">
    <div class="section-inner">
      <div class="section-head text-center">
        <div class="sub-badge" data-i18n="benefits.badge">Contributor Privilege</div>
        <h2 data-i18n="benefits.title">Lifetime Access to Krewire's Paid Ecosystem</h2>
        <p data-i18n="benefits.subtitle">Genuine appreciation for true builders. By joining and actively contributing to the Krewire open source collective, you earn lifetime access to our upcoming commercial sub-products and premium ecosystem tools.</p>
      </div>

      <div class="benefit-grid">
        <div class="benefit-card highlight">
          <div class="benefit-badge" data-i18n="benefits.b1_badge">Core Privilege</div>
          <div class="benefit-icon">★</div>
          <h3 data-i18n="benefits.b1_title">Commercial Sub-Products Lifetime Access</h3>
          <p data-i18n="benefits.b1_desc">Receive free lifetime licenses for upcoming commercial Krewire products — including managed cloud orchestration tools, enterprise modules, and premium services.</p>
          <ul class="benefit-list">
            <li data-i18n="benefits.b1_i1">Free lifetime access to all paid Krewire commercial sub-products</li>
            <li data-i18n="benefits.b1_i2">Priority early-access releases and exclusive roadmap previews</li>
            <li data-i18n="benefits.b1_i3">Direct private collaboration channels with core maintainers</li>
          </ul>
        </div>

        <div class="benefit-card condition">
          <div class="benefit-badge req" data-i18n="benefits.b2_badge">Strict Requirement</div>
          <div class="benefit-icon">⚡</div>
          <h3 data-i18n="benefits.b2_title">Active Contributions Required</h3>
          <p data-i18n="benefits.b2_desc">This privilege is a two-way commitment. Your access remains active as long as you regularly contribute and help nurture the ecosystem's growth.</p>
          <ul class="benefit-list">
            <li data-i18n="benefits.b2_i1">Submit PRs for new features, bugfixes, or kernel optimizations</li>
            <li data-i18n="benefits.b2_i2">Review open PRs and stress-test high-concurrency scenarios</li>
            <li data-i18n="benefits.b2_i3">Author KWF architecture specifications or comprehensive docs</li>
          </ul>
        </div>

        <div class="benefit-card notice">
          <div class="benefit-badge warn" data-i18n="benefits.b3_badge">Revocation Policy</div>
          <div class="benefit-icon">⚠</div>
          <h3 data-i18n="benefits.b3_title">Revocable if Inactive or Dormant</h3>
          <p data-i18n="benefits.b3_desc">To protect community fairness and true meritocracy, commercial access licenses may be revoked at any time if a contributor becomes inactive or dormant over an extended period.</p>
          <ul class="benefit-list">
            <li data-i18n="benefits.b3_i1">Contributor activity and commits are periodically audited</li>
            <li data-i18n="benefits.b3_i2">Prolonged inactivity or dormancy leads to license deactivation</li>
            <li data-i18n="benefits.b3_i3">Access privileges can be promptly reinstated upon resumed contribution</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AI BOOST COLLABORATION -->
  <section class="guild-section" id="boost">
    <div class="section-inner">
      <div class="guild-card">
        <div class="guild-grid">
          <div class="guild-info">
            <div class="sub-badge" data-i18n="guild.badge">Human + AI Synergy</div>
            <h2 data-i18n="guild.title">Collaborating with AI Boost</h2>
            <p data-i18n="guild.lead">Krewire pioneers the collaboration between human maintainers and autonomous AI agents. Our AI Boost framework operates with strict verification standards:</p>
            <ul class="guild-list">
              <li data-i18n-html="guild.item1_html"><b>Automated Architecture Audits:</b> AI agents check PRs against <code>KWF-*</code> specifications.</li>
              <li data-i18n-html="guild.item2_html"><b>Continuous Regression Hunting:</b> Agents synthesize edge cases and race condition checks.</li>
              <li data-i18n-html="guild.item3_html"><b>Transparent Pair Programming:</b> AI agents explain architectural decisions openly in discussions and PR comments.</li>
              <li data-i18n-html="guild.item4_html"><b>Human Governance:</b> Ultimate merging authority always remains in the hands of human collective maintainers.</li>
            </ul>
            <div class="ctas flex flex-wrap gap-3">
              <Button Variant="primary" Href="https://github.com/krewire/krewire/tree/main/templates/boost" Target="_blank" DataI18n="guild.cta_repo">Explore AI Boost in Krewire →</Button>
              <Button Variant="outline" Href="https://github.com/orgs/krewire/discussions" Target="_blank" DataI18n="guild.cta_disc">Join Discussions</Button>
            </div>
          </div>
          <div class="guild-box">
            <div class="guild-box-head" data-i18n="guild.triad_title">AI Boost Agent Triad</div>
            <div class="agent-item">
              <span class="agent-role planner">Planner</span>
              <div>
                <strong data-i18n="guild.planner_title">Requirements &amp; SDD</strong>
                <p data-i18n="guild.planner_desc">Translates feature ideas into formal specs and architectural blueprints.</p>
              </div>
            </div>
            <div class="agent-item">
              <span class="agent-role builder">Builder</span>
              <div>
                <strong data-i18n="guild.builder_title">Implementation &amp; Refactoring</strong>
                <p data-i18n="guild.builder_desc">Generates clean Go implementations adhering to idiomatic patterns.</p>
              </div>
            </div>
            <div class="agent-item">
              <span class="agent-role auditor">Auditor</span>
              <div>
                <strong data-i18n="guild.auditor_title">Verification &amp; Quality Gates</strong>
                <p data-i18n="guild.auditor_desc">Validates concurrency, zero data races, and performance benchmarks.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CALLOUT -->
  <section class="final-cta">
    <div class="section-inner">
      <div class="cta-card text-center">
        <div class="sub-badge" data-i18n="cta.badge">Release Launchpad</div>
        <h2 data-i18n="cta.title">Ready to build on Krewire v0.1.0?</h2>
        <p class="cta-lead" data-i18n="cta.lead">Join an open-source collective delivering modular, fast, and sustainable Go software. Explore the source on GitHub or start a new project with kiw.</p>
        <div class="ctas flex flex-wrap gap-3 justify-center">
          <Button Variant="primary" Size="lg" Href="https://github.com/krewire/krewire/releases" Target="_blank" DataI18n="cta.github">View GitHub Releases →</Button>
          <Button Variant="outline" Size="lg" Href="https://krewire.com" Target="_blank" DataI18n="cta.quickstart">Read Documentation</Button>
        </div>
        <div class="cta-meta" data-i18n="cta.meta">Proudly open source · MIT Licensed · Engineered with passion in Indonesia</div>
      </div>
    </div>
  </section>

</div>

<style>
/* ==========================================================================
   MOBILE-FIRST BASE (Phones: 320px - 639px)
   ========================================================================== */

.contributors-portal{
  width:100%;
  min-width:0;
  overflow-x:hidden;
}
.contributors-portal *{
  box-sizing:border-box;
}
.contributors-portal pre{
  max-width:100%;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}

/* SECTION COMMON */
.section-inner{
  width:100%;
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  min-width:0;
}
.section-head{
  margin:0 0 24px;
}
.sub-badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-size:11px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--primary-content);
  background:var(--primary);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  padding:3px 10px;
  border-radius:6px;
  margin-bottom:12px;
}
.section-head h2{
  font-size:clamp(24px, 6vw, 36px);
  font-weight:900;
  letter-spacing:-.035em;
  margin:0 0 10px;
  line-height:1.15;
  word-break:break-word;
}
.section-head p{
  color:var(--muted);
  margin:0;
  font-size:14px;
  line-height:1.6;
  word-break:break-word;
}

/* CARDS COMMON DEFAULTS */
.feature-card,
.workload-card,
.qs-card,
.roadmap-card,
.benefit-card,
.repo-card,
.gate-card,
.nav-map-card,
.guild-box{
  min-width:0;
  width:100%;
  word-break:break-word;
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  background:var(--bg);
  box-shadow:var(--pop-shadow);
  transition:transform .15s ease, box-shadow .15s ease;
}
.feature-card:hover,
.workload-card:hover,
.qs-card:hover,
.roadmap-card:hover,
.benefit-card:hover,
.repo-card:hover,
.gate-card:hover,
.nav-map-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.features-grid,
.workloads-grid,
.quickstart-steps,
.roadmap-grid,
.benefit-grid,
.repo-grid,
.gates-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}

/* HERO (MOBILE-FIRST) */
.hero{
  padding:34px 0 26px;
  background-color:var(--bg);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.hero-inner{
  width:100%;
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  display:flex;
  flex-direction:column;
  gap:24px;
}
.hero-copy{
  min-width:0;
  width:100%;
}
.eyebrow{
  font-size:11px;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--primary-content);
  background:var(--primary);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  padding:4px 10px;
  border-radius:6px;
  font-weight:900;
  margin-bottom:14px;
  display:inline-flex;
  align-items:center;
  gap:6px;
  width:fit-content;
  line-height:1.4;
}
.hero h1{
  font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", Roboto, sans-serif;
  font-size:clamp(30px, 7.8vw, 56px);
  font-weight:900;
  line-height:1.06;
  letter-spacing:-.04em;
  margin:0 0 14px;
  word-break:break-word;
  text-wrap:balance;
}
.hero .lead{
  font-size:14.5px;
  color:color-mix(in srgb, var(--fg) 80%, var(--muted));
  line-height:1.65;
  margin:0;
  word-break:break-word;
}
.hero .lead code{
  font-family:ui-monospace, monospace;
  font-size:12.5px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  padding:2px 6px;
  border-radius:6px;
  font-weight:700;
  word-break:break-word;
}
.hero .ctas{
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:20px;
  width:100%;
}
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:12px 22px;
  border-radius:10px;
  border:var(--pop-border);
  background:var(--bg);
  color:var(--fg);
  font-weight:900;
  font-size:14px;
  box-shadow:var(--pop-shadow);
  transition:all .15s cubic-bezier(0.4, 0, 0.2, 1);
  cursor:pointer;
  min-height:48px;
  width:100%;
  text-align:center;
  text-decoration:none;
}
.btn:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
  background:var(--bg-2);
  color:var(--fg);
}
.btn:active{
  transform:translate(2px, 2px);
  box-shadow:var(--pop-shadow-sm);
}
.btn.primary{
  background:var(--primary);
  color:var(--primary-content);
  border-color:var(--border);
}
.btn.primary:hover{
  background:var(--primary);
  color:var(--primary-content);
  filter:brightness(1.05);
}
.btn.large{
  padding:14px 26px;
  font-size:15px;
}
.btn-subtle{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-size:13px;
  font-weight:800;
  color:var(--fg);
  margin-top:8px;
}
.btn-subtle:hover{
  color:var(--primary);
  text-decoration:underline;
}
.meta{
  margin-top:16px;
  font-size:12px;
  color:var(--muted);
  letter-spacing:.02em;
  line-height:1.5;
  font-weight:600;
  word-break:break-word;
}
.hero-art{
  min-width:0;
  width:100%;
}
.code-terminal-card{
  background:#0B1F3B;
  color:#FAF8F4;
  border:var(--pop-border);
  border-radius:14px;
  box-shadow:var(--pop-shadow-lg);
  overflow:hidden;
  display:flex;
  flex-direction:column;
  width:100%;
}
.code-terminal-bar{
  background:#061326;
  border-bottom:1.5px solid rgba(255,255,255,0.1);
  padding:10px 14px;
  display:flex;
  align-items:center;
  gap:10px;
}
.terminal-dots{
  display:flex;
  gap:6px;
}
.term-dot{
  width:10px;
  height:10px;
  border-radius:50%;
  display:inline-block;
}
.term-dot.red{ background:#ff5f56; }
.term-dot.yellow{ background:#ffbd2e; }
.term-dot.green{ background:#27c93f; }
.term-title{
  font-family:ui-monospace, monospace;
  font-size:12px;
  font-weight:700;
  color:#94a3b8;
  letter-spacing:.02em;
}
.code-terminal-body{
  padding:16px 16px;
  font-family:ui-monospace, monospace;
  font-size:12.5px;
  line-height:1.6;
  display:flex;
  flex-direction:column;
  gap:6px;
  overflow-x:auto;
}
.term-line{
  display:flex;
  gap:8px;
  white-space:nowrap;
}
.term-prompt{
  color:var(--primary);
  font-weight:900;
  user-select:none;
}
.term-cmd{
  color:#f8fafc;
  font-weight:700;
}
.term-info{
  color:#94a3b8;
}
.term-success{
  color:#4ade80;
  font-weight:700;
}
.code-terminal-foot{
  background:#08182f;
  border-top:1.5px solid rgba(255,255,255,0.08);
  padding:8px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  flex-wrap:wrap;
}
.term-foot-tag{
  font-size:11px;
  color:#94a3b8;
  font-family:ui-monospace, monospace;
}

/* TRUST BAR (MOBILE-FIRST) */
.trust{
  border-bottom:var(--pop-border);
  background:var(--bg-2);
  width:100%;
  padding:14px 0;
}
.trust-inner{
  max-width:80rem;
  margin:0 auto;
  padding:0 14px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.trust-label{
  font-size:11px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--secondary-content);
  background:var(--secondary);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  padding:3px 9px;
  border-radius:6px;
  width:fit-content;
}
.trust-items{
  display:flex;
  flex-wrap:wrap;
  gap:8px 14px;
  font-size:13px;
  color:var(--muted);
  line-height:1.4;
  font-weight:600;
}
.trust-items b{
  color:var(--fg);
}
.trust-items .dot{
  display:none;
}

/* RELEASES HIGHLIGHTS */
.releases-section{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.features-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
.feature-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  box-shadow:var(--pop-shadow);
  display:flex;
  flex-direction:column;
  transition:transform .15s ease, box-shadow .15s ease;
}
.feature-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.feature-card.highlight-card{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 10%, var(--bg)), var(--bg));
  border-color:var(--primary);
}
.feature-icon{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  font-size:20px;
  margin-bottom:14px;
}
.feature-card h3{
  margin:0 0 6px;
  font-size:16.5px;
  font-weight:900;
  letter-spacing:-.01em;
}
.feature-card p{
  margin:0 0 12px;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}
.feature-card code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  padding:1px 5px;
  border-radius:5px;
  font-weight:700;
}

/* WORKLOADS (8 KINDS) */
.workloads-section{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.workloads-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
.workload-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  padding:18px 16px;
  box-shadow:var(--pop-shadow);
  display:flex;
  flex-direction:column;
  transition:transform .15s ease, box-shadow .15s ease;
}
.workload-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.workload-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
}
.workload-icon{
  font-size:22px;
  line-height:1;
}
.workload-tag{
  font-family:ui-monospace, monospace;
  font-size:11px;
  font-weight:900;
  padding:2px 8px;
  border-radius:6px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  text-transform:uppercase;
}
.workload-card h3{
  margin:0 0 6px;
  font-size:16px;
  font-weight:900;
}
.workload-card p{
  margin:0 0 12px;
  font-size:13px;
  color:var(--muted);
  line-height:1.55;
  flex-grow:1;
}
.workload-marker{
  margin-top:auto;
  font-size:11.5px;
  font-weight:700;
  color:var(--muted);
  padding-top:8px;
  border-top:1.5px solid var(--border-subtle);
  word-break:break-all;
}

/* QUICKSTART */
.quickstart-section{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.quickstart-steps{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
  margin-bottom:24px;
}
.qs-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  box-shadow:var(--pop-shadow);
  display:flex;
  flex-direction:column;
  transition:transform .15s ease, box-shadow .15s ease;
}
.qs-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.qs-num{
  width:32px;
  height:32px;
  border-radius:8px;
  background:var(--primary);
  color:var(--primary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  display:grid;
  place-items:center;
  font-weight:900;
  font-size:14px;
  font-family:ui-monospace, monospace;
  margin-bottom:12px;
}
.qs-card h3{
  margin:0 0 6px;
  font-size:16px;
  font-weight:900;
}
.qs-card p{
  margin:0 0 12px;
  font-size:13px;
  color:var(--muted);
  line-height:1.55;
}
.qs-card pre{
  margin:0;
  background:#0B1F3B;
  color:#FAF8F4;
  border:2px solid var(--border);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  padding:10px 12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}
.qs-card code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  display:block;
  white-space:pre;
}

/* CONTRIBUTOR BENEFITS */
.benefits{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.benefit-card{
  position:relative;
  display:flex;
  flex-direction:column;
}
.benefit-card.highlight{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 12%, var(--bg)), var(--bg));
}
.benefit-badge{
  display:inline-block;
  align-self:flex-start;
  font-size:11px;
  font-weight:900;
  padding:3px 9px;
  border-radius:6px;
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  margin-bottom:12px;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.benefit-card.highlight .benefit-badge{
  background:var(--primary);
  color:var(--primary-content);
}
.benefit-badge.req{
  background:var(--secondary);
  color:var(--secondary-content);
}
.benefit-badge.warn{
  background:var(--accent);
  color:#ffffff;
}
.benefit-icon{
  font-size:26px;
  margin-bottom:10px;
  line-height:1;
}
.benefit-card.highlight .benefit-icon{color:var(--primary)}
.benefit-card.condition .benefit-icon{color:var(--secondary)}
.benefit-card.notice .benefit-icon{color:var(--accent)}
.benefit-card h3{
  margin:0 0 8px;
  font-size:16.5px;
  font-weight:800;
  letter-spacing:-.01em;
  line-height:1.3;
}
.benefit-card p{
  margin:0 0 14px;
  color:var(--muted);
  font-size:13px;
  line-height:1.6;
}
.benefit-list{
  margin:auto 0 0;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:12.5px;
  color:var(--muted);
  line-height:1.5;
  font-weight:600;
}
.benefit-list li::marker{color:var(--primary)}
.benefit-card.condition .benefit-list li::marker{color:var(--secondary)}
.benefit-card.notice .benefit-list li::marker{color:var(--accent)}
.benefit-policy-banner{
  display:flex;
  flex-direction:column;
  gap:8px;
  padding:16px 14px;
  border-radius:10px;
  background:var(--bg);
  border:var(--pop-border);
  box-shadow:var(--pop-shadow-sm);
  margin-top:16px;
}
.policy-marker{
  font-size:18px;
  color:var(--primary);
  line-height:1;
}
.policy-text{
  font-size:12.5px;
  line-height:1.6;
  color:var(--muted);
  word-break:break-word;
}
.policy-text strong{
  color:var(--fg);
  display:inline;
  margin-right:4px;
}

/* CONTRIBUTOR NAVIGATION MAP */
.nav-map{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.fast-setup-box{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  box-shadow:var(--pop-shadow);
  padding:20px 16px;
  margin-bottom:28px;
}
.fast-setup-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:8px;
}
.fast-setup-title{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:16px;
  font-weight:900;
}
.fast-icon{
  color:var(--primary);
  font-size:18px;
}
.fast-setup-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2.5px 8px;
  border-radius:6px;
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  background:var(--primary);
  color:var(--primary-content);
  text-transform:uppercase;
  letter-spacing:.05em;
}
.fast-setup-desc{
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
  margin:0 0 14px;
}
.terminal-cmd-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--bg-2);
  border:var(--pop-border-thin);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  padding:10px 14px;
  gap:12px;
  overflow-x:auto;
}
.terminal-cmd-bar code{
  font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size:13px;
  font-weight:700;
  color:var(--fg);
  white-space:nowrap;
}
.btn-copy{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:6px 14px;
  background:var(--secondary);
  color:var(--secondary-content);
  border:var(--pop-border-thin);
  border-radius:6px;
  box-shadow:var(--pop-shadow-sm);
  font-size:12px;
  font-weight:900;
  cursor:pointer;
  transition:all .15s ease;
  flex-shrink:0;
}
.btn-copy:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--primary);
  color:var(--primary-content);
}
.btn-copy:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.btn-copy.copied{
  background:var(--primary);
  color:var(--primary-content);
}
.fast-setup-meta{
  display:flex;
  gap:10px;
  font-size:12px;
  font-weight:600;
  color:var(--muted);
  margin-top:10px;
  flex-wrap:wrap;
}

/* FILTER BAR */
.nav-filter-bar{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-bottom:22px;
}
.filter-label{
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.06em;
  color:var(--fg);
}
.filter-pills{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:6px;
  -webkit-overflow-scrolling:touch;
}
.filter-pill{
  background:var(--bg);
  border:var(--pop-border-thin);
  color:var(--fg);
  box-shadow:var(--pop-shadow-sm);
  border-radius:8px;
  padding:6px 14px;
  font-size:12.5px;
  font-weight:800;
  cursor:pointer;
  white-space:nowrap;
  transition:all .15s ease;
}
.filter-pill:hover{
  transform:translate(-1px, -1px);
  box-shadow:3px 3px 0px var(--border);
  background:var(--bg-2);
}
.filter-pill:active{
  transform:translate(1px, 1px);
  box-shadow:1px 1px 0px var(--border);
}
.filter-pill.is-active{
  background:var(--primary);
  color:var(--primary-content);
}

/* NAV MAP CARDS */
.nav-map-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
.nav-map-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  display:flex;
  flex-direction:column;
  box-shadow:var(--pop-shadow);
  transition:transform .15s ease, box-shadow .15s ease;
}
.nav-map-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.nav-card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:10px;
  gap:8px;
  flex-wrap:wrap;
}
.nav-track-tag{
  font-size:11.5px;
  font-weight:900;
  color:var(--primary);
  text-transform:uppercase;
  letter-spacing:.05em;
}
.nav-curve-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2.5px 8px;
  border-radius:6px;
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  text-transform:uppercase;
  letter-spacing:.04em;
}
.nav-curve-badge.gentle{
  background:var(--primary);
  color:var(--primary-content);
}
.nav-curve-badge.intermediate{
  background:var(--secondary);
  color:var(--secondary-content);
}
.nav-curve-badge.advanced{
  background:var(--accent);
  color:#ffffff;
}
.nav-curve-badge.innovative{
  background:#ffd166;
  color:#0B1F3B;
}
.nav-card-title{
  font-size:19px;
  font-weight:900;
  margin:0 0 8px;
  font-family:ui-monospace, monospace;
}
.nav-card-match{
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
  margin:0 0 14px;
  flex-grow:1;
}
.nav-card-match strong{
  color:var(--fg);
}
.nav-card-packages{
  margin-bottom:16px;
  font-size:12px;
}
.pkg-label{
  display:block;
  color:var(--muted);
  font-size:11px;
  margin-bottom:6px;
  font-weight:800;
  text-transform:uppercase;
}
.pkg-tags{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
}
.pkg-tags code{
  font-size:11.5px;
  font-weight:700;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  padding:2px 6px;
  border-radius:5px;
}
.section-anchor{
  display:block;
  position:relative;
  top:-70px;
  visibility:hidden;
}
.repos-nav{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  border-bottom:var(--pop-border);
  width:100%;
}
.repo-icon{
  color:var(--primary);
  margin-right:6px;
  display:inline-block;
}
.nav-map-card.featured{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, var(--bg)), var(--bg));
}
.nav-card-footer{
  margin-top:auto;
  padding-top:14px;
  border-top:1.5px solid var(--border-subtle);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
}
.nav-action-link{
  display:inline-flex;
  align-items:center;
  gap:4px;
  font-size:13px;
  font-weight:900;
  color:var(--primary);
  text-decoration:none;
  transition:gap .15s ease;
}
.nav-action-link:hover{
  gap:8px;
  text-decoration:underline;
}
.nav-repo-link{
  font-size:12px;
  font-weight:700;
  color:var(--muted);
  text-decoration:none;
  transition:color .15s ease;
}
.nav-repo-link:hover{
  color:var(--fg);
  text-decoration:underline;
}
.repo-card{
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.repo-card.featured{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 8%, var(--bg)), var(--bg));
}
.repo-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:8px;
  margin-bottom:10px;
  flex-wrap:wrap;
}
.repo-name{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:0;
  flex-wrap:wrap;
}
.repo-icon{
  font-size:17px;
  color:var(--primary);
  flex-shrink:0;
}
.repo-name h3{
  margin:0;
  font-size:15px;
  font-weight:900;
  font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing:-.01em;
  word-break:break-word;
}
.repo-name .alias{
  font-size:11.5px;
  color:var(--muted);
  font-weight:700;
}
.repo-badge{
  font-size:10.5px;
  font-weight:900;
  padding:2.5px 8px;
  border-radius:6px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  color:var(--fg);
  white-space:nowrap;
}
.repo-badge.primary{
  background:var(--primary);
  color:var(--primary-content);
}
.repo-desc{
  font-size:13px;
  color:var(--muted);
  margin:0 0 12px;
  line-height:1.55;
}
.repo-desc code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  font-weight:700;
  background:var(--bg-2);
  border:1px solid var(--border-subtle);
  padding:1px 5px;
  border-radius:4px;
}
.repo-details{
  display:flex;
  flex-direction:column;
  gap:7px;
  margin-bottom:14px;
  font-size:12px;
  padding-top:10px;
  border-top:1.5px solid var(--border-subtle);
}
.detail-item strong{
  color:var(--fg);
  display:block;
  margin-bottom:1px;
  font-weight:800;
}
.detail-item span{
  color:var(--muted);
  line-height:1.5;
}
.repo-footer{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:6px;
  padding-top:10px;
  border-top:1.5px solid var(--border-subtle);
}
.tag{
  font-size:11px;
  font-weight:800;
  padding:2px 7px;
  border-radius:5px;
  background:var(--bg-2);
  border:1.5px solid var(--border);
  color:var(--fg);
  font-family:ui-monospace, monospace;
}
.repo-link{
  margin-left:auto;
  font-size:13px;
  font-weight:900;
  color:var(--primary);
  padding:4px 0;
}
.repo-link:hover{
  text-decoration:underline;
}

/* ROADMAP */
.roadmap-section{
  padding:44px 0 28px;
  background-color:var(--bg);
  border-bottom:var(--pop-border);
  width:100%;
}
.roadmap-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:16px;
}
.roadmap-card{
  background:var(--bg);
  border:var(--pop-border);
  border-radius:12px;
  padding:20px 16px;
  box-shadow:var(--pop-shadow);
  display:flex;
  flex-direction:column;
  transition:transform .15s ease, box-shadow .15s ease;
}
.roadmap-card.active-card{
  background:linear-gradient(135deg, color-mix(in srgb, var(--primary) 10%, var(--bg)), var(--bg));
  border-color:var(--primary);
}
.roadmap-card:hover{
  transform:translate(-2px, -2px);
  box-shadow:var(--pop-shadow-lg);
}
.roadmap-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
  gap:8px;
}
.roadmap-badge{
  font-size:11px;
  font-weight:900;
  padding:3px 9px;
  border-radius:6px;
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  text-transform:uppercase;
  letter-spacing:.04em;
}
.roadmap-badge.active{
  background:var(--primary);
  color:var(--primary-content);
}
.roadmap-badge.upcoming{
  background:var(--secondary);
  color:var(--secondary-content);
}
.roadmap-badge.future{
  background:var(--bg-2);
  color:var(--fg);
}
.roadmap-tag{
  font-family:ui-monospace, monospace;
  font-size:11.5px;
  font-weight:900;
  color:var(--muted);
}
.roadmap-card h3{
  margin:0 0 6px;
  font-size:16.5px;
  font-weight:900;
}
.roadmap-card p{
  margin:0 0 14px;
  font-size:13px;
  color:var(--muted);
  line-height:1.6;
}
.roadmap-list{
  margin:auto 0 0;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:12.5px;
  color:var(--muted);
  line-height:1.5;
  font-weight:600;
}
.roadmap-list li::marker{
  color:var(--primary);
}

/* STANDARDS & GATES */
.standards{
  padding:44px 0 28px;
  background-color:var(--bg-2);
  background-image:radial-gradient(var(--dot-color) 1.5px, transparent 1.5px);
  background-size:18px 18px;
  border-bottom:var(--pop-border);
  width:100%;
}
.gate-icon{
  width:32px;
  height:32px;
  border-radius:8px;
  background:var(--primary);
  color:var(--primary-content);
  border:var(--pop-border-thin);
  box-shadow:var(--pop-shadow-sm);
  display:grid;
  place-items:center;
  font-weight:900;
  font-size:14px;
  margin-bottom:12px;
}
.gate-card h3{
  margin:0 0 6px;
  font-size:16px;
  font-weight:900;
}
.gate-card p{
  margin:0 0 12px;
  font-size:13px;
  color:var(--muted);
  line-height:1.55;
}
.gate-cmd{
  margin:0 0 12px;
  background:#0B1F3B;
  color:#FAF8F4;
  border:2px solid var(--border);
  border-radius:8px;
  box-shadow:var(--pop-shadow-sm);
  padding:10px 12px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  max-width:100%;
}
.gate-cmd code{
  font-family:ui-monospace, monospace;
  font-size:12px;
  line-height:1.55;
  display:block;
  white-space:pre;
}
.gate-status{
  margin-top:auto;
  font-size:12px;
  font-weight:800;
  color:var(--primary);
  display:flex;
  align-items:center;
  gap:6px;
}

/* AI GUILD */
.guild-section{
  padding:44px 0 32px;
  background-color:var(--bg-2);
  border-bottom:var(--pop-border);
  width:100%;
}
.guild-card{
  border:var(--pop-border);
  border-radius:16px;
  background:var(--bg);
  box-shadow:var(--pop-shadow-lg);
  padding:22px 16px;
}
.guild-grid{
  display:flex;
  flex-direction:column;
  gap:24px;
}
.guild-info h2{
  font-size:clamp(24px, 5.5vw, 34px);
  font-weight:900;
  letter-spacing:-.03em;
  margin:0 0 10px;
}
.guild-info p{
  color:var(--muted);
  font-size:14px;
  line-height:1.65;
  margin:0 0 16px;
}
.guild-list{
  margin:0 0 20px;
  padding-left:16px;
  display:flex;
  flex-direction:column;
  gap:10px;
  font-size:13.5px;
  color:var(--muted);
  line-height:1.6;
}
.guild-list b{color:var(--fg)}
.guild-info .ctas{
  display:flex;
  flex-direction:column;
  gap:12px;
  width:100%;
}
.guild-box{
  background:var(--bg-2);
  border:var(--pop-border);
  border-radius:12px;
  box-shadow:var(--pop-shadow);
  padding:18px 16px;
  display:flex;
  flex-direction:column;
  gap:14px;
}
.guild-box-head{
  font-size:11.5px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--fg);
  padding-bottom:10px;
  border-bottom:1.5px solid var(--border-subtle);
}
.agent-item{
  display:flex;
  gap:10px;
  align-items:flex-start;
}
.agent-role{
  font-size:10.5px;
  font-weight:900;
  padding:3px 8px;
  border-radius:6px;
  border:1.5px solid var(--border);
  box-shadow:1.5px 1.5px 0px var(--border);
  font-family:ui-monospace, monospace;
  text-transform:uppercase;
